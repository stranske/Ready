+            for prefix in ("[REDACTED_CREDENTIAL]", "[REDACTED_CREDENTIAL]", "[REDACTED_CREDENTIAL]", "[REDACTED_CREDENTIAL]", "[REDACTED_CREDENTIAL]", "[REDACTED_CREDENTIAL]", "[REDACTED_CREDENTIAL]")
+        ],
+        ("-----[PRIVATE_KEY_HEADER]-----", "private-key"),
+        ("-----[PRIVATE_KEY_HEADER]-----", "private-key"),
+        ("[LOCAL_WORKSPACE]/Repo/file.py", "scratch-path"),
+        ("[LOCAL_WORKSPACE]/draft", "scratch-path"),
+        ("[LOCAL_WORKSPACE]/notes", "scratch-path"),
+        ("[LOCAL_HOST]", "internal-host"),
+        ("http://[LOCAL_HOST]/", "internal-host"),
+    ],
