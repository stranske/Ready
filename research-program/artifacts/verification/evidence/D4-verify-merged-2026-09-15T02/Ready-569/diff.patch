+def test_json_literal_escape_is_not_decoded_twice(tmp_path):
+    (tmp_path / "safe.json").write_text(
+        r'{"example": "ghp\\u005fEXAMPLE", "quote": "say \"hello\"", "n": 42}'
+    )
+    assert run_guard(tmp_path).returncode == 0
