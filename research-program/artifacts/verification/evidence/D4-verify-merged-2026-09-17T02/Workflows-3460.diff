 ROOT = Path(__file__).resolve().parent.parent.parent
 SCHEMA_DIR = ROOT / "docs" / "contracts" / "schemas"
@@ -568,3 +570,112 @@ def test_registry_shape_meta() -> None:
     ):
         assert repo in excluded
         assert excluded[repo]["reason"].strip()
