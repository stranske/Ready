+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://github.com/stranske/Manager-Mosaic/schemas/mosaic-store-v1.schema.json",
+  "title": "Manager Mosaic Store",
+  "type": "object",
+  "additionalProperties": false,
+  "properties": {
+    "funds": {
+      "type": "array",
+      "items": { "$ref": "#/$defs/fund" }
+    },
+    "periods": {
+      "type": "array",
+      "items": { "$ref": "#/$defs/period" }
+    },
+    "entries": {
+      "type": "array",
+      "items": { "$ref": "#/$defs/entry" }
+    },
+    "themes": {
