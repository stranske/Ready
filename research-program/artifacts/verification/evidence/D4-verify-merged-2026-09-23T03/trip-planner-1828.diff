+        operation="fetch_policy_constraints",
+        request_id=f"policy-sync:{uuid4().hex}",
+        correlation_id=TPPCorrelationId.from_value(f"policy-sync:{record.trip_id}"),
+        payload={"trip_plan": _tpp_trip_plan_payload(record, user=user)},
