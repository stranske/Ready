+        current_saved_id = (
+            session.get("current_saved_scenario_id") if isinstance(session, dict) else None
+        )
+        saved = next(
+            (
+                record
+                for record in saved_scenarios
+                if isinstance(record, dict) and record.get("saved_scenario_id") == current_saved_id
+            ),
