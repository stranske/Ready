+        db_session,
+        user=user,
+        trip_id=trip_id,
+        proposal_payload=proposal_payload,
+        request_payload=request_payload,
+        response_payload=None,
+        proposal_version=str(proposal_payload.get("proposal_version") or "v1"),
+        scenario_id=proposal.selected_options[0].option_id,
+    )
