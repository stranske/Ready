+def test_entity_extraction_matches_manager_ids_id_schema():
+    conn = _build_id_schema_db()
+    chain = RAGSearchChain(db_conn=conn)
+
+    entities = chain._entity_extraction("What does Elliott hold?")
+
+    assert entities["manager_ids"] == [1]
+    assert entities["manager_names"] == ["Elliott"]
+    conn.close()
+
+
+def test_structured_search_explicit_manager_filter_id_schema():
+    conn = _build_id_schema_db()
+    chain = RAGSearchChain(db_conn=conn)
+
+    context, _sources = chain._structured_search(
+        {"manager_ids": [1], "cusips": [], "keywords": [], "date_range": None}
+    )
+
+    assert "Manager Elliott (manager_id=1" in context
+    assert "Latest holdings" in context
+    conn.close()
+
+
+def test_structured_search_unrelated_manager_excluded_id_schema():
+    conn = _build_id_schema_db()
+    chain = RAGSearchChain(db_conn=conn)
+
+    context, sources = chain._structured_search(
+        {"manager_ids": [2], "cusips": [], "keywords": [], "date_range": None}
+    )
+
+    assert "Manager SIR Capital (manager_id=2" in context
+    assert "Latest holdings" not in context
+    assert not any(source.get("filing_id") == 11 for source in sources)
+    conn.close()
+
+
+def test_run_honors_explicit_manager_name_id_schema(monkeypatch):
+    conn = _build_id_schema_db()
+    llm = FakeLLM("Context-aware answer.")
+    chain = RAGSearchChain(llm=llm, db_conn=conn)
+    monkeypatch.setattr("chains.rag_search.search_documents", lambda *args, **kwargs: [])
+
+    result = chain.run(
+        "What changed recently?",
+        context={"manager_name": "Elliott"},
+    )
+
+    assert result["answer"] == "Context-aware answer."
+    assert any(source.get("filing_id") == 11 for source in result["sources"])
+    conn.close()
+
+
