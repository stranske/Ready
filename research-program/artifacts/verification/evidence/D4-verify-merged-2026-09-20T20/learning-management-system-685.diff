+            feedback_record_id=feedback.id,
+        )
+        assert len(actions) == 1
+        assert actions[0].action_type == (
+            "prerequisite-remediation" if expected_level == "remediation" else "revision"
+        )
+        assert feedback.next_action_ids == [actions[0].id]
