+    });
+  } else {
+    await github.rest.issues.createComment({
+      owner: context.repo.owner, repo: context.repo.repo,
+      issue_number: prNumber, body,
+    });
+  }
+  return { projected: true, reason: 'recovered-summary-projected' };
+}
