+      errors.push(`${repository}: invalid dev-tool producer handoff`);
+      continue;
+    }
+    repositories.add(repository);
+  }
+  return {
+    eligible: requests.length > 0 && errors.length === 0,
+    errors,
+    repositories: [...repositories].sort(),
+  };
