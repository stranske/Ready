\n   538\t        base_params = build_params(\n   539\t            cfg,\n   540\t            mu_idx=mu_idx,\n   541\t            idx_sigma=float(base_sigma[0]),\n   542\t            return_overrides=build_covariance_return_overrides(base_sigma, base_corr),\n   543\t        )\n   544\t        if cfg.regimes is not None:\n   545\t            if cfg.regime_transition is None:\n   546\t                raise ValueError(\"regime_transition is required when regimes are specified\")\n   547\t            base_regime_params, _labels = build_regime_draw_params(\n   548\t                cfg,\n   549\t                mu_idx=mu_idx,\n   550\t                idx_sigma=float(base_sigma[0]),\n   551\t                n_samples=n_samples,\n   552\t            )\n   553\t            rng_regime_base = spawn_rngs(None, 1)[0]\n   554\t            rng_regime_base.bit_generator.state = copy.deepcopy(rng_regime_state)\n   555\t            base_regime_paths = simulate_regime_paths(\n   556\t                n_sim=cfg.N_SIMULATIONS,\n   557\t                n_months=cfg.N_MONTHS,\n   558\t                transition=cfg.regime_transition,\n   559\t                start_state=resolve_regime_start(cfg),\n   560\t                rng=rng_regime_base,\n   561\t            )\n   562\t\n   563\t    return_shocks = None\n   564\t    if reuse_return_shocks:\n   565\t        if base_params is None:\n   566\t            raise RuntimeError(\"Base parameters are required to prepare return shocks\")\n   567\t        rng_returns_base = spawn_rngs(None, 1)[0]\n   568\t        rng_returns_base.bit_generator.state = copy.deepcopy(rng_returns_state)\n   569\t        return_shocks = prepare_return_shocks(\n   570\t            n_months=cfg.N_MONTHS,\n   571\t            n_sim=cfg.N_SIMULATIONS,\n   572\t            params=base_params,\n   573\t            rng=rng_returns_base,\n   574\t        )\n   575\t\n   576\t    financing_series = None\n   577\t    if reuse_financing_series:\n   578\t        idx_sigma_fin = float(base_sigma[0]) if base_sigma is not None else float(idx_sigma)\n   579\t        financing_params = build_params(cfg, mu_idx=mu_idx, idx_sigma=idx_sigma_fin)\n   580\t        fin_rngs_base: Dict[str, GeneratorLike] = {}\n   581\t        for name in fin_rngs.keys():\n   582\t            tmp_rng = spawn_rngs(None, 1)[0]\n   583\t            tmp_rng.bit_generator.state = copy.deepcopy(fin_rng_states[name])\n   584\t            fin_rngs_base[name] = tmp_rng\n   585\t        financing_series = draw_financing_series(\n   586\t            n_months=cfg.N_MONTHS,\n   587\t            n_sim=cfg.N_SIMULATIONS,\n   588\t            params=financing_params,\n   589\t            financing_mode=cfg.financing_mode,\n   590\t            rngs=fin_rngs_base,\n   591\t        )\n   592\t\n   593\t    combos_iter: Any = generate_parameter_combinations(cfg)\n   594\t    if progress is None:\n   595\t        combos_iter = progress_bar(combos_iter, total=total, desc=\"sweep\")\n   596\t    iterator = enumerate(combos_iter)\n   597\t\n   598\t    for i, overrides in iterator:\n   599\t        if return_shocks is None:\n   600\t            rng_returns.bit_generator.state = copy.deepcopy(rng_returns_state)\n   601\t            rng_regime.bit_generator.state = copy.deepcopy(rng_regime_state)\n   602\t        if financing_series is None:\n   603\t            for name, rng in fin_rngs.items():\n   604\t                rng.bit_generator.state = copy.deepcopy(fin_rng_states[name])\n   605\t\n   606\t        # Build each sweep case with ``model_copy`` (no full re-validation) so the\n   607\t        # grid can explore over-margin capital combinations as before, but re-run\n   608\t        # the inert-spike check so a sweep override cannot silently introduce a\n   609\t        # spike with zero financing volatility.\n   610\t        mod_cfg = cfg.model_copy(update=overrides)\n   611\t        validate_financing_spikes(mod_cfg)\n   612\t\n   684\t        r_beta, r_H, r_E, r_M = draw_joint_returns(\n   685\t            n_months=mod_cfg.N_MONTHS,\n   686\t            n_sim=mod_cfg.N_SIMULATIONS,\n   687\t            params=params,\n   688\t            rng=None if return_shocks is not None else rng_returns,\n   689\t            shocks=return_shocks,\n   690\t            regime_paths=regime_paths,\n   691\t            regime_params=regime_params,\n   692\t        )\n   693\t        if financing_series is None:\n   694\t            f_int, f_ext, f_act = draw_financing_series(\n   695\t                n_months=mod_cfg.N_MONTHS,\n   696\t                n_sim=mod_cfg.N_SIMULATIONS,\n   697\t                params=params,\n   698\t                financing_mode=mod_cfg.financing_mode,\n   699\t                rngs=fin_rngs,\n   700\t            )\n   701\t        else:\n   702\t            f_int, f_ext, f_act = financing_series\n   703\t        f_internal_pa = resolve_internal_pa_financing_series(\n   704\t            n_months=mod_cfg.N_MONTHS,\n   705\t            n_sim=mod_cfg.N_SIMULATIONS,\n   706\t            mean_month=getattr(mod_cfg, \"internal_pa_financing_mean_month\", 0.0),\n   707\t            sigma_month=getattr(mod_cfg, \"internal_pa_financing_sigma_month\", 0.0),\n   708\t            series=getattr(mod_cfg, \"internal_pa_financing_series\", None),\n   709\t            index=getattr(mod_cfg, \"internal_pa_financing_index\", None),\n   710\t            financing_mode=mod_cfg.financing_mode,\n   711\t            rng=fin_rngs.get(\"internal\") if fin_rngs else None,\n   712\t        )\n   713\t\n   714\t        agents = build_from_config(mod_cfg)\n   715\t        returns = simulate_agents(\n   716\t            agents,\n   717\t            r_beta,\n   718\t            r_H,\n   719\t            r_E,\n   720\t            r_M,\n   721\t            f_int,\n   722\t            f_ext,\n   723\t            f_act,\n   724\t            f_internal_pa,\n   725\t        )\n   726\t\n   727\t        summary = summary_table(returns, benchmark=\"Base\")\n   728\t        results.append(\n   729\t            {\n   730\t                \"combination_id\": i,\n   264\tdef _evaluate_allocation(\n   265\t    cfg: ModelConfig,\n   266\t    idx_series: pd.Series,\n   267\t    *,\n   268\t    ext_cap: float,\n   269\t    act_cap: float,\n   270\t    int_cap: float,\n   271\t    max_te: float,\n   272\t    max_breach: float,\n   273\t    max_cvar: float,\n   274\t    max_shortfall: float,\n   275\t    constraint_scope: Literal[\"sleeves\", \"total\", \"both\"],\n   276\t    seed: int | None,\n   277\t    objective: str | None = None,\n   278\t    stream_cache: _StreamCache | None = None,\n   279\t    include_returns: bool = False,\n   280\t) -> tuple[dict[str, float], bool, float | None] | None:\n   281\t    test_cfg = cfg.model_copy(\n   282\t        update={\n   283\t            \"external_pa_capital\": float(ext_cap),\n   284\t            \"active_ext_capital\": float(act_cap),\n   285\t            \"internal_pa_capital\": float(int_cap),\n   286\t        }\n   287\t    )\n   288\t    if stream_cache is None:\n   289\t        streams = None\n   290\t    else:\n   291\t        streams = stream_cache.get()\n   292\t    if streams is None:\n   293\t        orch = SimulatorOrchestrator(test_cfg, idx_series)\n   294\t        _, summary = orch.run(seed=seed)\n   295\t    else:\n   296\t        agents = build_from_config(test_cfg)\n   297\t        returns = simulate_agents(agents, *streams)\n   298\t        summary = summary_table(returns, benchmark=\"Base\")\n   299\t    result = _extract_metrics(\n   300\t        summary,\n   301\t        max_te=max_te,\n   302\t        max_breach=max_breach,\n   303\t        max_cvar=max_cvar,\n   304\t        max_shortfall=max_shortfall,\n   305\t        constraint_scope=constraint_scope,\n     1\tfrom __future__ import annotations\n     2\t\n     3\tfrom .types import Agent, Array\n     4\t\n     5\t\n     6\tclass InternalPAAgent(Agent):\n     7\t    def monthly_returns(\n     8\t        self,\n     9\t        r_beta: Array,\n    10\t        alpha_stream: Array,\n    11\t        financing: Array,\n    12\t    ) -> Array:\n    13\t        \"\"\"Return in-house alpha net of internal-PA financing cost.\n    14\t\n    15\t        ``financing`` is the internal-PA financing cost series (issue #1849):\n    16\t        a positive value is a cost that lowers the sleeve return, a negative\n    17\t        value is a benefit/positive carry that raises it. It is subtracted at\n    18\t        the sleeve level; total-portfolio scaling by the sleeve's capital share\n    19\t        is handled by the contribution machinery. When internal-PA financing is\n    20\t        disabled (the default), ``financing`` is all-zeros and the return is\n    21\t        pure in-house alpha, preserving historical behaviour.\n    22\t        \"\"\"\n    23\t        self._validate_inputs(r_beta, alpha_stream, financing)\n    24\t        return self.p.alpha_share * alpha_stream - financing\n    39\tdef resolve_internal_pa_financing_series(\n    40\t    *,\n    41\t    n_months: int,\n    42\t    n_sim: int,\n    43\t    mean_month: float = 0.0,\n    44\t    sigma_month: float = 0.0,\n    45\t    series: Sequence[float] | None = None,\n    46\t    index: str | None = None,\n    47\t    financing_mode: str = \"broadcast\",\n    48\t    rng: GeneratorLike | None = None,\n    49\t) -> npt.NDArray[Any]:\n    50\t    \"\"\"Return an ``(n_sim, n_months)`` internal-PA monthly financing matrix.\n    51\t\n    52\t    Negative costs are preserved. See module docstring for resolution order.\n    53\t    \"\"\"\n    54\t    if n_months <= 0:\n    55\t        raise ValueError(\"n_months must be positive\")\n    56\t    if n_sim <= 0:\n    57\t        raise ValueError(\"n_sim must be positive\")\n    58\t    if financing_mode not in _FINANCING_MODES:\n    59\t        raise ValueError(f\"financing_mode must be one of: {sorted(_FINANCING_MODES)}\")\n    60\t\n    61\t    # 1. Explicit per-month series.\n    62\t    if series is not None:\n    63\t        values = [float(v) for v in series]\n    64\t        if len(values) != n_months:\n    65\t            raise ValueError(\n    66\t                \"internal_pa_financing_series length \"\n    67\t                f\"({len(values)}) must equal n_months ({n_months})\"\n    68\t            )\n    69\t        row = np.asarray(values, dtype=float)\n    70\t        return cast(npt.NDArray[Any], np.broadcast_to(row, (n_sim, n_months)).copy())\n    71\t\n    72\t    # 2. Named index futures/swap financing curve.\n    73\t    if index is not None:\n    74\t        curve = get_index_financing_curve_monthly(index, n_months)\n    75\t        row = np.asarray(curve, dtype=float)\n    76\t        return cast(npt.NDArray[Any], np.broadcast_to(row, (n_sim, n_months)).copy())\n    77\t\n    78\t    # 3. Deterministic mean, optionally perturbed by a stochastic draw.\n    79\t    if sigma_month and sigma_month > 0.0:\n    80\t        if rng is None:\n    81\t            rng = spawn_rngs(None, 1)[0]\n    82\t        assert rng is not None\n    83\t        n_scenarios = 1 if financing_mode == \"broadcast\" else n_sim\n    84\t        draw = rng.normal(loc=mean_month, scale=sigma_month, size=(n_scenarios, n_months))\n    85\t        # No clip: negative financing costs are a supported input.\n    86\t        if n_scenarios == 1:\n    87\t            return cast(npt.NDArray[Any], np.broadcast_to(draw[0], (n_sim, n_months)).copy())\n    88\t        return cast(npt.NDArray[Any], draw)\n    89\t\n    90\t    # Deterministic constant (includes the all-defaults zero case).\n    91\t    return cast(npt.NDArray[Any], np.full((n_sim, n_months), float(mean_month), dtype=float))\n   472\t    agents = build_from_config(run_cfg)\n   473\t    returns = simulate_agents(\n   474\t        agents,\n   475\t        r_beta,\n   476\t        r_H,\n   477\t        r_E,\n   478\t        r_M,\n   479\t        f_int,\n   480\t        f_ext,\n   481\t        f_act,\n   482\t        f_internal_pa,\n   483\t        fee_schedule=run_cfg.fee_schedule,\n   484\t    )\n   485\t    summary = summary_table(returns, benchmark=\"Base\")\n--- existing tests / test gates ---\n    95\t    path = tmp_path / \"mixed_agents.yaml\"\n    96\t    path.write_text(yaml.safe_dump(data))\n    97\t    cfg = load_config(path)\n    98\t    names = {agent.name for agent in cfg.agents}\n    99\t    assert {\"Base\", \"ExternalPA\", \"ActiveExt\", \"InternalPA\", \"CustomSleeve\"} <= names\n   100\t\n   101\t\n   102\tdef test_model_dump_convenience_edits_recompile_standard_agents() -> None:\n   103\t    cfg = ModelConfig(\n   104\t        N_SIMULATIONS=1,\n   105\t        N_MONTHS=1,\n   106\t        financing_mode=\"broadcast\",\n   107\t        total_fund_capital=1000.0,\n   108\t        external_pa_capital=100.0,\n   109\t        active_ext_capital=200.0,\n   110\t        internal_pa_capital=300.0,\n   111\t        w_beta_H=0.6,\n   112\t        w_alpha_H=0.4,\n   113\t        theta_extpa=0.3,\n   114\t        active_share=0.5,\n   115\t    )\n   116\t    dumped = cfg.model_dump()\n   117\t    dumped.update(\n   118\t        {\n   119\t            \"external_pa_capital\": 120.0,\n   120\t            \"active_ext_capital\": 180.0,\n   121\t            \"internal_pa_capital\": 240.0,\n   122\t            \"w_beta_H\": 0.7,\n   123\t            \"w_alpha_H\": 0.3,\n   124\t            \"theta_extpa\": 0.8,\n   125\t            \"active_share\": 0.25,\n   126\t        }\n   127\t    )\n   128\t\n   129\t    reloaded = ModelConfig(**dumped)\n   130\t    agents = {agent.name: agent for agent in reloaded.agents}\n   131\t\n   132\t    assert agents[\"Base\"].beta_share == pytest.approx(0.7)\n   133\t    assert agents[\"Base\"].alpha_share == pytest.approx(0.3)\n   134\t    assert agents[\"ExternalPA\"].capital == pytest.approx(120.0)\n   135\t    assert agents[\"ExternalPA\"].beta_share == pytest.approx(0.12)\n   136\t    assert agents[\"ExternalPA\"].extra[\"theta_extpa\"] == pytest.approx(0.8)\n   137\t    assert agents[\"ActiveExt\"].capital == pytest.approx(180.0)\n   138\t    assert agents[\"ActiveExt\"].beta_share == pytest.approx(0.18)\n   139\t    assert agents[\"ActiveExt\"].extra[\"active_share\"] == pytest.approx(0.25)\n   140\t    assert agents[\"InternalPA\"].capital == pytest.approx(240.0)\n   141\t    assert agents[\"InternalPA\"].alpha_share == pytest.approx(0.24)\n   142\t\n   143\t\n   144\tdef test_model_dump_zero_capital_convenience_edits_drop_standard_agents() -> None:\n   145\t    cfg = ModelConfig(\n   151\tdef test_simulate_agents_scales_fees_by_sleeve_notional_share() -> None:\n   152\t    n_sim, n_months = 2, 3\n   153\t    r_beta = np.zeros((n_sim, n_months))\n   154\t    r_H = np.full((n_sim, n_months), 0.02)\n   155\t    f = np.zeros((n_sim, n_months))\n   156\t    agents = [InternalPAAgent(AgentParams(\"InternalPA\", 25.0, 0.0, 0.25, {}))]\n   157\t\n   158\t    gross = simulate_agents(agents, r_beta, r_H, r_H, r_H, f, f, f)\n   159\t    net = simulate_agents(\n   160\t        agents,\n   161\t        r_beta,\n   162\t        r_H,\n   163\t        r_H,\n   164\t        r_H,\n   165\t        f,\n   166\t        f,\n   167\t        f,\n   168\t        fee_schedule={\"InternalPA\": FeeSchedule(mgmt_fee_bps=120.0)},\n   169\t    )\n   170\t\n   171\t    assert np.allclose(gross[\"InternalPA\"], 0.005)\n   172\t    assert np.allclose(gross[\"InternalPA\"] - net[\"InternalPA\"], 0.00025)\n   173\t\n   174\t\n   175\tdef test_simulate_agents_default_is_backward_compatible() -> None:\n   176\t    n_sim, n_months = 2, 3\n   177\t    r_beta = np.zeros((n_sim, n_months))\n   178\t    r_H = np.full((n_sim, n_months), 0.02)\n   179\t    f = np.zeros((n_sim, n_months))\n   180\t    agents = [InternalPAAgent(AgentParams(\"InternalPA\", 100.0, 0.0, 1.0, {}))]\n   181\t    # No fee_schedule arg -> identical to gross.\n   182\t    assert np.allclose(simulate_agents(agents, r_beta, r_H, r_H, r_H, f, f, f)[\"InternalPA\"], 0.02)\n   183\t\n   184\t\n   185\t# ---------------------------------------------------------------------------\n   186\t# End-to-end via run_single (acceptance criteria) + config plumbing\n   187\t# ---------------------------------------------------------------------------\n   188\t\n   189\t\n   190\tdef _scenario():\n   191\t    return load_config(\"examples/scenarios/my_first_scenario.yml\").model_copy(\n   192\t        update={\n   193\t            \"N_SIMULATIONS\": 200,\n   194\t            \"N_MONTHS\": 6,\n   195\t            \"agents\": [\n   196\t                AgentConfig(\n   197\t                    name=\"InternalPA\",\n   198\t                    capital=150.0,\n   199\t                    beta_share=0.0,\n   200\t                    alpha_share=0.15,\n   201\t                )\n   202\t            ],\n   203\t        }\n   204\t    )\n   205\t\n   206\t\n   207\tdef _internal_pa_mean(cfg) -> float:\n   208\t    idx = pd.Series([0.01, -0.02, 0.015, 0.0, 0.005, -0.01])\n   209\t    artifacts = run_single(cfg, idx, RunOptions(seed=7))\n   210\t    return float(artifacts.raw_returns[\"InternalPA\"].to_numpy().mean())\n   211\t\n   212\t\n   213\tdef test_default_config_has_no_fee_schedule() -> None:\n   214\t    assert _scenario().fee_schedule is None\n   215\t\n   216\t\n   217\tdef test_run_single_mgmt_fee_lowers_return_by_exact_drag() -> None:\n   218\t    base = _scenario()\n   219\t    gross = _internal_pa_mean(base)\n   220\t    net = _internal_pa_mean(\n   221\t        base.model_copy(update={\"fee_schedule\": {\"InternalPA\": FeeSchedule(mgmt_fee_bps=120.0)}})\n   222\t    )\n   223\t    # 120 bps annual on a 150mm sleeve in a 1000mm fund:\n   224\t    # 0.012 / 12 * 0.15 = 0.00015 contribution-return drag.\n   225\t    assert gross - net == pytest.approx(0.00015, abs=1e-9)\n   226\t\n   227\t\n   228\tdef test_run_single_perf_fee_lowers_return() -> None:\n   229\t    base = _scenario()\n   230\t    gross = _internal_pa_mean(base)\n   231\t    net = _internal_pa_mean(\n   232\t        base.model_copy(\n   233\t            update={\"fee_schedule\": {\"InternalPA\": FeeSchedule(perf_fee_pct=0.5, hurdle_bps=0.0)}}\n   234\t        )\n   235\t    )\n   236\t    assert net < gross\n     1\timport pandas as pd\n     2\t\n     3\tfrom pa_core import sweep as sweep_module\n     4\tfrom pa_core.config import load_config\n     5\tfrom pa_core.random import spawn_agent_rngs, spawn_rngs\n     6\t\n     7\t\n     8\tdef test_duplicate_combinations_share_random_draws(monkeypatch):\n     9\t    cfg = load_config(\"examples/scenarios/my_first_scenario.yml\").model_copy(\n    10\t        update={\"N_SIMULATIONS\": 3, \"N_MONTHS\": 4, \"analysis_mode\": \"returns\"}\n    11\t    )\n    12\t    idx = pd.Series([0.01, -0.02, 0.03, 0.0])\n    13\t    overrides = {\n    14\t        \"mu_H\": cfg.mu_H,\n    15\t        \"sigma_H\": cfg.sigma_H,\n    16\t        \"mu_E\": cfg.mu_E,\n    17\t        \"sigma_E\": cfg.sigma_E,\n    18\t    }\n    19\t    combos = [overrides.copy(), overrides.copy()]\n    20\t\n    21\t    monkeypatch.setattr(\n    22\t        sweep_module,\n    23\t        \"generate_parameter_combinations\",\n    24\t        lambda _cfg: iter(combos),\n    25\t    )\n    26\t\n    27\t    rng_returns = spawn_rngs(123, 1)[0]\n    28\t    fin_rngs = spawn_agent_rngs(123, [\"internal\", \"external_pa\", \"active_ext\"])\n    29\t    results = sweep_module.run_parameter_sweep(cfg, idx, rng_returns, fin_rngs)\n    30\t\n    31\t    assert len(results) == 2\n    32\t    pd.testing.assert_frame_equal(results[0][\"summary\"], results[1][\"summary\"])\n    33\t\n    34\t\n    35\tdef test_duplicate_combinations_share_random_draws_with_seed(monkeypatch):\n    36\t    cfg = load_config(\"examples/scenarios/my_first_scenario.yml\").model_copy(\n    37\t        update={\"N_SIMULATIONS\": 3, \"N_MONTHS\": 4, \"analysis_mode\": \"returns\"}\n    38\t    )\n    39\t    idx = pd.Series([0.01, -0.02, 0.03, 0.0])\n    40\t    overrides = {\n    41\t        \"mu_H\": cfg.mu_H,\n    42\t        \"sigma_H\": cfg.sigma_H,\n    43\t        \"mu_E\": cfg.mu_E,\n    44\t        \"sigma_E\": cfg.sigma_E,\n    45\t    }\n    46\t    combos = [overrides.copy(), overrides.copy()]\n    47\t\n    48\t    monkeypatch.setattr(\n    49\t        sweep_module,\n    50\t        \"generate_parameter_combinations\",\n    51\t        lambda _cfg: iter(combos),\n    52\t    )\n    53\t\n    54\t    rng_returns = spawn_rngs(999, 1)[0]\n    55\t    fin_rngs = spawn_agent_rngs(999, [\"internal\", \"external_pa\", \"active_ext\"])\n    56\t    rng_returns.normal(size=3)\n    57\t    for rng in fin_rngs.values():\n    58\t        rng.normal(size=3)\n    59\t\n    60\t    results = sweep_module.run_parameter_sweep(cfg, idx, rng_returns, fin_rngs, seed=123)\n    61\t\n    62\t    assert len(results) == 2\n    63\t    pd.testing.assert_frame_equal(results[0][\"summary\"], results[1][\"summary\"])\n    98\tdef test_suggest_sleeve_sizes_returns_feasible():\n    99\t    cfg = load_config(\"examples/scenarios/test_params.yml\")\n   100\t    cfg = cfg.model_copy(update={\"N_SIMULATIONS\": 50})\n   101\t    idx_series = pd.Series([0.0] * cfg.N_MONTHS)\n   102\t    df = suggest_sleeve_sizes(\n   103\t        cfg,\n   104\t        idx_series,\n   105\t        max_te=0.02,\n   106\t        max_breach=0.5,\n   107\t        max_cvar=0.05,\n   108\t        max_shortfall=0.5,\n   109\t        step=0.5,\n   110\t        seed=1,\n   111\t    )\n   112\t    assert not df.empty\n   113\t    assert {\n   114\t        \"external_pa_capital\",\n   115\t        \"active_ext_capital\",\n   116\t        \"internal_pa_capital\",\n   117\t    }.issubset(df.columns)\n   118\t\n   119\t\n   120\tdef test_suggest_sleeve_sizes_respects_bounds():\n   121\t    cfg = load_config(\"examples/scenarios/test_params.yml\")\n   122\t    cfg = cfg.model_copy(update={\"N_SIMULATIONS\": 50})\n   123\t    idx_series = pd.Series([0.0] * cfg.N_MONTHS)\n   124\t    max_te = 0.02\n   125\t    max_breach = 0.5\n   126\t    max_cvar = 0.05\n   127\t    max_shortfall = 0.5\n   128\t    df = suggest_sleeve_sizes(\n   129\t        cfg,\n   130\t        idx_series,\n   131\t        max_te=max_te,\n   132\t        max_breach=max_breach,\n   133\t        max_cvar=max_cvar,\n   134\t        max_shortfall=max_shortfall,\n   135\t        step=0.5,\n   136\t        seed=1,\n   137\t    )\n   138\t    assert (df.filter(regex=\"_TE\").fillna(0) <= max_te).all().all()\n   139\t    assert (df.filter(regex=\"_BreachProb\").fillna(0) <= max_breach).all().all()\n   140\t    assert (df.filter(regex=\"_CVaR\").fillna(0).abs() <= max_cvar).all().all()\n   141\t    assert (df.filter(regex=\"_ShortfallProb\").fillna(0) <= max_shortfall).all().all()\n   142\t\n   143\t\n   144\tdef test_cli_sleeve_suggestion(tmp_path, monkeypatch):\n   145\t    cfg = {\"N_SIMULATIONS\": 10, \"N_MONTHS\": 1, \"financing_mode\": \"broadcast\"}\n   402\tdef test_suggest_sleeve_sizes_reuses_cached_streams(monkeypatch):\n   403\t    cfg = ModelConfig(\n   404\t        N_SIMULATIONS=1,\n   405\t        N_MONTHS=1,\n   406\t        financing_mode=\"broadcast\",\n   407\t        total_fund_capital=100.0,\n   408\t        external_pa_capital=50.0,\n   409\t        active_ext_capital=25.0,\n   410\t        internal_pa_capital=25.0,\n   411\t    )\n   412\t    idx_series = pd.Series([0.0])\n   413\t\n   414\t    r = np.zeros((1, 1))\n   415\t    streams = (r, r, r, r, r, r, r)\n   416\t    calls = {\"draw\": 0}\n   417\t\n   418\t    class DummyOrchestrator:\n   419\t        def __init__(self, cfg, idx_series):\n   420\t            self.cfg = cfg\n   421\t            self.idx_series = idx_series\n   422\t\n   423\t        def draw_streams(self, seed=None):\n   424\t            calls[\"draw\"] += 1\n   425\t            return streams\n   426\t\n   427\t        def run(self, seed=None):\n   428\t            raise AssertionError(\"run should not be called when streams are cached\")\n   429\t\n   430\t    monkeypatch.setattr(\"pa_core.sleeve_suggestor.SimulatorOrchestrator\", DummyOrchestrator)\n   431\t\n   432\t    df = suggest_sleeve_sizes(\n   433\t        cfg,\n   434\t        idx_series,\n   435\t        max_te=1.0,\n   436\t        max_breach=1.0,\n   437\t        max_cvar=1.0,\n   438\t        max_shortfall=1.0,\n   439\t        step=0.5,\n   440\t        max_evals=3,\n   441\t    )\n   442\t\n   443\t    assert calls[\"draw\"] == 1\n   444\t    assert not df.empty\n   445\t\n--- artifact files ---\nfind: -printf: unknown primary or operator\n","exit_code":0,"status":"completed"}}
