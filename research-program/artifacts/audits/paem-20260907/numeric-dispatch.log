e:\n   249\t        overrides[\"analysis_mode\"] = run_options.analysis_mode\n   250\t    if sweep_params:\n   251\t        overrides.update(sweep_params)\n   252\t\n   253\t    if not overrides:\n   254\t        return config\n   255\t\n   256\t    data = config.model_dump()\n   257\t    data.update(overrides)\n   258\t    return config.__class__.model_validate(data)\n   259\t\n   260\t\n   261\t@dataclass(slots=True)\n   262\tclass ExportOptions:\n   263\t    \"\"\"Configuration options for exporting artifacts.\n   264\t\n   265\t    Attributes:\n   266\t        pivot: If True, write all returns in a single long-format sheet.\n   267\t        include_sensitivity: If True, include sensitivity analysis in exports.\n   268\t        include_charts: If True, embed charts in Excel output.\n   269\t        alt_text: Alt text for accessibility in exported charts.\n   270\t        include_visualizations: If True, generate comparison visualizations.\n   271\t        viz_output_dir: Optional directory for visualization HTML output.\n   272\t        show_visualizations: If True, display visualizations interactively.\n   273\t    \"\"\"\n   274\t\n   275\t    pivot: bool = False\n   330\t\n   331\t    from .agents.registry import build_from_config\n   332\t    from .backend import resolve_and_set_backend\n   333\t    from .sim import (\n   334\t        draw_financing_series,\n   335\t        draw_joint_returns,\n   336\t        resolve_internal_pa_financing_series,\n   337\t    )\n   338\t    from .sim.covariance import build_cov_matrix\n   339\t    from .sim.metrics import summary_table\n   340\t    from .sim.params import (\n   341\t        build_covariance_return_overrides,\n   342\t        build_params,\n   343\t        resolve_covariance_inputs,\n   344\t    )\n   345\t    from .sim.regimes import (\n   346\t        apply_regime_labels,\n   347\t        build_regime_draw_params,\n   348\t        resolve_regime_start,\n   349\t        simulate_regime_paths,\n   350\t    )\n   351\t    from .sim.simulation_initialization import initialize_run_rngs\n   352\t    from .simulations import simulate_agents\n   353\t    from .units import normalize_return_inputs\n   354\t    from .validators import select_vol_regime_sigma\n   355\t\n   356\t    started = time.perf_counter()\n   357\t    run_options = options or RunOptions()\n   358\t    run_cfg = apply_run_options(config, run_options)\n   359\t    resolve_and_set_backend(run_options.backend, run_cfg)\n   360\t\n   361\t    idx_series = index_series\n   362\t    if isinstance(idx_series, pd.DataFrame):\n   363\t        idx_series = idx_series.squeeze()\n   364\t        if not isinstance(idx_series, pd.Series):\n   365\t            raise ValueError(\"Index data must be convertible to pandas Series\")\n   366\t    elif not isinstance(idx_series, pd.Series):\n   367\t        raise ValueError(\"Index data must be a pandas Series\")\n   368\t\n   369\t    mu_idx = float(idx_series.mean())\n   370\t    idx_sigma, _, _ = select_vol_regime_sigma(\n   371\t        idx_series,\n   372\t        regime=run_cfg.vol_regime,\n   373\t        window=run_cfg.vol_regime_window,\n   374\t    )\n   375\t    n_samples = int(len(idx_series))\n   376\t\n   377\t    return_inputs = normalize_return_inputs(run_cfg)\n   378\t    sigma_h = float(return_inputs[\"sigma_H\"])\n   379\t    sigma_e = float(return_inputs[\"sigma_E\"])\n   380\t    sigma_m = float(return_inputs[\"sigma_M\"])\n   381\t\n   382\t    cov = build_cov_matrix(\n   383\t        run_cfg.rho_idx_H,\n   384\t        run_cfg.rho_idx_E,\n   385\t        run_cfg.rho_idx_M,\n   386\t        run_cfg.rho_H_E,\n   387\t        run_cfg.rho_H_M,\n   388\t        run_cfg.rho_E_M,\n   389\t        idx_sigma,\n   390\t        sigma_h,\n   391\t        sigma_e,\n   392\t        sigma_m,\n   393\t        covariance_shrinkage=run_cfg.covariance_shrinkage,\n   394\t        n_samples=n_samples,\n   395\t    )\n   396\t    sigma_vec, corr_mat = resolve_covariance_inputs(\n   397\t        cov,\n   398\t        idx_sigma=idx_sigma,\n   399\t        sigma_h=sigma_h,\n   400\t        sigma_e=sigma_e,\n   401\t        sigma_m=sigma_m,\n   402\t        rho_idx_H=run_cfg.rho_idx_H,\n   403\t        rho_idx_E=run_cfg.rho_idx_E,\n   404\t        rho_idx_M=run_cfg.rho_idx_M,\n   405\t        rho_H_E=run_cfg.rho_H_E,\n   406\t        rho_H_M=run_cfg.rho_H_M,\n   407\t        rho_E_M=run_cfg.rho_E_M,\n   408\t    )\n   409\t\n   410\t    params = build_params(\n   411\t        run_cfg,\n   412\t        mu_idx=mu_idx,\n   413\t        idx_sigma=float(sigma_vec[0]),\n   414\t        return_overrides=build_covariance_return_overrides(sigma_vec, corr_mat),\n   415\t    )\n   416\t\n   417\t    rng_bundle = initialize_run_rngs(\n   418\t        run_options.seed,\n   419\t        legacy_agent_rng=run_options.legacy_agent_rng,\n   420\t    )\n   421\t    rng_returns = rng_bundle.rng_returns\n   422\t    rng_regime = rng_bundle.rng_regime\n   423\t    fin_rngs = rng_bundle.rngs_financing\n   424\t    substream_ids = rng_bundle.substream_ids\n   425\t    regime_params = None\n   426\t    regime_paths = None\n   427\t    regime_labels = None\n   428\t    if run_cfg.regimes is not None:\n   429\t        if run_cfg.regime_transition is None:\n   430\t            raise ValueError(\"regime_transition is required when regimes are specified\")\n   431\t        regime_params, labels = build_regime_draw_params(\n   432\t            run_cfg,\n   433\t            mu_idx=mu_idx,\n   434\t            idx_sigma=idx_sigma,\n   435\t            n_samples=n_samples,\n   436\t        )\n   437\t        regime_paths = simulate_regime_paths(\n   438\t            n_sim=run_cfg.N_SIMULATIONS,\n   439\t            n_months=run_cfg.N_MONTHS,\n   440\t            transition=run_cfg.regime_transition,\n   441\t            start_state=resolve_regime_start(run_cfg),\n   442\t            rng=rng_regime,\n   443\t        )\n   444\t        regime_labels = apply_regime_labels(regime_paths, labels)\n   445\t    r_beta, r_H, r_E, r_M = draw_joint_returns(\n   446\t        n_months=run_cfg.N_MONTHS,\n   447\t        n_sim=run_cfg.N_SIMULATIONS,\n   448\t        params=params,\n   449\t        rng=rng_returns,\n   450\t        regime_paths=regime_paths,\n   451\t        regime_params=regime_params,\n   452\t    )\n   453\t    corr_repair_info = params.get(\"_correlation_repair_info\")\n   454\t    f_int, f_ext, f_act = draw_financing_series(\n   455\t        n_months=run_cfg.N_MONTHS,\n   456\t        n_sim=run_cfg.N_SIMULATIONS,\n   457\t        params=params,\n   458\t        financing_mode=run_cfg.financing_mode,\n   459\t        rngs=fin_rngs,\n   460\t    )\n   461\t    f_internal_pa = resolve_internal_pa_financing_series(\n   462\t        n_months=run_cfg.N_MONTHS,\n   463\t        n_sim=run_cfg.N_SIMULATIONS,\n   464\t        mean_month=getattr(run_cfg, \"internal_pa_financing_mean_month\", 0.0),\n   465\t        sigma_month=getattr(run_cfg, \"internal_pa_financing_sigma_month\", 0.0),\n   466\t        series=getattr(run_cfg, \"internal_pa_financing_series\", None),\n   467\t        index=getattr(run_cfg, \"internal_pa_financing_index\", None),\n   468\t        financing_mode=run_cfg.financing_mode,\n   469\t        rng=fin_rngs.get(\"internal\") if fin_rngs else None,\n   470\t    )\n   471\t\n   472\t    agents = build_from_config(run_cfg)\n   473\t    returns = simulate_agents(\n   474\t        agents,\n   475\t        r_beta,\n   476\t        r_H,\n   477\t        r_E,\n   478\t        r_M,\n   479\t        f_int,\n   480\t        f_ext,\n   481\t        f_act,\n   482\t        f_internal_pa,\n   483\t        fee_schedule=run_cfg.fee_schedule,\n   484\t    )\n   485\t    summary = summary_table(returns, benchmark=\"Base\")\n   486\t    if getattr(run_cfg, \"sleeve_validate_on_run\", False):\n   487\t        from .reporting.constraints import validate_sleeve_constraints\n   488\t\n   489\t        violations = validate_sleeve_constraints(summary, run_cfg)\n   490\t        if violations:\n   491\t            formatted = \"\\n\".join(f\"- {violation}\" for violation in violations)\n   492\t            raise ValueError(f\"Sleeve constraint violations:\\n{formatted}\")\n   493\t    raw_returns = {name: pd.DataFrame(data) for name, data in returns.items()}\n   494\t    if regime_labels is not None:\n   495\t        raw_returns[\"Regime\"] = pd.DataFrame(regime_labels)\n   496\t    inputs = run_cfg.model_dump()\n   497\t    if isinstance(corr_repair_info, dict):\n   498\t        corr_before_raw = corr_repair_info.get(\"corr_before\")\n   499\t        corr_after_raw = corr_repair_info.get(\"corr_after\")\n   500\t        corr_delta_raw = corr_repair_info.get(\"corr_delta\")\n   501\t        if corr_before_raw is not None and corr_after_raw is not None:\n   502\t            corr_before = np.array(corr_before_raw, dtype=float)\n   503\t            corr_after = np.array(corr_after_raw, dtype=float)\n   504\t            if corr_before.shape == corr_after.shape and corr_before.size:\n   505\t                corr_delta = (\n   506\t                    np.array(corr_delta_raw, dtype=float)\n   507\t                    if corr_delta_raw is not None\n   508\t                    else corr_after - corr_before\n   509\t                )\n   510\t                labels = [\"Index\", \"H\", \"E\", \"M\"]\n   610\t        artifacts = run_sweep(cfg, idx, sweep_params, RunOptions(seed=42))\n   611\t\n   612\t        # Access consolidated results\n   613\t        print(artifacts.summary)\n   614\t    \"\"\"\n   615\t\n   616\t    import pandas as pd\n   617\t\n   618\t    from .backend import resolve_and_set_backend\n   619\t    from .sim.simulation_initialization import initialize_sweep_rngs\n   620\t    from .sweep import run_parameter_sweep, sweep_results_to_dataframe\n   621\t\n   622\t    started = time.perf_counter()\n   623\t    run_options = options or RunOptions()\n   624\t    run_cfg = apply_run_options(config, run_options, sweep_params)\n   625\t    resolve_and_set_backend(run_options.backend, run_cfg)\n   626\t\n   627\t    idx_series = index_series\n   628\t    if isinstance(idx_series, pd.DataFrame):\n   629\t        idx_series = idx_series.squeeze()\n   630\t        if not isinstance(idx_series, pd.Series):\n   631\t            raise ValueError(\"Index data must be convertible to pandas Series\")\n   632\t    elif not isinstance(idx_series, pd.Series):\n   633\t        raise ValueError(\"Index data must be a pandas Series\")\n   634\t\n   635\t    rng_bundle = initialize_sweep_rngs(\n   636\t        run_options.seed,\n   637\t        legacy_agent_rng=run_options.legacy_agent_rng,\n   638\t    )\n   639\t    rng_returns = rng_bundle.rng_returns\n   640\t    fin_rngs = rng_bundle.rngs_financing\n   641\t    substream_ids = rng_bundle.substream_ids\n   642\t    child_seed = rng_bundle.seed\n   643\t    results = run_parameter_sweep(\n   644\t        run_cfg,\n   645\t        idx_series,\n   646\t        rng_returns,\n   647\t        fin_rngs,\n   648\t        seed=child_seed,\n   649\t        rng_regime=rng_bundle.rng_regime,\n   650\t    )\n   651\t    summary = sweep_results_to_dataframe(results)\n   652\t    inputs = run_cfg.model_dump()\n   653\t\n   654\t    manifest = {\n   655\t        \"seed\": run_options.seed,\n   656\t        \"substream_ids\": substream_ids,\n   657\t    }\n   658\t\n   659\t    artifacts = SweepArtifacts(\n   660\t        config=run_cfg,\n   661\t        index_series=idx_series,\n   662\t        results=results,\n   663\t        summary=summary,\n   664\t        inputs=inputs,\n   665\t        manifest=manifest,\n   666\t    )\n   667\t    from .llm.scenario_fleet import SCENARIO_SWEEP_OPERATION, record_scenario_run\n   668\t\n   669\t    record_scenario_run(\n   670\t        run_cfg,\n   671\t        summary,\n   672\t        seed=run_options.seed,\n   673\t        latency_ms=int((time.perf_counter() - started) * 1000),\n   674\t        operation=SCENARIO_SWEEP_OPERATION,\n   675\t    )\n--- config 580-925 ---\n   560\t    @classmethod\n   561\t    def _apply_explicit_return_units(\n   562\t        cls, data: dict[str, Any]\n   563\t    ) -> tuple[dict[str, Any], str | None, list[str]]:\n   564\t        raw_keys = set(data)\n   565\t        updated = dict(data)\n   566\t        explicit_unit: str | None = None\n   567\t        explicit_fields: set[str] = set()\n   568\t        legacy_fields: list[str] = []\n   569\t\n   570\t        for field, unit_keys in cls._RETURN_UNIT_EXPLICIT_KEYS.items():\n   571\t            annual_keys = [key for key in unit_keys[\"annual\"] if key in updated]\n   572\t            monthly_keys = [key for key in unit_keys[\"monthly\"] if key in updated]\n   573\t            if annual_keys and monthly_keys:\n   574\t                raise ValueError(\n   575\t                    f\"Ambiguous return unit for {field}: provide only annual or monthly values.\"\n   576\t                )\n   577\t            if len(annual_keys) > 1 or len(monthly_keys) > 1:\n   578\t                raise ValueError(\n   579\t                    f\"Ambiguous return unit for {field}: multiple keys provided for the same unit.\"\n   580\t                )\n   581\t            if annual_keys or monthly_keys:\n   582\t                unit = \"annual\" if annual_keys else \"monthly\"\n   583\t                if explicit_unit and explicit_unit != unit:\n   584\t                    raise ValueError(\n   585\t                        \"Conflicting return units provided across return inputs. \"\n   586\t                        \"Use a single unit for mu/sigma inputs.\"\n   587\t                    )\n   588\t                explicit_unit = unit\n   589\t                key = (annual_keys or monthly_keys)[0]\n   590\t                if field in raw_keys:\n   591\t                    raise ValueError(\n   592\t                        f\"Ambiguous return unit for {field}: do not mix {field} with {key}.\"\n   593\t                    )\n   594\t                updated[field] = updated[key]\n   595\t                del updated[key]\n   596\t                explicit_fields.add(field)\n   597\t            if field in raw_keys and field not in explicit_fields:\n   598\t                legacy_fields.append(field)\n   599\t\n   600\t        return updated, explicit_unit, legacy_fields\n   601\t\n   602\t    @classmethod\n   603\t    def compile_agent_config(cls, data: Any) -> Any:\n   604\t        if not isinstance(data, dict):\n   605\t            return data\n   606\t        cls._trace_transform(data, \"compile_agent_config\")\n   607\t\n   608\t        convenience_keys = {\n   609\t            \"external_pa_capital\",\n   610\t            \"active_ext_capital\",\n   611\t            \"internal_pa_capital\",\n   612\t            \"w_beta_H\",\n   613\t            \"w_alpha_H\",\n   614\t            \"theta_extpa\",\n   615\t            \"active_share\",\n   616\t            \"External PA capital (mm)\",\n   617\t            \"Active Extension capital (mm)\",\n   618\t            \"Internal PA capital (mm)\",\n   619\t            \"In-House beta share\",\n   620\t            \"In-House alpha share\",\n   621\t            \"External PA alpha fraction\",\n   622\t            \"Active share (%)\",\n   623\t            \"Active share\",\n   624\t        }\n   625\t        agents_provided = \"agents\" in data\n   626\t        convenience_used = any(key in data for key in convenience_keys)\n   627\t        if agents_provided and not convenience_used:\n   628\t            raw_agents = data.get(\"agents\") or []\n   629\t            data[\"agents\"] = cls._normalize_agents(raw_agents)\n   630\t            return data\n   631\t\n   632\t        def _get_value(field: str, aliases: tuple[str, ...] = ()) -> Any:\n   633\t            for key in (field, *aliases):\n   634\t                if key in data:\n   635\t                    return data[key]\n   636\t            field_info = cls.model_fields[field]\n   637\t            if field_info.default_factory is not None:\n   638\t                factory = cast(Callable[[], Any], field_info.default_factory)\n   639\t                return factory()\n   640\t            return field_info.default\n   641\t\n   642\t        total_cap = float(_get_value(\"total_fund_capital\", (\"Total fund capital (mm)\",)))\n   643\t        if total_cap <= 0:\n   644\t            # Guard the sleeve `capital / total_cap` shares below: a zero/negative\n   645\t            # total fund capital previously raised ZeroDivisionError here, before\n   646\t            # the gt=0 Field constraint could report it. Raise a clean validation\n   647\t            # error instead.\n   648\t            raise ValueError(\"total_fund_capital must be greater than 0\")\n   649\t        w_beta = normalize_share(_get_value(\"w_beta_H\", (\"In-House beta share\",)))\n   650\t        w_alpha = normalize_share(_get_value(\"w_alpha_H\", (\"In-House alpha share\",)))\n   651\t        theta = normalize_share(_get_value(\"theta_extpa\", (\"External PA alpha fraction\",)))\n   652\t        active_share = normalize_share(\n   653\t            _get_value(\"active_share\", (\"Active share (%)\", \"Active share\"))\n   654\t        )\n   655\t        ext_cap = float(_get_value(\"external_pa_capital\", (\"External PA capital (mm)\",)))\n   656\t        act_cap = float(_get_value(\"active_ext_capital\", (\"Active Extension capital (mm)\",)))\n   657\t        int_cap = float(_get_value(\"internal_pa_capital\", (\"Internal PA capital (mm)\",)))\n   658\t\n   659\t        w_beta = 0.0 if w_beta is None else float(w_beta)\n   660\t        w_alpha = 0.0 if w_alpha is None else float(w_alpha)\n   661\t        theta = 0.0 if theta is None else float(theta)\n   662\t        active_share = 0.0 if active_share is None else float(active_share)\n   663\t\n   664\t        compiled: list[dict[str, Any]] = [\n   665\t            {\n   666\t                \"name\": \"Base\",\n   667\t                \"capital\": total_cap,\n   668\t                \"beta_share\": w_beta,\n   669\t                \"alpha_share\": w_alpha,\n   670\t                \"extra\": {},\n   671\t            }\n   672\t        ]\n   673\t\n   674\t        if ext_cap > 0:\n   675\t            compiled.append(\n   676\t                {\n   677\t                    \"name\": \"ExternalPA\",\n   678\t                    \"capital\": ext_cap,\n   679\t                    \"beta_share\": ext_cap / total_cap,\n   680\t                    \"alpha_share\": 0.0,\n   681\t                    \"extra\": {\"theta_extpa\": theta},\n   682\t                }\n   683\t            )\n   684\t\n   685\t        if act_cap > 0:\n   686\t            compiled.append(\n   687\t                {\n   688\t                    \"name\": \"ActiveExt\",\n   689\t                    \"capital\": act_cap,\n   690\t                    \"beta_share\": act_cap / total_cap,\n   691\t                    \"alpha_share\": 0.0,\n   692\t                    \"extra\": {\"active_share\": active_share},\n   693\t                }\n   694\t            )\n   695\t\n   696\t        if int_cap > 0:\n   697\t            compiled.append(\n   698\t                {\n   699\t                    \"name\": \"InternalPA\",\n   700\t                    \"capital\": int_cap,\n   701\t                    \"beta_share\": 0.0,\n   702\t                    \"alpha_share\": int_cap / total_cap,\n   703\t                    \"extra\": {},\n   704\t                }\n   705\t            )\n   706\t\n   707\t        existing_agents = data.get(\"agents\") or []\n   708\t        if agents_provided:\n   709\t            normalized_existing = cls._normalize_agents(existing_agents)\n   710\t            existing_names = {agent[\"name\"] for agent in normalized_existing}\n   711\t            recompiled_names = cls._agent_names_recompiled_by_convenience(data)\n   712\t            compiled = [\n   713\t                agent\n   714\t                for agent in compiled\n   715\t                if agent[\"name\"] in recompiled_names or agent[\"name\"] not in existing_names\n   716\t            ]\n   717\t            compiled_names = {agent[\"name\"] for agent in compiled}\n   718\t            compiled = compiled + [\n   719\t                agent\n   720\t                for agent in normalized_existing\n   721\t                if agent[\"name\"] not in compiled_names and agent[\"name\"] not in recompiled_names\n   722\t            ]\n   723\t        normalized = cls._normalize_agents(compiled)\n   724\t        data[\"agents\"] = normalized\n   725\t        return data\n   726\t\n   727\t    @classmethod\n   728\t    def _agent_names_recompiled_by_convenience(cls, data: Mapping[str, Any]) -> set[str]:\n   729\t        \"\"\"Return derived agent names controlled by supplied convenience fields.\"\"\"\n   730\t\n   731\t        groups = {\n   732\t            \"Base\": {\n   733\t                \"total_fund_capital\",\n   734\t                \"Total fund capital (mm)\",\n   735\t                \"w_beta_H\",\n   736\t                \"w_alpha_H\",\n   737\t                \"In-House beta share\",\n   738\t                \"In-House alpha share\",\n   739\t            },\n   740\t            \"ExternalPA\": {\n   741\t                \"total_fund_capital\",\n   742\t                \"Total fund capital (mm)\",\n   743\t                \"external_pa_capital\",\n   744\t                \"External PA capital (mm)\",\n   745\t                \"theta_extpa\",\n   746\t                \"External PA alpha fraction\",\n   747\t            },\n   748\t            \"ActiveExt\": {\n   749\t                \"total_fund_capital\",\n   750\t                \"Total fund capital (mm)\",\n   751\t                \"active_ext_capital\",\n   752\t                \"Active Extension capital (mm)\",\n   753\t                \"active_share\",\n   754\t                \"Active share (%)\",\n   755\t                \"Active share\",\n   756\t            },\n   757\t            \"InternalPA\": {\n   758\t                \"total_fund_capital\",\n   759\t                \"Total fund capital (mm)\",\n   760\t                \"internal_pa_capital\",\n   761\t                \"Internal PA capital (mm)\",\n   762\t            },\n   763\t        }\n   764\t        return {\n   765\t            agent_name for agent_name, keys in groups.items() if any(key in data for key in keys)\n   766\t        }\n   767\t\n   768\t    @classmethod\n   769\t    def normalize_share_inputs(cls, data: Any) -> Any:\n   770\t        if not isinstance(data, dict):\n   771\t            return data\n   772\t        cls._trace_transform(data, \"normalize_share_inputs\")\n   773\t        share_fields = {\n   774\t            \"w_beta_H\": (\"In-House beta share\",),\n   775\t            \"w_alpha_H\": (\"In-House alpha share\",),\n   776\t            \"active_share\": (\"Active share (%)\", \"Active share\"),\n   777\t            \"theta_extpa\": (\"External PA alpha fraction\",),\n   778\t        }\n   779\t        for field, aliases in share_fields.items():\n   780\t            for key in (field, *aliases):\n   781\t                if key in data:\n   782\t                    data[key] = normalize_share(data[key])\n   783\t        return data\n   784\t\n   785\t    @classmethod\n   786\t    def _normalize_regime_sigma_overrides(cls, regimes: Any) -> Any:\n   787\t        if (\n   788\t            regimes is None\n   789\t            or isinstance(regimes, (str, bytes))\n   790\t            or not isinstance(regimes, Sequence)\n   791\t        ):\n   792\t            return regimes\n   793\t\n   794\t        normalized: list[Any] = []\n   795\t        for regime in regimes:\n   796\t            if isinstance(regime, RegimeConfig):\n   797\t                updates = {\n   798\t                    field: annual_vol_to_monthly(float(value))\n   799\t                    for field in (\"sigma_H\", \"sigma_E\", \"sigma_M\")\n   800\t                    if (value := getattr(regime, field)) is not None\n   801\t                }\n   802\t                normalized.append(regime.model_copy(update=updates) if updates else regime)\n   803\t                continue\n   804\t\n   805\t            if isinstance(regime, Mapping):\n   806\t                regime_data = dict(regime)\n   807\t                for field in (\"sigma_H\", \"sigma_E\", \"sigma_M\"):\n   808\t                    value = regime_data.get(field)\n   809\t                    if value is not None:\n   810\t                        regime_data[field] = annual_vol_to_monthly(float(value))\n   811\t                normalized.append(regime_data)\n   812\t                continue\n   813\t\n   814\t            normalized.append(regime)\n   815\t        return normalized\n   816\t\n   817\t    @classmethod\n   818\t    def normalize_return_units(cls, data: Any) -> Any:\n   819\t        if not isinstance(data, dict):\n   820\t            return data\n   821\t        cls._trace_transform(data, \"normalize_return_units\")\n   822\t        updated, explicit_unit, legacy_fields = cls._apply_explicit_return_units(data)\n   823\t        unit = explicit_unit or updated.get(\"return_unit\", DEFAULT_RETURN_UNIT)\n   824\t        if explicit_unit and \"return_unit\" in updated and updated[\"return_unit\"] != explicit_unit:\n   825\t            raise ValueError(\n   826\t                \"return_unit conflicts with explicitly unit-tagged return inputs. \"\n   827\t                \"Align return_unit with the explicit mu/sigma unit or remove return_unit.\"\n   828\t            )\n   829\t        updated[\"return_unit_input\"] = unit\n   830\t        if \"return_unit\" not in updated:\n   831\t            updated[\"return_unit\"] = unit\n   832\t        if legacy_fields:\n   833\t            warning_fields = \", \".join(sorted(legacy_fields))\n   834\t            warnings.warn(\n   835\t                \"Ambiguous return inputs detected for legacy fields: \"\n   836\t                f\"{warning_fields}. Use explicit keys like mu_H_annual or mu_H_monthly. \"\n   837\t                \"Legacy field names will be deprecated.\",\n   838\t                DeprecationWarning,\n   839\t                stacklevel=2,\n   840\t            )\n   841\t        if unit == CANONICAL_RETURN_UNIT:\n   842\t            return updated\n   843\t        if unit != DEFAULT_RETURN_UNIT:\n   844\t            return updated\n   845\t\n   846\t        # Allow values to be supplied via field names or aliases.\n   847\t        def _get_value(field: str) -> tuple[Any, list[str]]:\n   848\t            field_info = cls.model_fields[field]\n   849\t            candidates = [field]\n   850\t            alias = getattr(field_info, \"alias\", None)\n   851\t            if alias:\n   852\t                candidates.append(alias)\n   853\t            for key in candidates:\n   854\t                if key in updated:\n   855\t                    return updated[key], candidates\n   856\t            return field_info.default, candidates\n   857\t\n   858\t        mean_method, _ = _get_value(\"mean_conversion\")\n   859\t        if mean_method not in (\"simple\", \"geometric\"):\n   860\t            # Leave the invalid value in place so the Literal field validator\n   861\t            # raises a clear error; fall back to the historical default here so\n   862\t            # the pre-validation conversion stays deterministic.\n   863\t            mean_method = DEFAULT_MEAN_CONVERSION\n   864\t        for field in (\"mu_H\", \"mu_E\", \"mu_M\"):\n   865\t            value, keys = _get_value(field)\n   866\t            converted = annual_mean_to_monthly(value, method=mean_method)\n   867\t            for key in keys:\n   868\t                updated[key] = converted\n   869\t        for field in (\"sigma_H\", \"sigma_E\", \"sigma_M\"):\n   870\t            value, keys = _get_value(field)\n   871\t            converted = annual_vol_to_monthly(value)\n   872\t            for key in keys:\n   873\t                updated[key] = converted\n   874\t        if \"regimes\" in updated:\n   875\t            updated[\"regimes\"] = cls._normalize_regime_sigma_overrides(updated[\"regimes\"])\n   876\t        updated[\"return_unit\"] = CANONICAL_RETURN_UNIT\n   877\t        return updated\n   878\t\n   879\t    @model_validator(mode=\"before\")\n   880\t    @classmethod\n   881\t    def apply_transform_pipeline(cls, data: Any) -> Any:\n   882\t        \"\"\"Apply transforms in order: parse -> normalize units (incl. shares) -> compile -> validate.\"\"\"\n   883\t        if not isinstance(data, dict):\n   884\t            return data\n   885\t        cls._trace_transform(data, \"parse_raw\")\n   886\t        for _, transform in cls._transform_pipeline():\n   887\t            data = transform(data)\n   888\t        return data\n   889\t\n   890\t    @staticmethod\n   891\t    def _normalize_agents(raw_agents: Any) -> list[dict[str, Any]]:\n   892\t        if raw_agents is None:\n   893\t            return []\n   894\t        if not isinstance(raw_agents, list):\n   895\t            raise ValueError(\"agents must be a list of mappings\")\n   896\t        normalized: list[dict[str, Any]] = []\n   897\t        for idx, agent in enumerate(raw_agents):\n   898\t            if isinstance(agent, AgentConfig):\n   899\t                agent_data = agent.model_dump()\n   900\t            elif isinstance(agent, Mapping):\n   901\t                agent_data = dict(agent)\n   902\t            else:\n   903\t                raise ValueError(f\"agents[{idx}] must be a mapping\")\n   904\t            missing = {\"name\", \"capital\", \"beta_share\", \"alpha_share\"} - agent_data.keys()\n   905\t            if missing:\n   906\t                raise ValueError(f\"agents[{idx}] missing keys: {sorted(missing)}\")\n   907\t            extra = agent_data.get(\"extra\") or {}\n   908\t            if not isinstance(extra, dict):\n   909\t                raise ValueError(f\"agents[{idx}].extra must be a mapping\")\n   910\t            beta_share = normalize_share(agent_data[\"beta_share\"])\n   911\t            alpha_share = normalize_share(agent_data[\"alpha_share\"])\n   912\t            normalized.append(\n   913\t                {\n   914\t                    \"name\": str(agent_data[\"name\"]),\n   915\t                    \"capital\": float(agent_data[\"capital\"]),\n   916\t                    \"beta_share\": 0.0 if beta_share is None else float(beta_share),\n   917\t                    \"alpha_share\": 0.0 if alpha_share is None else float(alpha_share),\n   918\t                    \"extra\": extra,\n   919\t                }\n   920\t            )\n   921\t        return normalized\n   922\t\n   923\t    @model_validator(mode=\"after\")\n   924\t    def check_financing_model(self) -> \"ModelConfig\":\n   925\t        self._trace_transform(self, \"check_financing_model\")\n--- sweeps config generate ---\n     1\tfrom __future__ import annotations\n     2\t\n     3\timport copy\n     4\timport hashlib\n     5\timport json\n     6\timport logging\n     7\tfrom collections import OrderedDict\n     8\tfrom dataclasses import dataclass\n     9\tfrom itertools import product\n    10\tfrom typing import Any, Callable, Dict, Iterator, List, Mapping, Sequence\n    11\t\n    12\timport numpy as np\n    13\timport pandas as pd\n    14\t\n    15\t# tqdm is optional; provide a no-op fallback wrapper to avoid hard dependency at import time\n    16\ttry:\n    17\t    from tqdm import tqdm as _tqdm\n    18\t\n    19\t    _HAS_TQDM = True\n    20\texcept ImportError:  # pragma: no cover - fallback when tqdm is unavailable\n    21\t    _HAS_TQDM = False\n    22\t\n    23\tfrom .agents.registry import build_from_config\n    24\tfrom .config import (\n    25\t    ModelConfig,\n    26\t    SweepConfig,\n    27\t    SweepParameter,\n    28\t    normalize_share,\n    29\t    validate_financing_spikes,\n    30\t)\n    31\tfrom .contracts import SUMMARY_NUMERIC_COLUMNS\n    32\tfrom .random import spawn_agent_rngs, spawn_rngs\n    33\tfrom .sim import (\n    34\t    draw_financing_series,\n    35\t    draw_joint_returns,\n    36\t    prepare_return_shocks,\n    37\t    resolve_internal_pa_financing_series,\n    38\t)\n    39\tfrom .sim.covariance import build_cov_matrix\n    40\tfrom .sim.metrics import summary_table\n    41\tfrom .sim.params import (\n    42\t    build_covariance_return_overrides,\n    43\t    build_financing_params,\n    44\t    build_params,\n    45\t    resolve_covariance_inputs,\n    46\t)\n    47\tfrom .sim.regimes import build_regime_draw_params, resolve_regime_start, simulate_regime_paths\n    48\tfrom .simulations import simulate_agents\n    49\tfrom .types import GeneratorLike, SweepResult\n    50\tfrom .units import (\n    51\t    convert_mean,\n    52\t    convert_volatility,\n    53\t    get_index_series_unit,\n    54\t    normalize_index_series,\n    55\t    normalize_return_inputs,\n    56\t)\n    57\tfrom .validators import select_vol_regime_sigma\n    58\t\n    59\t\n    60\tdef progress_bar(iterable: Any, total: int | None = None, desc: str | None = None) -> Any:\n    61\t    if _HAS_TQDM:\n    62\t        return _tqdm(iterable, total=total, desc=desc)\n    63\t    return iterable\n    64\t\n    65\t\n    66\tdef _count_range(start: float, stop: float, step: float) -> int:\n    67\t    values = np.arange(start, stop + step, step)\n    68\t    return int(len(values))\n    69\t\n    70\t\n    71\tdef _estimate_total_combinations(cfg: ModelConfig) -> int:\n    72\t    if cfg.sweep is not None:\n    73\t        if cfg.sweep.method == \"random\":\n    74\t            return int(cfg.sweep.samples or 0)\n    75\t        total = 1\n    76\t        for param in cfg.sweep.parameters.values():\n    77\t            if param.values is not None:\n    78\t                count = len(param.values)\n    79\t            else:\n    80\t                if param.min is None or param.max is None or param.step is None:\n    81\t                    raise ValueError(\n    82\t                        \"Sweep parameter requires 'min', 'max', and 'step' when 'values' is not set\"\n    83\t                    )\n    84\t                count = _count_range(float(param.min), float(param.max), float(param.step))\n    85\t            total *= count\n    86\t        return int(total)\n    87\t\n    88\t    if cfg.analysis_mode == \"capital\":\n    89\t        n = _count_range(\n    90\t            0.0, float(cfg.max_external_combined_pct), float(cfg.external_step_size_pct)\n    91\t        )\n    92\t        return int(n * (n + 1) / 2)\n    93\t    if cfg.analysis_mode == \"returns\":\n    94\t        return int(\n    95\t            _count_range(\n    96\t                float(cfg.in_house_return_min_pct),\n    97\t                float(cfg.in_house_return_max_pct),\n    98\t                float(cfg.in_house_return_step_pct),\n    99\t            )\n   100\t            * _count_range(\n   101\t                float(cfg.in_house_vol_min_pct),\n   102\t                float(cfg.in_house_vol_max_pct),\n   103\t                float(cfg.in_house_vol_step_pct),\n   104\t            )\n   105\t            * _count_range(\n   106\t                float(cfg.alpha_ext_return_min_pct),\n   107\t                float(cfg.alpha_ext_return_max_pct),\n   108\t                float(cfg.alpha_ext_return_step_pct),\n   109\t            )\n   110\t            * _count_range(\n   111\t                float(cfg.alpha_ext_vol_min_pct),\n   112\t                float(cfg.alpha_ext_vol_max_pct),\n   113\t                float(cfg.alpha_ext_vol_step_pct),\n   114\t            )\n   115\t        )\n   116\t    if cfg.analysis_mode == \"alpha_shares\":\n   117\t        return int(\n   118\t            _count_range(\n   119\t                float(cfg.external_pa_alpha_min_pct),\n   120\t                float(cfg.external_pa_alpha_max_pct),\n   121\t                float(cfg.external_pa_alpha_step_pct),\n   122\t            )\n   123\t            * _count_range(\n   124\t                float(cfg.active_share_min_pct),\n   125\t                float(cfg.active_share_max_pct),\n   126\t                float(cfg.active_share_step_pct),\n   127\t            )\n   128\t        )\n   129\t    if cfg.analysis_mode == \"vol_mult\":\n   130\t        return _count_range(\n   131\t            float(cfg.sd_multiple_min), float(cfg.sd_multiple_max), float(cfg.sd_multiple_step)\n   132\t        )\n   133\t    raise ValueError(f\"Unsupported analysis mode: {cfg.analysis_mode}\")\n   134\t\n   135\t\n   136\tdef _override_keys_for_config(cfg: ModelConfig) -> set[str]:\n   137\t    if cfg.sweep is not None:\n   138\t        return set(cfg.sweep.parameters.keys())\n   139\t    if cfg.analysis_mode == \"capital\":\n   140\t        return {\"external_pa_capital\", \"active_ext_capital\", \"internal_pa_capital\"}\n   141\t    if cfg.analysis_mode == \"returns\":\n   142\t        return {\"mu_H\", \"sigma_H\", \"mu_E\", \"sigma_E\"}\n   143\t    if cfg.analysis_mode == \"alpha_shares\":\n   144\t        return {\"theta_extpa\", \"active_share\"}\n   145\t    if cfg.analysis_mode == \"vol_mult\":\n   146\t        return {\"sigma_H\", \"sigma_E\", \"sigma_M\"}\n   147\t    return set()\n   148\t\n   149\t\n   150\tdef _iter_sweep_grid(sweep: SweepConfig) -> Iterator[Dict[str, Any]]:\n   151\t    names: List[str] = []\n   152\t    values: List[List[float]] = []\n   153\t    for name, param in sweep.parameters.items():\n   154\t        if param.values is not None:\n   155\t            param_values = list(param.values)\n   156\t        else:\n   157\t            if param.min is None or param.max is None or param.step is None:\n   158\t                raise ValueError(\n   159\t                    \"Sweep parameter requires 'min', 'max', and 'step' when 'values' is not set\"\n   160\t                )\n   161\t            param_values = list(np.arange(param.min, param.max + param.step, param.step))\n   162\t        names.append(name)\n   163\t        values.append(param_values)\n   164\t\n   165\t    for combo in product(*values):\n   166\t        yield dict(zip(names, combo))\n   167\t\n   168\t\n   169\tdef _sample_sweep_value(param: SweepParameter, rng: np.random.Generator) -> float:\n   170\t    if param.values is not None:\n   171\t        return float(rng.choice(param.values))\n   172\t    if param.step is not None:\n   173\t        if param.min is None or param.max is None:\n   174\t            raise ValueError(\"Sweep parameter requires 'min' and 'max' for stepped sampling\")\n   175\t        grid = np.arange(param.min, param.max + param.step, param.step)\n   176\t        return float(rng.choice(grid))\n   177\t    if param.min is None or param.max is None:\n   178\t        raise ValueError(\"Sweep parameter requires 'min' and 'max' for uniform sampling\")\n   179\t    return float(rng.uniform(param.min, param.max))\n   180\t\n   181\t\n   182\tdef _iter_sweep_random(sweep: SweepConfig) -> Iterator[Dict[str, Any]]:\n   183\t    rng = np.random.default_rng(sweep.seed)\n   184\t    for _ in range(sweep.samples or 0):\n   185\t        combo: Dict[str, Any] = {}\n   186\t        for name, param in sweep.parameters.items():\n   187\t            combo[name] = _sample_sweep_value(param, rng)\n   188\t        yield combo\n   189\t\n   190\t\n   191\tdef generate_parameter_combinations(cfg: ModelConfig) -> Iterator[Dict[str, Any]]:\n   192\t    \"\"\"Generate parameter combinations based on ``analysis_mode``.\"\"\"\n   193\t    if cfg.sweep is not None:\n   194\t        if cfg.sweep.method == \"grid\":\n   195\t            yield from _iter_sweep_grid(cfg.sweep)\n   196\t            return\n   197\t        yield from _iter_sweep_random(cfg.sweep)\n   198\t        return\n   199\t    if cfg.analysis_mode == \"capital\":\n   200\t        for ext_pct in np.arange(\n   201\t            0,\n   202\t            cfg.max_external_combined_pct + cfg.external_step_size_pct,\n   203\t            cfg.external_step_size_pct,\n   204\t        ):\n   205\t            for act_pct in np.arange(\n   206\t                0,\n   207\t                ext_pct + cfg.external_step_size_pct,\n   208\t                cfg.external_step_size_pct,\n   209\t            ):\n   210\t                ext_pa_pct = ext_pct - act_pct\n   211\t                internal_pct = 100 - ext_pct\n   212\t                yield {\n   213\t                    \"external_pa_capital\": (ext_pa_pct / 100) * cfg.total_fund_capital,\n   214\t                    \"active_ext_capital\": (act_pct / 100) * cfg.total_fund_capital,\n   215\t                    \"internal_pa_capital\": (internal_pct / 100) * cfg.total_fund_capital,\n   216\t                }\n   217\t    elif cfg.analysis_mode == \"returns\":\n   218\t        for mu_H in np.arange(\n   219\t            cfg.in_house_return_min_pct,\n   220\t            cfg.in_house_return_max_pct + cfg.in_house_return_step_pct,\n   221\t            cfg.in_house_return_step_pct,\n   222\t        ):\n   223\t            for sigma_H in np.arange(\n   224\t                cfg.in_house_vol_min_pct,\n   225\t                cfg.in_house_vol_max_pct + cfg.in_house_vol_step_pct,\n   226\t                cfg.in_house_vol_step_pct,\n   227\t            ):\n   228\t                for mu_E in np.arange(\n   229\t                    cfg.alpha_ext_return_min_pct,\n   230\t                    cfg.alpha_ext_return_max_pct + cfg.alpha_ext_return_step_pct,\n   231\t                    cfg.alpha_ext_return_step_pct,\n   232\t                ):\n   233\t                    for sigma_E in np.arange(\n   234\t                        cfg.alpha_ext_vol_min_pct,\n   235\t                        cfg.alpha_ext_vol_max_pct + cfg.alpha_ext_vol_step_pct,\n   236\t                        cfg.alpha_ext_vol_step_pct,\n   237\t                    ):\n   238\t                        mu_H_val = convert_mean(mu_H / 100.0, from_unit=\"annual\", to_unit=\"monthly\")\n   239\t                        sigma_H_val = convert_volatility(\n   240\t                            sigma_H / 100.0, from_unit=\"annual\", to_unit=\"monthly\"\n   241\t                        )\n   242\t                        mu_E_val = convert_mean(mu_E / 100.0, from_unit=\"annual\", to_unit=\"monthly\")\n   243\t                        sigma_E_val = convert_volatility(\n   244\t                            sigma_E / 100.0, from_unit=\"annual\", to_unit=\"monthly\"\n   245\t                        )\n   246\t                        yield {\n   247\t                            \"mu_H\": mu_H_val,\n   248\t                            \"sigma_H\": sigma_H_val,\n   249\t                            \"mu_E\": mu_E_val,\n   250\t                            \"sigma_E\": sigma_E_val,\n   251\t                        }\n   252\t    elif cfg.analysis_mode == \"alpha_shares\":\n   253\t        for theta_extpa in np.arange(\n   254\t            cfg.external_pa_alpha_min_pct,\n   255\t            cfg.external_pa_alpha_max_pct + cfg.external_pa_alpha_step_pct,\n   256\t            cfg.external_pa_alpha_step_pct,\n   257\t        ):\n   258\t            for active_share in np.arange(\n   259\t                cfg.active_share_min_pct,\n   260\t                cfg.active_share_max_pct + cfg.active_share_step_pct,\n   261\t                cfg.active_share_step_pct,\n   262\t            ):\n   263\t                yield {\n   264\t                    \"theta_extpa\": normalize_share(theta_extpa),\n   265\t                    \"active_share\": normalize_share(active_share),\n   266\t                }\n   267\t    elif cfg.analysis_mode == \"vol_mult\":\n   268\t        for sd_mult in np.arange(\n   269\t            cfg.sd_multiple_min,\n   270\t            cfg.sd_multiple_max + cfg.sd_multiple_step,\n   271\t            cfg.sd_multiple_step,\n   272\t        ):\n   273\t            yield {\n   274\t                \"sigma_H\": cfg.sigma_H * sd_mult,\n   275\t                \"sigma_E\": cfg.sigma_E * sd_mult,\n   276\t                \"sigma_M\": cfg.sigma_M * sd_mult,\n   277\t            }\n   278\t    else:\n   279\t        raise ValueError(f\"Unsupported analysis mode: {cfg.analysis_mode}\")\n   280\t\n   281\t\n   282\tlogger = logging.getLogger(__name__)\n   283\t\n   284\t\n   285\t@dataclass(slots=True)\n   286\tclass SweepRunner:\n   287\t    \"\"\"Execute parameter sweeps with a lightweight wrapper around sweep helpers.\"\"\"\n   288\t\n   289\t    config: ModelConfig\n   290\t    index_series: pd.Series | pd.DataFrame\n   291\t    seed: int | None = None\n   292\t    legacy_agent_rng: bool = False\n   293\t    progress: Callable[[int, int], None] | None = None\n   294\t    substream_ids: Mapping[str, str] | None = None\n   295\t\n   296\t    def iter_combinations(self) -> Iterator[Dict[str, Any]]:\n   297\t        return generate_parameter_combinations(self.config)\n   298\t\n   299\t    def run(self) -> List[SweepResult]:\n   300\t        from .sim.simulation_initialization import initialize_sweep_rngs\n   301\t\n   302\t        idx_series = self.index_series\n   303\t        if isinstance(idx_series, pd.DataFrame):\n   304\t            idx_series = idx_series.squeeze()\n   305\t        if not isinstance(idx_series, pd.Series):\n   306\t            try:\n   307\t                idx_series = pd.Series(idx_series)\n   308\t            except Exception as exc:\n   309\t                raise ValueError(\"Index data must be convertible to pandas Series\") from exc\n   310\t\n   311\t        rng_bundle = initialize_sweep_rngs(\n   312\t            self.seed,\n   313\t            legacy_agent_rng=self.legacy_agent_rng,\n   314\t        )\n   315\t        self.substream_ids = rng_bundle.substream_ids\n   316\t        return run_parameter_sweep(\n   317\t            self.config,\n   318\t            idx_series,\n   319\t            rng_bundle.rng_returns,\n   320\t            rng_bundle.rngs_financing,\n   321\t            seed=rng_bundle.seed,\n   322\t            rng_regime=rng_bundle.rng_regime,\n   323\t            progress=self.progress,\n   324\t        )\n   325\t\n   326\t\n   327\t\"\"\"Module-level cached empty DataFrame used for sweep results shape.\"\"\"\n   328\tEMPTY_RESULTS_COLUMNS: pd.Index = pd.Index(\n   329\t    [\n   330\t        \"Agent\",\n   331\t        \"terminal_AnnReturn\",\n   332\t        \"monthly_AnnVol\",\n   333\t        \"monthly_VaR\",\n   334\t        \"monthly_CVaR\",\n   335\t        \"terminal_CVaR\",\n   336\t        \"monthly_MaxDD\",\n   337\t        \"monthly_TimeUnderWater\",\n   338\t        \"monthly_BreachProb\",\n   339\t        \"monthly_BreachCountPath0\",\n   340\t        \"terminal_ShortfallProb\",\n   341\t        \"monthly_TE\",\n   342\t        \"combination_id\",\n   343\t    ],\n   344\t    dtype=\"object\",\n   345\t)\n   346\t_EMPTY_RESULTS_DF: pd.DataFrame = pd.DataFrame(columns=EMPTY_RESULTS_COLUMNS)\n   347\t\n   348\t\n   349\tdef _get_empty_results_dataframe() -> pd.DataFrame:\n   350\t    \"\"\"Return a copy of the cached empty DataFrame for sweep results.\"\"\"\n   351\t    return _EMPTY_RESULTS_DF.copy()\n   352\t\n   353\t\n   354\tdef _derive_regime_rng(rng_returns: GeneratorLike) -> GeneratorLike:\n   355\t    \"\"\"Derive a regime RNG deterministically from ``rng_returns``'s state.\n   356\t\n   357\t    Used when neither a master ``seed`` nor an explicit ``rng_regime`` is\n   358\t    supplied: the regime path generator is seeded from a stable hash of the\n   359\t    ``rng_returns`` bit-generator state so repeated runs with the same seeded\n   360\t    ``rng_returns`` reproduce identical regime paths, while remaining an\n   361\t    independent stream from the return draws.\n   362\t    \"\"\"\n   363\t    state_repr = json.dumps(rng_returns.bit_generator.state, sort_keys=True, default=str)\n   364\t    digest = hashlib.sha256((\"pa_core.regime:\" + state_repr).encode(\"utf-8\")).digest()\n   365\t    entropy = int.from_bytes(digest, \"big\")\n--- agents ---\n\n--- pa_core/agents/__init__.py ---\n     1\tfrom .active_ext import ActiveExtensionAgent\n     2\tfrom .base import BaseAgent\n     3\tfrom .external_pa import ExternalPAAgent\n     4\tfrom .internal_beta import InternalBetaAgent\n     5\tfrom .internal_pa import InternalPAAgent\n     6\tfrom .risk_metrics import RiskMetrics, RiskMetricsAgent\n     7\tfrom .types import Agent, AgentParams, Array\n     8\t\n     9\t__all__ = [\n    10\t    \"AgentParams\",\n    11\t    \"Agent\",\n    12\t    \"Array\",\n    13\t    \"BaseAgent\",\n    14\t    \"ExternalPAAgent\",\n    15\t    \"ActiveExtensionAgent\",\n    16\t    \"InternalBetaAgent\",\n    17\t    \"InternalPAAgent\",\n    18\t    \"RiskMetricsAgent\",\n    19\t    \"RiskMetrics\",\n    20\t]\n\n--- pa_core/agents/active_ext.py ---\n     1\tfrom __future__ import annotations\n     2\t\n     3\tfrom ..config import normalize_share\n     4\tfrom .types import Agent, Array\n     5\t\n     6\t\n     7\tclass ActiveExtensionAgent(Agent):\n     8\t    def monthly_returns(self, r_beta: Array, alpha_stream: Array, financing: Array) -> Array:\n     9\t        self._validate_inputs(r_beta, alpha_stream, financing)\n    10\t        active_share = normalize_share(self.extra.get(\"active_share\", 0.5))\n    11\t        if active_share is None:\n    12\t            active_share = 0.0\n    13\t        s = float(active_share)\n    14\t        # Transfer-coefficient diminishing returns (issue #1924). decay == 0 -> tc == 1\n    15\t        # -> the haircut and cost terms below are exactly 0.0, so the legacy linear\n    16\t        # formula is reproduced bit-for-bit. decay > 0 makes expected alpha concave in s\n    17\t        # (declining information ratio) while active risk still scales linearly.\n    18\t        decay = float(self.extra.get(\"tc_decay\", 0.0))\n    19\t        alpha_mu = float(self.extra.get(\"alpha_mu\", 0.0))\n    20\t        cost_per_share = float(self.extra.get(\"cost_per_share\", 0.0))\n    21\t        tc = 1.0 / (1.0 + decay * s)\n    22\t        weight = self.p.beta_share * s\n    23\t        return (\n    24\t            self.p.beta_share * (r_beta - financing)\n    25\t            + weight * alpha_stream\n    26\t            - weight * (1.0 - tc) * alpha_mu\n    27\t            - self.p.beta_share * (cost_per_share * s)\n    28\t        )\n\n--- pa_core/agents/base.py ---\n     1\tfrom __future__ import annotations\n     2\t\n     3\tfrom .types import Agent, Array\n     4\t\n     5\t\n     6\tclass BaseAgent(Agent):\n     7\t    def monthly_returns(self, r_beta: Array, alpha_stream: Array, financing: Array) -> Array:\n     8\t        self._validate_inputs(r_beta, alpha_stream, financing)\n     9\t        return self.p.beta_share * (r_beta - financing) + self.p.alpha_share * alpha_stream\n\n--- pa_core/agents/external_pa.py ---\n     1\tfrom __future__ import annotations\n     2\t\n     3\tfrom ..config import normalize_share\n     4\tfrom .types import Agent, Array\n     5\t\n     6\t\n     7\tclass ExternalPAAgent(Agent):\n     8\t    def monthly_returns(self, r_beta: Array, alpha_stream: Array, financing: Array) -> Array:\n     9\t        self._validate_inputs(r_beta, alpha_stream, financing)\n    10\t        theta = normalize_share(self.extra.get(\"theta_extpa\", 0.0))\n    11\t        if theta is None:\n    12\t            theta = 0.0\n    13\t        t = float(theta)\n    14\t        # Transfer-coefficient diminishing returns (issue #1924); decay == 0 reproduces\n    15\t        # the legacy linear formula bit-for-bit (haircut and cost terms are exactly 0.0).\n    16\t        decay = float(self.extra.get(\"tc_decay\", 0.0))\n    17\t        alpha_mu = float(self.extra.get(\"alpha_mu\", 0.0))\n    18\t        cost_per_share = float(self.extra.get(\"cost_per_share\", 0.0))\n    19\t        tc = 1.0 / (1.0 + decay * t)\n    20\t        weight = self.p.beta_share * t\n    21\t        return (\n    22\t            self.p.beta_share * (r_beta - financing)\n    23\t            + weight * alpha_stream\n    24\t            - weight * (1.0 - tc) * alpha_mu\n    25\t            - self.p.beta_share * (cost_per_share * t)\n    26\t        )\n\n--- pa_core/agents/internal_beta.py ---\n     1\tfrom __future__ import annotations\n     2\t\n     3\tfrom .types import Agent, Array\n     4\t\n     5\t\n     6\tclass InternalBetaAgent(Agent):\n     7\t    def monthly_returns(\n     8\t        self,\n     9\t        r_beta: Array,\n    10\t        alpha_stream: Array,\n    11\t        financing: Array,\n    12\t    ) -> Array:\n    13\t        \"\"\"Return margin sleeve returns with input validation.\"\"\"\n    14\t        self._validate_inputs(r_beta, alpha_stream, financing)\n    15\t        return self.p.beta_share * (r_beta - financing)\n\n--- pa_core/agents/internal_pa.py ---\n     1\tfrom __future__ import annotations\n     2\t\n     3\tfrom .types import Agent, Array\n     4\t\n     5\t\n     6\tclass InternalPAAgent(Agent):\n     7\t    def monthly_returns(\n     8\t        self,\n     9\t        r_beta: Array,\n    10\t        alpha_stream: Array,\n    11\t        financing: Array,\n    12\t    ) -> Array:\n    13\t        \"\"\"Return in-house alpha net of internal-PA financing cost.\n    14\t\n    15\t        ``financing`` is the internal-PA financing cost series (issue #1849):\n    16\t        a positive value is a cost that lowers the sleeve return, a negative\n    17\t        value is a benefit/positive carry that raises it. It is subtracted at\n    18\t        the sleeve level; total-portfolio scaling by the sleeve's capital share\n    19\t        is handled by the contribution machinery. When internal-PA financing is\n    20\t        disabled (the default), ``financing`` is all-zeros and the return is\n    21\t        pure in-house alpha, preserving historical behaviour.\n    22\t        \"\"\"\n    23\t        self._validate_inputs(r_beta, alpha_stream, financing)\n    24\t        return self.p.alpha_share * alpha_stream - financing\n\n--- pa_core/agents/registry.py ---\n     1\tfrom __future__ import annotations\n     2\t\n     3\tfrom importlib.metadata import entry_points\n     4\tfrom typing import Iterable, List, Type\n     5\t\n     6\tfrom ..config import ModelConfig\n     7\tfrom ..validators import calculate_margin_requirement\n     8\tfrom .active_ext import ActiveExtensionAgent\n     9\tfrom .base import BaseAgent\n    10\tfrom .external_pa import ExternalPAAgent\n    11\tfrom .internal_beta import InternalBetaAgent\n    12\tfrom .internal_pa import InternalPAAgent\n    13\tfrom .types import Agent, AgentParams\n    14\t\n    15\t_AGENT_MAP: dict[str, Type[Agent]] = {\n    16\t    \"Base\": BaseAgent,\n    17\t    \"ExternalPA\": ExternalPAAgent,\n    18\t    \"ActiveExt\": ActiveExtensionAgent,\n    19\t    \"InternalBeta\": InternalBetaAgent,\n    20\t    \"InternalPA\": InternalPAAgent,\n    21\t}\n    22\t\n    23\t\n    24\tdef register_agent(name: str, cls: Type[Agent]) -> None:\n    25\t    \"\"\"Register ``cls`` under ``name`` for agent construction.\"\"\"\n    26\t    if name in _AGENT_MAP:\n    27\t        raise KeyError(f\"Agent already registered: {name}\")\n    28\t    _AGENT_MAP[name] = cls\n    29\t\n    30\t\n    31\tdef load_plugins() -> None:\n    32\t    \"\"\"Load third-party agent plugins via entry points.\"\"\"\n    33\t    for ep in entry_points(group=\"pa_core.agents\"):\n    34\t        register_agent(ep.name, ep.load())\n    35\t\n    36\t\n    37\t# Load any agent plugins on import\n    38\tload_plugins()\n    39\t\n    40\t\n    41\tdef build_all(params_list: Iterable[AgentParams]) -> List[Agent]:\n    42\t    \"\"\"Instantiate agents from a list of AgentParams.\"\"\"\n    43\t    agents: List[Agent] = []\n    44\t    for p in params_list:\n    45\t        cls = _AGENT_MAP.get(p.name)\n    46\t        if cls is None:\n    47\t            raise KeyError(f\"Unknown agent name: {p.name}\")\n    48\t        agents.append(cls(p))\n    49\t    return agents\n    50\t\n    51\t\n    52\tdef build_from_config(cfg: ModelConfig) -> List[Agent]:\n    53\t    \"\"\"Instantiate agents based on ``ModelConfig`` values.\"\"\"\n    54\t    total_cap = cfg.total_fund_capital\n    55\t\n    56\t    params: list[AgentParams] = []\n    57\t    for agent in cfg.agents:\n    58\t        if isinstance(agent, dict):\n    59\t            name = agent[\"name\"]\n    60\t            capital = agent[\"capital\"]\n    61\t            beta_share = agent[\"beta_share\"]\n    62\t            alpha_share = agent[\"alpha_share\"]\n    63\t            extra = agent.get(\"extra\", {})\n    64\t        else:\n    65\t            name = agent.name\n    66\t            capital = agent.capital\n    67\t            beta_share = agent.beta_share\n    68\t            alpha_share = agent.alpha_share\n    69\t            extra = agent.extra\n    70\t        # Thread the (monthly) alpha mean and transfer-coefficient/cost controls into\n    71\t        # the sleeves whose alpha lever supports diminishing returns (issue #1924).\n    72\t        # cfg.mu_E / cfg.mu_M are already normalised to monthly by ModelConfig.\n    73\t        if name == \"ActiveExt\":\n    74\t            extra = {\n    75\t                **extra,\n    76\t                \"alpha_mu\": float(cfg.mu_E),\n    77\t                \"tc_decay\": float(cfg.active_share_tc_decay),\n    78\t                \"cost_per_share\": float(cfg.active_ext_cost_per_share),\n    79\t            }\n    80\t        elif name == \"ExternalPA\":\n    81\t            extra = {\n    82\t                **extra,\n    83\t                \"alpha_mu\": float(cfg.mu_M),\n    84\t                \"tc_decay\": float(cfg.theta_tc_decay),\n    85\t                \"cost_per_share\": float(cfg.ext_pa_cost_per_share),\n    86\t            }\n    87\t        params.append(\n    88\t            AgentParams(\n    89\t                name,\n    90\t                capital,\n    91\t                beta_share,\n    92\t                alpha_share,\n    93\t                extra,\n    94\t            )\n    95\t        )\n    96\t\n    97\t    margin_requirement = calculate_margin_requirement(\n    98\t        reference_sigma=cfg.reference_sigma,\n    99\t        volatility_multiple=cfg.volatility_multiple,\n   100\t        total_capital=total_cap,\n   101\t        financing_model=cfg.financing_model,\n   102\t        schedule_path=cfg.financing_schedule_path,\n   103\t        term_months=cfg.financing_term_months,\n   104\t    )\n   105\t    # InternalBeta here represents margin-backed capital, not attribution leftovers\n   106\t    # (see docs/UserGuide.md \"Sleeve Attribution Methodology\" for InternalBeta vs UnexplainedBeta).\n   107\t    if margin_requirement > 0 and not any(p.name == \"InternalBeta\" for p in params):\n   108\t        params.append(\n   109\t            AgentParams(\n   110\t                \"InternalBeta\",\n   111\t                margin_requirement,\n   112\t                margin_requirement / total_cap,\n   113\t                0.0,\n   114\t                {},\n   115\t            )\n   116\t        )\n   117\t\n   118\t    return build_all(params)\n\n--- pa_core/agents/risk_metrics.py ---\n     1\tfrom __future__ import annotations\n     2\t\n     3\tfrom dataclasses import dataclass\n     4\tfrom typing import TypeAlias\n     5\t\n     6\timport numpy as np\n     7\tfrom numpy.typing import NDArray\n     8\t\n     9\tfrom ..sim.metrics import (\n    10\t    breach_count_path0,\n    11\t    breach_probability,\n    12\t    compounded_return_below_zero_fraction,\n    13\t    cvar_monthly,\n    14\t    max_cumulative_sum_drawdown,\n    15\t)\n    16\tfrom ..units import DEFAULT_BREACH_THRESHOLD\n    17\t\n    18\tArray: TypeAlias = NDArray[np.float64]\n    19\t\n    20\t\n    21\t@dataclass\n    22\tclass RiskMetrics:\n    23\t    \"\"\"Container for monthly risk statistics derived from return paths.\n    24\t\n    25\t    All fields are monthly-draw metrics; ``monthly_breach_count_path0`` is a\n    26\t    path-0-only diagnostic count.\n    27\t    \"\"\"\n    28\t\n    29\t    monthly_cvar: float\n    30\t    monthly_max_cumulative_sum_drawdown: float\n    31\t    monthly_compounded_return_below_zero_fraction: float\n    32\t    monthly_breach_probability: float\n    33\t    monthly_breach_count_path0: int\n    34\t\n    35\t\n    36\tclass RiskMetricsAgent:\n    37\t    \"\"\"Compute monthly CVaR, drawdown, and breach metrics from return paths.\"\"\"\n    38\t\n    39\t    def __init__(\n    40\t        self, *, var_conf: float = 0.95, breach_threshold: float = DEFAULT_BREACH_THRESHOLD\n    41\t    ) -> None:\n    42\t        self.var_conf = var_conf\n    43\t        self.breach_threshold = breach_threshold\n    44\t\n    45\t    def run(self, returns: Array) -> RiskMetrics:\n    46\t        \"\"\"Return monthly risk metrics for the given return paths.\"\"\"\n    47\t\n    48\t        cvar = cvar_monthly(returns, confidence=self.var_conf)\n    49\t        mdd = max_cumulative_sum_drawdown(returns)\n    50\t        tuw = compounded_return_below_zero_fraction(returns)\n    51\t        bprob = breach_probability(returns, self.breach_threshold)\n    52\t        bcount = breach_count_path0(returns, self.breach_threshold)\n    53\t        return RiskMetrics(\n    54\t            monthly_cvar=cvar,\n    55\t            monthly_max_cumulative_sum_drawdown=mdd,\n    56\t            monthly_compounded_return_below_zero_fraction=tuw,\n    57\t            monthly_breach_probability=bprob,\n    58\t            monthly_breach_count_path0=bcount,\n    59\t        )\n\n--- pa_core/agents/types.py ---\n     1\tfrom __future__ import annotations\n     2\t\n     3\tfrom dataclasses import dataclass\n     4\tfrom typing import Any, Dict, TypeAlias\n     5\t\n     6\tfrom ..types import ArrayLike\n     7\t\n     8\t# Explicitly declare as a type alias for Pyright\n     9\tArray: TypeAlias = ArrayLike\n    10\t\n    11\t\n    12\t@dataclass\n    13\tclass AgentParams:\n    14\t    name: str\n    15\t    capital_mm: float\n    16\t    beta_share: float\n    17\t    alpha_share: float\n    18\t    extra_args: Dict[str, Any] | None = None\n    19\t\n    20\t\n    21\tclass Agent:\n    22\t    \"\"\"Abstract sleeve. Child classes implement ``monthly_returns``.\"\"\"\n    23\t\n    24\t    def __init__(self, p: AgentParams) -> None:\n    25\t        self.p = p\n    26\t        self.extra = p.extra_args or {}\n    27\t\n    28\t    def _validate_inputs(\n    29\t        self,\n    30\t        r_beta: Array,\n    31\t        alpha_stream: Array,\n    32\t        financing: Array,\n    33\t    ) -> None:\n    34\t        \"\"\"Validate that all arrays are 2D and share the same shape.\"\"\"\n    35\t        if r_beta.ndim != 2 or alpha_stream.ndim != 2 or financing.ndim != 2:\n    36\t            raise ValueError(\"inputs must be 2D (n_sim, n_months)\")\n    37\t        if r_beta.shape != alpha_stream.shape or r_beta.shape != financing.shape:\n    38\t            raise ValueError(\"shape mismatch\")\n    39\t\n    40\t    def monthly_returns(\n    41\t        self,\n    42\t        r_beta: Array,\n    43\t        alpha_stream: Array,\n    44\t        financing: Array,\n    45\t    ) -> Array:\n    46\t        raise NotImplementedError\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc 'repo=/Users/teacher/.codex/automations/research-program/clones/Portable-Alpha-Extension-Model\ncd \"$repo\"\nprintf '\"'%s\\\\n' '--- internal financing implementation ---'\nnl -ba pa_core/sim/internal_pa_financing.py\nprintf '%s\\\\n' '--- relevant sim tests --'\nrg -n -C 8 'internal_pa|InternalPA|financing' tests/test_simulations.py tests/test_agents.py tests/test_facade_run_single.py tests/test_facade_run_sweep.py tests/test_sweep_*.py | head -1000\nprintf '%s\\\\n' '--- config AgentConfig and validation tail ---'\nnl -ba pa_core/config.py | sed -n '60,175p'\nnl -ba pa_core/config.py | sed -n '1090,1195p'\nprintf '%s\\\\n' '--- metrics ---'\nnl -ba pa_core/sim/metrics.py\nprintf '%s\\\\n' '--- sim paths financing ---'\nnl -ba pa_core/sim/paths.py | sed -n '1,330p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc 'repo=/Users/teacher/.codex/automations/research-program/clones/Portable-Alpha-Extension-Model\ncd \"$repo\"\nprintf '\"'%s\\\\n' '--- internal financing implementation ---'\nnl -ba pa_core/sim/internal_pa_financing.py\nprintf '%s\\\\n' '--- relevant sim tests --'\nrg -n -C 8 'internal_pa|InternalPA|financing' tests/test_simulations.py tests/test_agents.py tests/test_facade_run_single.py tests/test_facade_run_sweep.py tests/test_sweep_*.py | head -1000\nprintf '%s\\\\n' '--- config AgentConfig and validation tail ---'\nnl -ba pa_core/config.py | sed -n '60,175p'\nnl -ba pa_core/config.py | sed -n '1090,1195p'\nprintf '%s\\\\n' '--- metrics ---'\nnl -ba pa_core/sim/metrics.py\nprintf '%s\\\\n' '--- sim paths financing ---'\nnl -ba pa_core/sim/paths.py | sed -n '1,330p'\"","aggregated_output":"--- internal financing implementation ---\n     1\t\"\"\"Internal-PA financing cost resolution.\n     2\t\n     3\tThe InternalPA sleeve funds an in-house alpha position. Holding that position\n     4\tcarries an internal financing cost that may be positive (a cost) or negative\n     5\t(a benefit / positive carry). This module turns the scenario configuration\n     6\tinto a monthly financing-cost matrix that the InternalPA agent subtracts from\n     7\tits sleeve return.\n     8\t\n     9\tUnlike :func:`pa_core.sim.financing.simulate_financing`, the values produced\n    10\there are **never clipped** to be non-negative: negative financing costs are a\n    11\tfirst-class, supported input (see issue #1849).\n    12\t\n    13\tResolution priority (highest first):\n    14\t\n    15\t1. ``series`` -- an explicit per-month cost list (negatives allowed).\n    16\t2. ``index`` -- a named built-in index futures/swap financing curve.\n    17\t3. ``mean_month`` -- a deterministic monthly cost, optionally perturbed by a\n    18\t   ``sigma_month`` stochastic draw.\n    19\t\n    20\tWhen none of these express a non-zero cost (the defaults), a zero matrix is\n    21\treturned so that runs with internal-PA financing disabled are bit-for-bit\n    22\tidentical to historical behaviour.\n    23\t\"\"\"\n    24\t\n    25\tfrom __future__ import annotations\n    26\t\n    27\tfrom typing import Any, Sequence, cast\n    28\t\n    29\timport numpy.typing as npt\n    30\t\n    31\tfrom ..backend import xp as np\n    32\tfrom ..data.index_financing_curves import get_index_financing_curve_monthly\n    33\tfrom ..random import spawn_rngs\n    34\tfrom ..types import GeneratorLike\n    35\t\n    36\t_FINANCING_MODES = (\"broadcast\", \"per_path\")\n    37\t\n    38\t\n    39\tdef resolve_internal_pa_financing_series(\n    40\t    *,\n    41\t    n_months: int,\n    42\t    n_sim: int,\n    43\t    mean_month: float = 0.0,\n    44\t    sigma_month: float = 0.0,\n    45\t    series: Sequence[float] | None = None,\n    46\t    index: str | None = None,\n    47\t    financing_mode: str = \"broadcast\",\n    48\t    rng: GeneratorLike | None = None,\n    49\t) -> npt.NDArray[Any]:\n    50\t    \"\"\"Return an ``(n_sim, n_months)`` internal-PA monthly financing matrix.\n    51\t\n    52\t    Negative costs are preserved. See module docstring for resolution order.\n    53\t    \"\"\"\n    54\t    if n_months <= 0:\n    55\t        raise ValueError(\"n_months must be positive\")\n    56\t    if n_sim <= 0:\n    57\t        raise ValueError(\"n_sim must be positive\")\n    58\t    if financing_mode not in _FINANCING_MODES:\n    59\t        raise ValueError(f\"financing_mode must be one of: {sorted(_FINANCING_MODES)}\")\n    60\t\n    61\t    # 1. Explicit per-month series.\n    62\t    if series is not None:\n    63\t        values = [float(v) for v in series]\n    64\t        if len(values) != n_months:\n    65\t            raise ValueError(\n    66\t                \"internal_pa_financing_series length \"\n    67\t                f\"({len(values)}) must equal n_months ({n_months})\"\n    68\t            )\n    69\t        row = np.asarray(values, dtype=float)\n    70\t        return cast(npt.NDArray[Any], np.broadcast_to(row, (n_sim, n_months)).copy())\n    71\t\n    72\t    # 2. Named index futures/swap financing curve.\n    73\t    if index is not None:\n    74\t        curve = get_index_financing_curve_monthly(index, n_months)\n    75\t        row = np.asarray(curve, dtype=float)\n    76\t        return cast(npt.NDArray[Any], np.broadcast_to(row, (n_sim, n_months)).copy())\n    77\t\n    78\t    # 3. Deterministic mean, optionally perturbed by a stochastic draw.\n    79\t    if sigma_month and sigma_month > 0.0:\n    80\t        if rng is None:\n    81\t            rng = spawn_rngs(None, 1)[0]\n    82\t        assert rng is not None\n    83\t        n_scenarios = 1 if financing_mode == \"broadcast\" else n_sim\n    84\t        draw = rng.normal(loc=mean_month, scale=sigma_month, size=(n_scenarios, n_months))\n    85\t        # No clip: negative financing costs are a supported input.\n    86\t        if n_scenarios == 1:\n    87\t            return cast(npt.NDArray[Any], np.broadcast_to(draw[0], (n_sim, n_months)).copy())\n    88\t        return cast(npt.NDArray[Any], draw)\n    89\t\n    90\t    # Deterministic constant (includes the all-defaults zero case).\n    91\t    return cast(npt.NDArray[Any], np.full((n_sim, n_months), float(mean_month), dtype=float))\n--- relevant sim tests --\ntests/test_agents.py-4-import pytest\ntests/test_agents.py-5-\ntests/test_agents.py-6-from pa_core.agents import (\ntests/test_agents.py-7-    ActiveExtensionAgent,\ntests/test_agents.py-8-    AgentParams,\ntests/test_agents.py-9-    BaseAgent,\ntests/test_agents.py-10-    ExternalPAAgent,\ntests/test_agents.py-11-    InternalBetaAgent,\ntests/test_agents.py:12:    InternalPAAgent,\ntests/test_agents.py-13-)\ntests/test_agents.py-14-from pa_core.agents.registry import build_all, build_from_config, register_agent\ntests/test_agents.py-15-from pa_co