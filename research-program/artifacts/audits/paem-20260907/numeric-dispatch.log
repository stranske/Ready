max_active,\n814-            min_internal=min_internal,\n815-            max_internal=max_internal,\n816-            seed=seed,\n817:            constraint_scope=constraint_scope,\n818-            objective=objective,\n819-            maxiter=optimizer_maxiter,\n820-            stream_cache=stream_cache,\n821-        )\n822-        if opt_df is not None:\n823:            meets = bool(opt_df.loc[0, \"constraints_satisfied\"])\n824-            if bool(opt_df.loc[0, \"optimizer_success\"]) and meets:\n825:                return opt_df.reset_index(drop=True)\n826-        grid_df = _grid_sleeve_sizes(\n827-            cfg,\n828-            idx_series,\n829-            max_te=max_te,\n830-            max_breach=max_breach,\n831-            max_cvar=max_cvar,\n832-            max_shortfall=max_shortfall,\n--\n836-            min_active=min_active,\n837-            max_active=max_active,\n838-            min_internal=min_internal,\n839-            max_internal=max_internal,\n840-            sort_by=\"objective_value\",\n841-            seed=seed,\n842-            max_evals=max_evals,\n843:            constraint_scope=constraint_scope,\n844-            objective=objective,\n845-            stream_cache=stream_cache,\n846-        )\n847-        if grid_df.empty:\n848-            if opt_df is None:\n849:                return pd.DataFrame()\n850-            opt_df[\"optimizer_status\"] = f\"fallback_failed:{status}\"\n851:            return opt_df.reset_index(drop=True)\n852-        grid_df = grid_df.copy()\n853-        grid_df[\"optimizer_status\"] = f\"grid_fallback:{status}\"\n854-        grid_df[\"optimizer_success\"] = False\n855:        grid_df[\"constraints_satisfied\"] = True\n856-        grid_df[\"objective\"] = objective\n857:        return grid_df.reset_index(drop=True)\n858-\n859:    return _grid_sleeve_sizes(\n860-        cfg,\n861-        idx_series,\n862-        max_te=max_te,\n863-        max_breach=max_breach,\n864-        max_cvar=max_cvar,\n865-        max_shortfall=max_shortfall,\n866-        step=step,\n--\n869-        min_active=min_active,\n870-        max_active=max_active,\n871-        min_internal=min_internal,\n872-        max_internal=max_internal,\n873-        sort_by=sort_by,\n874-        seed=seed,\n875-        max_evals=max_evals,\n876:        constraint_scope=constraint_scope,\n877-        objective=None,\n878-        stream_cache=stream_cache,\n879-    )\n880-\n881-\n882-def _metric_key(agent: str, metric: MetricName) -> str:\n883-    suffix = _METRIC_SUFFIXES[metric]\n884:    return f\"{agent}_{suffix}\"\n885-\n886-\n887:def _metric_value(metrics: dict[str, float], agent: str, metric: MetricName) -> float | None:\n888:    value = metrics.get(_metric_key(agent, metric))\n889-    if value is None:\n890:        return None\n891:    return float(value)\n892-\n893-\n894:def _constraint_agents(scope: ConstraintScope) -> tuple[str, ...]:\n895-    if scope == \"total\":\n896:        return (\"Total\",)\n897-    if scope == \"both\":\n898:        return (\"Total\",) + SLEEVE_AGENTS\n899:    return SLEEVE_AGENTS\n900-\n901-\n902:def _evaluate_problem_constraints(\n903:    metrics: dict[str, float],\n904-    problem: MultiObjectiveProblem,\n905-) -> tuple[bool, int]:\n906-    breaches = 0\n907-    ok = True\n908:    for constraint in problem.constraints:\n909:        for agent in _constraint_agents(constraint.scope):\n910:            value = _metric_value(metrics, agent, constraint.metric)\n911-            if value is None:\n912-                breaches += 1\n913-                ok = False\n914-                continue\n915:            metric_val = abs(value) if constraint.absolute else value\n916:            if metric_val > constraint.limit:\n917-                breaches += 1\n918-                ok = False\n919:    return ok, breaches\n920-\n921-\n922-def _select_frontier_indices(\n923-    df: pd.DataFrame,\n924-    *,\n925-    return_col: str,\n926-    risk_col: str,\n927-    min_points: int,\n928-) -> list[int]:\n929-    if min_points <= 0:\n930:        return []\n931:    feasible = df[df[\"constraints_satisfied\"]].dropna(subset=[return_col, risk_col])\n932-    if feasible.empty:\n933:        return []\n934-    if len(feasible) <= min_points:\n935:        return list(feasible.index)\n936-    risk_min = float(feasible[risk_col].min())\n937-    risk_max = float(feasible[risk_col].max())\n938-    picks: list[int] = []\n939-    if risk_min == risk_max:\n940-        top = feasible.sort_values(return_col, ascending=False)\n941:        return list(top.head(min_points).index)\n942-    bins = np.linspace(risk_min, risk_max, min_points + 1)\n943-    for i in range(min_points):\n944-        lower = bins[i]\n945-        upper = bins[i + 1]\n946-        in_bin = feasible[(feasible[risk_col] >= lower) & (feasible[risk_col] <= upper)]\n947-        if picks:\n948-            in_bin = in_bin.drop(index=picks, errors=\"ignore\")\n--\n951-        best = in_bin.sort_values(return_col, ascending=False).iloc[0]\n952-        picks.append(int(best.name))\n953-    if len(picks) < min_points:\n954-        remaining = feasible.drop(index=picks, errors=\"ignore\").sort_values(\n955-            return_col, ascending=False\n956-        )\n957-        picks.extend([int(idx) for idx in remaining.head(min_points - len(picks)).index])\n958:    return picks\n959-\n960-\n961-def generate_sleeve_frontier(\n962-    cfg: ModelConfig,\n963-    idx_series: pd.Series,\n964-    *,\n965-    max_te: float,\n--\n971-    max_external: float | None = None,\n972-    min_active: float | None = None,\n973-    max_active: float | None = None,\n974-    min_internal: float | None = None,\n975-    max_internal: float | None = None,\n976-    seed: int | None = None,\n977-    max_evals: int | None = 800,\n978:    constraint_scope: Literal[\"sleeves\", \"total\", \"both\"] = \"sleeves\",\n979-    return_metric: MetricName = \"AnnReturn\",\n980-    risk_metric: MetricName = \"TE\",\n981-    min_frontier_points: int = 20,\n982-) -> pd.DataFrame:\n983-    \"\"\"Evaluate sleeve allocations and mark efficient-frontier points.\"\"\"\n984-    if risk_metric != \"TE\":\n985-        raise ValueError(\"risk_metric must be TE for sleeve frontier generation\")\n--\n987-        raise ValueError(\"max_evals must be non-negative\")\n988-    problem = build_sleeve_multi_objective_problem(\n989-        return_metric=return_metric,\n990-        max_te=max_te,\n991-        max_breach=max_breach,\n992-        max_cvar=max_cvar,\n993-        max_shortfall=max_shortfall,\n994:        constraint_scope=constraint_scope,\n995-    )\n996-    if step <= 0:\n997-        raise ValueError(\"step must be positive\")\n998-\n999:    total = cfg.total_fund_capital\n1000-    step_size = total * step\n1001-    grid = np.arange(0.0, total + 1e-9, step_size)\n1002-    ext_grid = _clamp_grid(grid, min_external, max_external)\n1003-    act_grid = _clamp_grid(grid, min_active, max_active)\n1004-    if ext_grid.size == 0 or act_grid.size == 0:\n1005:        return pd.DataFrame()\n1006-\n1007-    combos: list[tuple[float, float]] | None = None\n1008-    if max_evals is not None:\n1009-        ext_vals = np.asarray(ext_grid, dtype=float)\n1010-        act_vals = np.asarray(act_grid, dtype=float)\n1011-        max_valid = _count_valid_combos(ext_vals, act_vals, total)\n1012-        if max_valid <= max_evals:\n--\n1093-            ext_cap=ext_cap,\n1094-            act_cap=act_cap,\n1095-            int_cap=int_cap,\n1096-            max_te=max_te,\n1097-            max_breach=max_breach,\n1098-            max_cvar=max_cvar,\n1099-            max_shortfall=max_shortfall,\n1100:            constraint_scope=constraint_scope,\n1101-            seed=seed,\n1102-            stream_cache=stream_cache,\n1103-            include_returns=True,\n1104-        )\n1105-        if evaluated is None:\n1106-            return\n1107:        metrics, _meets, _ = evaluated\n1108:        constraints_ok, breaches = _evaluate_problem_constraints(metrics, problem)\n1109-        record = {\n1110:            \"external_pa_capital\": float(ext_cap),\n1111:            \"active_ext_capital\": float(act_cap),\n1112:            \"internal_pa_capital\": float(int_cap),\n1113:            \"constraints_satisfied\": bool(constraints_ok),\n1114:            \"constraint_breaches\": int(breaches),\n1115-        }\n1116:        record.update(metrics)\n1117:        total_return = _metric_value(metrics, \"Total\", return_metric)\n1118:        total_te = _metric_value(metrics, \"Total\", risk_metric)\n1119:        total_cvar = _metric_value(metrics, \"Total\", \"CVaR\")\n1120:        if total_return is not None:\n1121-            record[\"frontier_return\"] = float(total_return)\n1122-        if total_te is not None:\n1123-            record[\"frontier_risk\"] = float(total_te)\n1124-        if total_cvar is not None:\n1125-            record[\"frontier_cvar\"] = float(abs(total_cvar))\n1126-        records.append(record)\n1127-\n--\n1136-                _maybe_record(float(ext_cap), float(act_cap))\n1137-    else:\n1138-        for ext_cap, act_cap in combos:\n1139-            _maybe_record(ext_cap, act_cap)\n1140-\n1141-    df = pd.DataFrame.from_records(records)\n1142-    if df.empty:\n1143:        return df\n1144-\n1145-    return_col = \"frontier_return\"\n1146-    risk_col = \"frontier_risk\"\n1147-    if return_col not in df.columns or risk_col not in df.columns:\n1148-        df[\"is_frontier\"] = False\n1149:        return df\n1150-\n1151-    picks = _select_frontier_indices(\n1152-        df,\n1153-        return_col=return_col,\n1154-        risk_col=risk_col,\n1155-        min_points=min_frontier_points,\n1156-    )\n1157-    df[\"is_frontier\"] = False\n1158-    if picks:\n1159-        df.loc[picks, \"is_frontier\"] = True\n1160:    return df\n--- suggestor first 800 ---\n     1\tfrom __future__ import annotations\n     2\t\n     3\tfrom collections.abc import Callable\n     4\tfrom numbers import Real\n     5\tfrom typing import Iterable, Literal, Protocol, Sequence, cast\n     6\t\n     7\timport numpy as np\n     8\timport pandas as pd\n     9\t\n    10\tfrom .agents.registry import build_from_config\n    11\tfrom .config import ModelConfig\n    12\tfrom .multi_objective import (\n    13\t    ConstraintScope,\n    14\t    MetricName,\n    15\t    MultiObjectiveProblem,\n    16\t    build_sleeve_multi_objective_problem,\n    17\t)\n    18\tfrom .orchestrator import SimulatorOrchestrator\n    19\tfrom .sim.metrics import summary_table\n    20\tfrom .simulations import simulate_agents\n    21\t\n    22\tSLEEVE_AGENTS = (\"ExternalPA\", \"ActiveExt\", \"InternalPA\")\n    23\tSUPPORTED_OBJECTIVES = (\"total_return\", \"excess_return\")\n    24\t_StreamTuple = tuple[\n    25\t    np.ndarray, np.ndarray, np.ndarray, np.ndarray, np.ndarray, np.ndarray, np.ndarray\n    26\t]\n    27\t\n    28\t\n    29\tclass _StreamCache:\n    30\t    def __init__(self, cfg: ModelConfig, idx_series: pd.Series, seed: int | None) -> None:\n    31\t        self._cfg = cfg\n    32\t        self._idx_series = idx_series\n    33\t        self._seed = seed\n    34\t        self._streams: _StreamTuple | None = None\n    35\t        self._probed = False\n    36\t\n    37\t    def get(self) -> _StreamTuple | None:\n    38\t        if not self._probed:\n    39\t            orch = SimulatorOrchestrator(self._cfg, self._idx_series)\n    40\t            draw_streams = getattr(orch, \"draw_streams\", None)\n    41\t            if draw_streams is not None:\n    42\t                self._streams = draw_streams(seed=self._seed)\n    43\t            self._probed = True\n    44\t        return self._streams\n    45\t\n    46\t\n    47\tclass _MinimizeResult(Protocol):\n    48\t    x: np.ndarray\n    49\t    success: bool\n    50\t    message: object\n    51\t\n    52\t\n    53\t_MinimizeFunc = Callable[..., _MinimizeResult]\n    54\t_METRIC_SUFFIXES: dict[MetricName, str] = {\n    55\t    \"AnnReturn\": \"terminal_AnnReturn\",\n    56\t    \"ExcessReturn\": \"terminal_ExcessReturn\",\n    57\t    \"TE\": \"monthly_TE\",\n    58\t    \"BreachProb\": \"monthly_BreachProb\",\n    59\t    \"CVaR\": \"monthly_CVaR\",\n    60\t    \"ShortfallProb\": \"terminal_ShortfallProb\",\n    61\t}\n    62\t\n    63\t\n    64\tdef _clamp_grid(grid: np.ndarray, min_value: float | None, max_value: float | None) -> np.ndarray:\n    65\t    min_val = 0.0 if min_value is None else min_value\n    66\t    max_val = float(\"inf\") if max_value is None else max_value\n    67\t    return grid[(grid >= min_val) & (grid <= max_val)]\n    68\t\n    69\t\n    70\tdef _internal_cap_ok(value: float, min_internal: float | None, max_internal: float | None) -> bool:\n    71\t    if min_internal is not None and value < min_internal:\n    72\t        return False\n    73\t    if max_internal is not None and value > max_internal:\n    74\t        return False\n    75\t    return True\n    76\t\n    77\t\n    78\tdef _pick_priority_combos(\n    79\t    ext_grid: Iterable[float],\n    80\t    act_grid: Iterable[float],\n    81\t    total: float,\n    82\t    min_internal: float | None,\n    83\t    max_internal: float | None,\n    84\t) -> list[tuple[float, float]]:\n    85\t    ext_vals = sorted(set(ext_grid))\n    86\t    act_vals = sorted(set(act_grid))\n    87\t    if not ext_vals or not act_vals:\n    88\t        return []\n    89\t\n    90\t    candidates = [\n    91\t        (ext_vals[0], act_vals[0]),\n    92\t        (ext_vals[0], act_vals[-1]),\n    93\t        (ext_vals[-1], act_vals[0]),\n    94\t        (ext_vals[-1], act_vals[-1]),\n    95\t    ]\n    96\t\n    97\t    target = total / 3\n    98\t    ext_mid = min(ext_vals, key=lambda v: abs(v - target))\n    99\t    act_mid = min(act_vals, key=lambda v: abs(v - target))\n   100\t    candidates.append((ext_mid, act_mid))\n   101\t\n   102\t    picked: list[tuple[float, float]] = []\n   103\t    for ext_cap, act_cap in candidates:\n   104\t        int_cap = total - ext_cap - act_cap\n   105\t        if int_cap < 0:\n   106\t            continue\n   107\t        if not _internal_cap_ok(int_cap, min_internal, max_internal):\n   108\t            continue\n   109\t        if (ext_cap, act_cap) not in picked:\n   110\t            picked.append((ext_cap, act_cap))\n   111\t    return picked\n   112\t\n   113\t\n   114\tdef _count_valid_combos(ext_vals: np.ndarray, act_vals: np.ndarray, total: float) -> int:\n   115\t    if ext_vals.size == 0 or act_vals.size == 0:\n   116\t        return 0\n   117\t    count = 0\n   118\t    min_act = float(act_vals[0])\n   119\t    for ext in ext_vals:\n   120\t        max_act = total - float(ext)\n   121\t        if max_act < min_act:\n   122\t            continue\n   123\t        idx = int(np.searchsorted(act_vals, max_act, side=\"right\"))\n   124\t        count += idx\n   125\t    return count\n   126\t\n   127\t\n   128\tdef _coerce_metric(value: object) -> float | None:\n   129\t    if value is None:\n   130\t        return None\n   131\t    if isinstance(value, (str, bytes, bytearray)):\n   132\t        try:\n   133\t            metric = float(value)\n   134\t        except ValueError:\n   135\t            return None\n   136\t    elif isinstance(value, (Real, np.floating, np.integer)):\n   137\t        metric = float(value)\n   138\t    else:\n   139\t        return None\n   140\t    if not np.isfinite(metric):\n   141\t        return None\n   142\t    return metric\n   143\t\n   144\t\n   145\tdef _objective_from_summary(summary: pd.DataFrame, objective: str) -> float | None:\n   146\t    if objective not in SUPPORTED_OBJECTIVES:\n   147\t        raise ValueError(f\"objective must be one of: {', '.join(SUPPORTED_OBJECTIVES)}\")\n   148\t    column = \"terminal_AnnReturn\" if objective == \"total_return\" else \"terminal_ExcessReturn\"\n   149\t    total_row = summary[summary[\"Agent\"] == \"Total\"]\n   150\t    if not total_row.empty:\n   151\t        return _coerce_metric(total_row.iloc[0][column])\n   152\t    values = []\n   153\t    for agent in SLEEVE_AGENTS:\n   154\t        sub = summary[summary[\"Agent\"] == agent]\n   155\t        if sub.empty:\n   156\t            continue\n   157\t        val = _coerce_metric(sub.iloc[0][column])\n   158\t        if val is not None:\n   159\t            values.append(val)\n   160\t    if not values:\n   161\t        return None\n   162\t    return float(sum(values))\n   163\t\n   164\t\n   165\tdef _risk_score(metrics: dict[str, float], constraint_scope: str) -> float:\n   166\t    score = 0.0\n   167\t    if constraint_scope in {\"sleeves\", \"both\"}:\n   168\t        for ag in SLEEVE_AGENTS:\n   169\t            score += metrics.get(f\"{ag}_monthly_TE\", 0.0)\n   170\t            score += metrics.get(f\"{ag}_monthly_BreachProb\", 0.0)\n   171\t            score += abs(metrics.get(f\"{ag}_monthly_CVaR\", 0.0))\n   172\t            score += metrics.get(f\"{ag}_terminal_ShortfallProb\", 0.0)\n   173\t    if constraint_scope in {\"total\", \"both\"}:\n   174\t        score += metrics.get(\"Total_monthly_TE\", 0.0)\n   175\t        score += metrics.get(\"Total_monthly_BreachProb\", 0.0)\n   176\t        score += abs(metrics.get(\"Total_monthly_CVaR\", 0.0))\n   177\t        score += metrics.get(\"Total_terminal_ShortfallProb\", 0.0)\n   178\t    return score\n   179\t\n   180\t\n   181\tdef _extract_metrics(\n   182\t    summary: pd.DataFrame,\n   183\t    *,\n   184\t    max_te: float,\n   185\t    max_breach: float,\n   186\t    max_cvar: float,\n   187\t    max_shortfall: float,\n   188\t    constraint_scope: Literal[\"sleeves\", \"total\", \"both\"],\n   189\t    include_returns: bool = False,\n   190\t) -> tuple[dict[str, float], bool] | None:\n   191\t    meets = True\n   192\t    metrics: dict[str, float] = {}\n   193\t    for agent in SLEEVE_AGENTS:\n   194\t        sub = summary[summary[\"Agent\"] == agent]\n   195\t        if sub.empty:\n   196\t            continue\n   197\t        row = sub.iloc[0]\n   198\t        te = _coerce_metric(row[\"monthly_TE\"])\n   199\t        bprob = _coerce_metric(row[\"monthly_BreachProb\"])\n   200\t        cvar = _coerce_metric(row[\"monthly_CVaR\"])\n   201\t        shortfall = _coerce_metric(row[\"terminal_ShortfallProb\"])\n   202\t        if te is None or bprob is None or cvar is None or shortfall is None:\n   203\t            return None\n   204\t        ann_return = _coerce_metric(row[\"terminal_AnnReturn\"]) if include_returns else None\n   205\t        excess_return = _coerce_metric(row[\"terminal_ExcessReturn\"]) if include_returns else None\n   206\t        if include_returns and (ann_return is None or excess_return is None):\n   207\t            return None\n   208\t        metrics[f\"{agent}_monthly_TE\"] = float(te)\n   209\t        metrics[f\"{agent}_monthly_BreachProb\"] = float(bprob)\n   210\t        metrics[f\"{agent}_monthly_CVaR\"] = float(cvar)\n   211\t        metrics[f\"{agent}_terminal_ShortfallProb\"] = float(shortfall)\n   212\t        if include_returns:\n   213\t            assert ann_return is not None\n   214\t            metrics[f\"{agent}_terminal_AnnReturn\"] = float(ann_return)\n   215\t            assert excess_return is not None\n   216\t            metrics[f\"{agent}_terminal_ExcessReturn\"] = float(excess_return)\n   217\t        if constraint_scope in {\"sleeves\", \"both\"} and (\n   218\t            te > max_te or bprob > max_breach or abs(cvar) > max_cvar or shortfall > max_shortfall\n   219\t        ):\n   220\t            meets = False\n   221\t\n   222\t    total_row = summary[summary[\"Agent\"] == \"Total\"]\n   223\t    if total_row.empty and constraint_scope in {\"total\", \"both\"}:\n   224\t        return None\n   225\t    if not total_row.empty:\n   226\t        total_row = total_row.iloc[0]\n   227\t        total_te = _coerce_metric(total_row[\"monthly_TE\"])\n   228\t        total_bprob = _coerce_metric(total_row[\"monthly_BreachProb\"])\n   229\t        total_cvar = _coerce_metric(total_row[\"monthly_CVaR\"])\n   230\t        total_shortfall = _coerce_metric(total_row[\"terminal_ShortfallProb\"])\n   231\t        if total_te is None or total_bprob is None or total_cvar is None or total_shortfall is None:\n   232\t            return None\n   233\t        total_ann_return = (\n   234\t            _coerce_metric(total_row[\"terminal_AnnReturn\"]) if include_returns else None\n   235\t        )\n   236\t        total_excess_return = (\n   237\t            _coerce_metric(total_row[\"terminal_ExcessReturn\"]) if include_returns else None\n   238\t        )\n   239\t        if include_returns and (total_ann_return is None or total_excess_return is None):\n   240\t            return None\n   241\t        metrics.update(\n   242\t            {\n   243\t                \"Total_monthly_TE\": float(total_te),\n   244\t                \"Total_monthly_BreachProb\": float(total_bprob),\n   245\t                \"Total_monthly_CVaR\": float(total_cvar),\n   246\t                \"Total_terminal_ShortfallProb\": float(total_shortfall),\n   247\t            }\n   248\t        )\n   249\t        if include_returns:\n   250\t            assert total_ann_return is not None\n   251\t            metrics[\"Total_terminal_AnnReturn\"] = float(total_ann_return)\n   252\t            assert total_excess_return is not None\n   253\t            metrics[\"Total_terminal_ExcessReturn\"] = float(total_excess_return)\n   254\t        if constraint_scope in {\"total\", \"both\"} and (\n   255\t            total_te > max_te\n   256\t            or total_bprob > max_breach\n   257\t            or abs(total_cvar) > max_cvar\n   258\t            or total_shortfall > max_shortfall\n   259\t        ):\n   260\t            meets = False\n   261\t    return metrics, meets\n   262\t\n   263\t\n   264\tdef _evaluate_allocation(\n   265\t    cfg: ModelConfig,\n   266\t    idx_series: pd.Series,\n   267\t    *,\n   268\t    ext_cap: float,\n   269\t    act_cap: float,\n   270\t    int_cap: float,\n   271\t    max_te: float,\n   272\t    max_breach: float,\n   273\t    max_cvar: float,\n   274\t    max_shortfall: float,\n   275\t    constraint_scope: Literal[\"sleeves\", \"total\", \"both\"],\n   276\t    seed: int | None,\n   277\t    objective: str | None = None,\n   278\t    stream_cache: _StreamCache | None = None,\n   279\t    include_returns: bool = False,\n   280\t) -> tuple[dict[str, float], bool, float | None] | None:\n   281\t    test_cfg = cfg.model_copy(\n   282\t        update={\n   283\t            \"external_pa_capital\": float(ext_cap),\n   284\t            \"active_ext_capital\": float(act_cap),\n   285\t            \"internal_pa_capital\": float(int_cap),\n   286\t        }\n   287\t    )\n   288\t    if stream_cache is None:\n   289\t        streams = None\n   290\t    else:\n   291\t        streams = stream_cache.get()\n   292\t    if streams is None:\n   293\t        orch = SimulatorOrchestrator(test_cfg, idx_series)\n   294\t        _, summary = orch.run(seed=seed)\n   295\t    else:\n   296\t        agents = build_from_config(test_cfg)\n   297\t        returns = simulate_agents(agents, *streams)\n   298\t        summary = summary_table(returns, benchmark=\"Base\")\n   299\t    result = _extract_metrics(\n   300\t        summary,\n   301\t        max_te=max_te,\n   302\t        max_breach=max_breach,\n   303\t        max_cvar=max_cvar,\n   304\t        max_shortfall=max_shortfall,\n   305\t        constraint_scope=constraint_scope,\n   306\t        include_returns=include_returns,\n   307\t    )\n   308\t    if result is None:\n   309\t        return None\n   310\t    metrics, meets = result\n   311\t    objective_value = None\n   312\t    if objective is not None:\n   313\t        objective_value = _objective_from_summary(summary, objective)\n   314\t    return metrics, meets, objective_value\n   315\t\n   316\t\n   317\tdef _grid_sleeve_sizes(\n   318\t    cfg: ModelConfig,\n   319\t    idx_series: pd.Series,\n   320\t    *,\n   321\t    max_te: float,\n   322\t    max_breach: float,\n   323\t    max_cvar: float,\n   324\t    max_shortfall: float,\n   325\t    step: float,\n   326\t    min_external: float | None,\n   327\t    max_external: float | None,\n   328\t    min_active: float | None,\n   329\t    max_active: float | None,\n   330\t    min_internal: float | None,\n   331\t    max_internal: float | None,\n   332\t    sort_by: str,\n   333\t    seed: int | None,\n   334\t    max_evals: int | None,\n   335\t    constraint_scope: Literal[\"sleeves\", \"total\", \"both\"],\n   336\t    objective: str | None = None,\n   337\t    stream_cache: _StreamCache | None = None,\n   338\t) -> pd.DataFrame:\n   339\t    if step <= 0:\n   340\t        raise ValueError(\"step must be positive\")\n   341\t\n   342\t    total = cfg.total_fund_capital\n   343\t    step_size = total * step\n   344\t    grid = np.arange(0.0, total + 1e-9, step_size)\n   345\t    ext_grid = _clamp_grid(grid, min_external, max_external)\n   346\t    act_grid = _clamp_grid(grid, min_active, max_active)\n   347\t\n   348\t    if ext_grid.size == 0 or act_grid.size == 0:\n   349\t        return pd.DataFrame()\n   350\t\n   351\t    combos: list[tuple[float, float]] | None = None\n   352\t    if max_evals is not None:\n   353\t        ext_vals = np.asarray(ext_grid, dtype=float)\n   354\t        act_vals = np.asarray(act_grid, dtype=float)\n   355\t        max_valid = _count_valid_combos(ext_vals, act_vals, total)\n   356\t        if max_valid <= max_evals:\n   357\t            combos = []\n   358\t            for ext_cap in ext_vals:\n   359\t                max_act = total - float(ext_cap)\n   360\t                if max_act < act_vals[0]:\n   361\t                    continue\n   362\t                idx = int(np.searchsorted(act_vals, max_act, side=\"right\"))\n   363\t                for act_cap in act_vals[:idx]:\n   364\t                    combos.append((float(ext_cap), float(act_cap)))\n   365\t        else:\n   366\t            rng = np.random.default_rng(seed)\n   367\t            priority = _pick_priority_combos(\n   368\t                ext_vals,\n   369\t                act_vals,\n   370\t                total,\n   371\t                min_internal,\n   372\t                max_internal,\n   373\t            )\n   374\t            if max_evals <= len(priority):\n   375\t                combos = list(priority[:max_evals])\n   376\t                seen = set(combos)\n   377\t            else:\n   378\t                combos = list(priority)\n   379\t                seen = set(combos)\n   380\t            attempts = 0\n   381\t            max_attempts = max(1, max_evals) * 50\n   382\t            while len(combos) < max_evals and attempts < max_attempts:\n   383\t                attempts += 1\n   384\t                ext_cap = float(ext_vals[rng.integers(0, len(ext_vals))])\n   385\t                act_cap = float(act_vals[rng.integers(0, len(act_vals))])\n   386\t                internal = total - ext_cap - act_cap\n   387\t                if internal < 0:\n   388\t                    continue\n   389\t                if not _internal_cap_ok(internal, min_internal, max_internal):\n   390\t                    continue\n   391\t                pair = (ext_cap, act_cap)\n   392\t                if pair in seen:\n   393\t                    continue\n   394\t                seen.add(pair)\n   395\t                combos.append(pair)\n   396\t            if len(combos) < max_evals:\n   397\t                for ext_cap in ext_vals:\n   398\t                    max_act = total - float(ext_cap)\n   399\t                    if max_act < act_vals[0]:\n   400\t                        continue\n   401\t                    idx = int(np.searchsorted(act_vals, max_act, side=\"right\"))\n   402\t                    for act_cap in act_vals[:idx]:\n   403\t                        pair = (float(ext_cap), float(act_cap))\n   404\t                        internal = total - pair[0] - pair[1]\n   405\t                        if not _internal_cap_ok(internal, min_internal, max_internal):\n   406\t                            continue\n   407\t                        if pair in seen:\n   408\t                            continue\n   409\t                        seen.add(pair)\n   410\t                        combos.append(pair)\n   411\t                        if len(combos) >= max_evals:\n   412\t                            break\n   413\t                    if len(combos) >= max_evals:\n   414\t                        break\n   415\t\n   416\t    records: list[dict[str, float]] = []\n   417\t\n   418\t    def _maybe_record(ext_cap: float, act_cap: float) -> None:\n   419\t        int_cap = total - ext_cap - act_cap\n   420\t\n   421\t        # Bounds filtering (if provided)\n   422\t        if min_external is not None and ext_cap < min_external:\n   423\t            return\n   424\t        if max_external is not None and ext_cap > max_external:\n   425\t            return\n   426\t        if min_active is not None and act_cap < min_active:\n   427\t            return\n   428\t        if max_active is not None and act_cap > max_active:\n   429\t            return\n   430\t        if min_internal is not None and int_cap < min_internal:\n   431\t            return\n   432\t        if max_internal is not None and int_cap > max_internal:\n   433\t            return\n   434\t\n   435\t        evaluated = _evaluate_allocation(\n   436\t            cfg,\n   437\t            idx_series,\n   438\t            ext_cap=ext_cap,\n   439\t            act_cap=act_cap,\n   440\t            int_cap=int_cap,\n   441\t            max_te=max_te,\n   442\t            max_breach=max_breach,\n   443\t            max_cvar=max_cvar,\n   444\t            max_shortfall=max_shortfall,\n   445\t            constraint_scope=constraint_scope,\n   446\t            seed=seed,\n   447\t            objective=objective,\n   448\t            stream_cache=stream_cache,\n   449\t        )\n   450\t        if evaluated is None:\n   451\t            return\n   452\t        metrics, meets, objective_value = evaluated\n   453\t        if meets:\n   454\t            record = {\n   455\t                \"external_pa_capital\": float(ext_cap),\n   456\t                \"active_ext_capital\": float(act_cap),\n   457\t                \"internal_pa_capital\": float(int_cap),\n   458\t            }\n   459\t            record.update(metrics)\n   460\t            if objective_value is not None:\n   461\t                record[\"objective_value\"] = float(objective_value)\n   462\t            record[\"risk_score\"] = _risk_score(metrics, constraint_scope)\n   463\t            records.append(record)\n   464\t\n   465\t    if combos is None:\n   466\t        for ext_cap in ext_grid:\n   467\t            max_act = total - float(ext_cap)\n   468\t            if max_act < act_grid[0]:\n   469\t                continue\n   470\t            for act_cap in act_grid:\n   471\t                if float(act_cap) > max_act:\n   472\t                    break\n   473\t                _maybe_record(float(ext_cap), float(act_cap))\n   474\t    else:\n   475\t        for ext_cap, act_cap in combos:\n   476\t            _maybe_record(ext_cap, act_cap)\n   477\t    df = pd.DataFrame.from_records(records)\n   478\t    if not df.empty and sort_by in df.columns:\n   479\t        ascending = sort_by != \"objective_value\"\n   480\t        df = df.sort_values(sort_by, ascending=ascending).reset_index(drop=True)\n   481\t    return df\n   482\t\n   483\t\n   484\tdef _load_minimize() -> _MinimizeFunc | None:\n   485\t    try:\n   486\t        from scipy.optimize import minimize\n   487\t    except ImportError:\n   488\t        return None\n   489\t    return cast(_MinimizeFunc, minimize)\n   490\t\n   491\t\n   492\tdef _metric_slope(metric: float | None, capital: float, *, total: float) -> float | None:\n   493\t    if metric is None:\n   494\t        return None\n   495\t    min_cap = max(total * 1e-4, 1e-6)\n   496\t    denom = max(capital, min_cap)\n   497\t    return metric / denom\n   498\t\n   499\t\n   500\tdef _build_linear_surrogates(\n   501\t    cfg: ModelConfig,\n   502\t    idx_series: pd.Series,\n   503\t    *,\n   504\t    seed: int | None,\n   505\t    stream_cache: _StreamCache | None = None,\n   506\t) -> dict[str, dict[str, float]] | None:\n   507\t    if stream_cache is None:\n   508\t        streams = None\n   509\t    else:\n   510\t        streams = stream_cache.get()\n   511\t    if streams is None:\n   512\t        orch = SimulatorOrchestrator(cfg, idx_series)\n   513\t        _, summary = orch.run(seed=seed)\n   514\t    else:\n   515\t        agents = build_from_config(cfg)\n   516\t        returns = simulate_agents(agents, *streams)\n   517\t        summary = summary_table(returns, benchmark=\"Base\")\n   518\t    total = cfg.total_fund_capital\n   519\t    slopes: dict[str, dict[str, float]] = {}\n   520\t    for agent, capital in (\n   521\t        (\"ExternalPA\", cfg.external_pa_capital),\n   522\t        (\"ActiveExt\", cfg.active_ext_capital),\n   523\t        (\"InternalPA\", cfg.internal_pa_capital),\n   524\t    ):\n   525\t        sub = summary[summary[\"Agent\"] == agent]\n   526\t        if sub.empty:\n   527\t            return None\n   528\t        row = sub.iloc[0]\n   529\t        te = _coerce_metric(row[\"monthly_TE\"])\n   530\t        bprob = _coerce_metric(row[\"monthly_BreachProb\"])\n   531\t        cvar = _coerce_metric(row[\"monthly_CVaR\"])\n   532\t        shortfall = _coerce_metric(row[\"terminal_ShortfallProb\"])\n   533\t        ann_return = _coerce_metric(row[\"terminal_AnnReturn\"])\n   534\t        excess_return = _coerce_metric(row[\"terminal_ExcessReturn\"])\n   535\t        if (\n   536\t            te is None\n   537\t            or bprob is None\n   538\t            or cvar is None\n   539\t            or shortfall is None\n   540\t            or ann_return is None\n   541\t            or excess_return is None\n   542\t        ):\n   543\t            return None\n   544\t        slopes[agent] = {\n   545\t            \"monthly_TE\": _metric_slope(te, capital, total=total) or 0.0,\n   546\t            \"monthly_BreachProb\": _metric_slope(bprob, capital, total=total) or 0.0,\n   547\t            \"monthly_CVaR\": _metric_slope(abs(cvar), capital, total=total) or 0.0,\n   548\t            \"terminal_ShortfallProb\": _metric_slope(shortfall, capital, total=total) or 0.0,\n   549\t            \"terminal_AnnReturn\": _metric_slope(ann_return, capital, total=total) or 0.0,\n   550\t            \"terminal_ExcessReturn\": _metric_slope(excess_return, capital, total=total) or 0.0,\n   551\t        }\n   552\t    return slopes\n   553\t\n   554\t\n   555\tdef _initial_guess(\n   556\t    cfg: ModelConfig,\n   557\t    *,\n   558\t    total: float,\n   559\t    bounds: Sequence[tuple[float, float]],\n   560\t    min_internal: float,\n   561\t    max_internal: float,\n   562\t) -> np.ndarray:\n   563\t    ext_min, ext_max = bounds[0]\n   564\t    act_min, act_max = bounds[1]\n   565\t    ext = float(min(max(cfg.external_pa_capital, ext_min), ext_max))\n   566\t    act = float(min(max(cfg.active_ext_capital, act_min), act_max))\n   567\t    internal = total - ext - act\n   568\t    if min_internal <= internal <= max_internal:\n   569\t        return np.array([ext, act], dtype=float)\n   570\t    target_internal = min(max(internal, min_internal), max_internal)\n   571\t    remaining = total - target_internal\n   572\t    min_sum = ext_min + act_min\n   573\t    max_sum = ext_max + act_max\n   574\t    remaining = min(max(remaining, min_sum), max_sum)\n   575\t    ext_range = ext_max - ext_min\n   576\t    act_range = act_max - act_min\n   577\t    if ext_range + act_range == 0:\n   578\t        return np.array([ext_min, act_min], dtype=float)\n   579\t    ext = ext_min + (remaining - min_sum) * (ext_range / (ext_range + act_range))\n   580\t    act = remaining - ext\n   581\t    return np.array([ext, act], dtype=float)\n   582\t\n   583\t\n   584\tdef _optimize_sleeve_sizes(\n   585\t    cfg: ModelConfig,\n   586\t    idx_series: pd.Series,\n   587\t    *,\n   588\t    max_te: float,\n   589\t    max_breach: float,\n   590\t    max_cvar: float,\n   591\t    max_shortfall: float,\n   592\t    min_external: float | None,\n   593\t    max_external: float | None,\n   594\t    min_active: float | None,\n   595\t    max_active: float | None,\n   596\t    min_internal: float | None,\n   597\t    max_internal: float | None,\n   598\t    seed: int | None,\n   599\t    constraint_scope: Literal[\"sleeves\", \"total\", \"both\"],\n   600\t    objective: str,\n   601\t    maxiter: int,\n   602\t    stream_cache: _StreamCache | None = None,\n   603\t) -> tuple[pd.DataFrame | None, str]:\n   604\t    minimize = _load_minimize()\n   605\t    if minimize is None:\n   606\t        return None, \"missing_scipy\"\n   607\t\n   608\t    slopes = _build_linear_surrogates(cfg, idx_series, seed=seed, stream_cache=stream_cache)\n   609\t    if slopes is None:\n   610\t        return None, \"missing_metrics\"\n   611\t\n   612\t    total = cfg.total_fund_capital\n   613\t    min_ext = 0.0 if min_external is None else min_external\n   614\t    max_ext = total if max_external is None else max_external\n   615\t    min_act = 0.0 if min_active is None else min_active\n   616\t    max_act = total if max_active is None else max_active\n   617\t    min_int = 0.0 if min_internal is None else min_internal\n   618\t    max_int = total if max_internal is None else max_internal\n   619\t\n   620\t    bounds = [(min_ext, max_ext), (min_act, max_act)]\n   621\t    x0 = _initial_guess(cfg, total=total, bounds=bounds, min_internal=min_int, max_internal=max_int)\n   622\t\n   623\t    def internal_cap(x: np.ndarray) -> float:\n   624\t        return float(total - x[0] - x[1])\n   625\t\n   626\t    def cap_for_agent(x: np.ndarray, agent: str) -> float:\n   627\t        if agent == \"ExternalPA\":\n   628\t            return float(x[0])\n   629\t        if agent == \"ActiveExt\":\n   630\t            return float(x[1])\n   631\t        return internal_cap(x)\n   632\t\n   633\t    constraints: list[dict[str, object]] = []\n   634\t    for agent in SLEEVE_AGENTS:\n   635\t        if constraint_scope in {\"sleeves\", \"both\"}:\n   636\t            for metric, limit in (\n   637\t                (\"monthly_TE\", max_te),\n   638\t                (\"monthly_BreachProb\", max_breach),\n   639\t                (\"monthly_CVaR\", max_cvar),\n   640\t                (\"terminal_ShortfallProb\", max_shortfall),\n   641\t            ):\n   642\t                slope = slopes[agent].get(metric)\n   643\t                constraints.append(\n   644\t                    {\n   645\t                        \"type\": \"ineq\",\n   646\t                        \"fun\": lambda x, s=slope, lim=limit, ag=agent: (\n   647\t                            lim - s * cap_for_agent(x, ag)\n   648\t                        ),\n   649\t                    }\n   650\t                )\n   651\t\n   652\t    if constraint_scope in {\"total\", \"both\"}:\n   653\t        for metric, limit in (\n   654\t            (\"monthly_TE\", max_te),\n   655\t            (\"monthly_BreachProb\", max_breach),\n   656\t            (\"monthly_CVaR\", max_cvar),\n   657\t            (\"terminal_ShortfallProb\", max_shortfall),\n   658\t        ):\n   659\t            constraints.append(\n   660\t                {\n   661\t                    \"type\": \"ineq\",\n   662\t                    \"fun\": lambda x, lim=limit, met=metric: (\n   663\t                        lim - sum(slopes[ag][met] * cap_for_agent(x, ag) for ag in SLEEVE_AGENTS)\n   664\t                    ),\n   665\t                }\n   666\t            )\n   667\t\n   668\t    constraints.append({\"type\": \"ineq\", \"fun\": lambda x, mn=min_int: internal_cap(x) - mn})\n   669\t    constraints.append({\"type\": \"ineq\", \"fun\": lambda x, mx=max_int: mx - internal_cap(x)})\n   670\t\n   671\t    if objective not in SUPPORTED_OBJECTIVES:\n   672\t        return None, \"invalid_objective\"\n   673\t\n   674\t    def objective_fn(x: np.ndarray) -> float:\n   675\t        ext, act = float(x[0]), float(x[1])\n   676\t        internal = internal_cap(x)\n   677\t        key = \"terminal_AnnReturn\" if objective == \"total_return\" else \"terminal_ExcessReturn\"\n   678\t        total_return = (\n   679\t            slopes[\"ExternalPA\"][key] * ext\n   680\t            + slopes[\"ActiveExt\"][key] * act\n   681\t            + slopes[\"InternalPA\"][key] * internal\n   682\t        )\n   683\t        return -float(total_return)\n   684\t\n   685\t    result = minimize(\n   686\t        objective_fn,\n   687\t        x0,\n   688\t        method=\"SLSQP\",\n   689\t        bounds=bounds,\n   690\t        constraints=constraints,\n   691\t        options={\"maxiter\": maxiter},\n   692\t    )\n   693\t\n   694\t    ext_cap, act_cap = float(result.x[0]), float(result.x[1])\n   695\t    int_cap = float(total - ext_cap - act_cap)\n   696\t    evaluated = _evaluate_allocation(\n   697\t        cfg,\n   698\t        idx_series,\n   699\t        ext_cap=ext_cap,\n   700\t        act_cap=act_cap,\n   701\t        int_cap=int_cap,\n   702\t        max_te=max_te,\n   703\t        max_breach=max_breach,\n   704\t        max_cvar=max_cvar,\n   705\t        max_shortfall=max_shortfall,\n   706\t        constraint_scope=constraint_scope,\n   707\t        seed=seed,\n   708\t        objective=objective,\n   709\t        stream_cache=stream_cache,\n   710\t    )\n   711\t    if evaluated is None:\n   712\t        return None, \"invalid_metrics\"\n   713\t    metrics, meets, objective_value = evaluated\n   714\t    record: dict[str, object] = {\n   715\t        \"external_pa_capital\": float(ext_cap),\n   716\t        \"active_ext_capital\": float(act_cap),\n   717\t        \"internal_pa_capital\": float(int_cap),\n   718\t    }\n   719\t    record.update(metrics)\n   720\t    if objective_value is not None:\n   721\t        record[\"objective_value\"] = float(objective_value)\n   722\t    record[\"risk_score\"] = _risk_score(metrics, constraint_scope)\n   723\t    record[\"constraints_satisfied\"] = bool(meets)\n   724\t    record[\"optimizer_success\"] = bool(result.success)\n   725\t    record[\"optimizer_status\"] = str(result.message)\n   726\t    record[\"objective\"] = objective\n   727\t    status = \"optimizer_ok\" if result.success else \"optimizer_failed\"\n   728\t    return pd.DataFrame([record]), status\n   729\t\n   730\t\n   731\tdef suggest_sleeve_sizes(\n   732\t    cfg: ModelConfig,\n   733\t    idx_series: pd.Series,\n   734\t    *,\n   735\t    max_te: float,\n   736\t    max_breach: float,\n   737\t    max_cvar: float,\n   738\t    max_shortfall: float,\n   739\t    step: float = 0.25,\n   740\t    min_external: float | None = None,\n   741\t    max_external: float | None = None,\n   742\t    min_active: float | None = None,\n   743\t    max_active: float | None = None,\n   744\t    min_internal: float | None = None,\n   745\t    max_internal: float | None = None,\n   746\t    sort_by: str = \"risk_score\",\n   747\t    seed: int | None = None,\n   748\t    max_evals: int | None = 500,\n   749\t    constraint_scope: Literal[\"sleeves\", \"total\", \"both\"] = \"sleeves\",\n   750\t    optimize: bool = False,\n   751\t    objective: str = \"total_return\",\n   752\t    optimizer_maxiter: int = 200,\n   753\t) -> pd.DataFrame:\n   754\t    \"\"\"Suggest sleeve allocations that respect risk constraints.\n   755\t\n   756\t    Performs a grid search over capital allocations for the three sleeves\n   757\t    (external portable alpha, active extension and internal PA). When\n   758\t    ``optimize`` is enabled, a coarse convex surrogate is used with\n   759\t    ``scipy.optimize.minimize`` to target higher-return allocations, falling\n   760\t    back to the grid if the optimizer fails.\n   761\t\n   762\t    Parameters\n   763\t    ----------\n   764\t    cfg:\n   765\t        Base :class:`~pa_core.config.ModelConfig` used as a template.\n   766\t    idx_series:\n   767\t        Benchmark return series used by :class:`SimulatorOrchestrator`.\n   768\t    max_te:\n   769\t        Maximum allowed tracking error per sleeve.\n   770\t    max_breach:\n   771\t        Maximum allowed breach probability per sleeve.\n   772\t    max_cvar:\n   773\t        Absolute monthly_CVaR cap per sleeve.\n   774\t    max_shortfall:\n   775\t        Maximum terminal shortfall probability per sleeve.\n   776\t    step:\n   777\t        Grid step as a fraction of ``total_fund_capital``.\n   778\t    seed:\n   779\t        Optional random seed for reproducibility.\n   780\t    max_evals:\n   781\t        If set and the Cartesian grid would exceed this number of\n   782\t        combinations, a random subset of at most ``max_evals`` points is\n   783\t        evaluated. This prevents exponential runtime as ``step`` becomes\n   784\t        small.\n   785\t    constraint_scope:\n   786\t        Apply constraints to per-sleeve metrics, total portfolio metrics,\n   787\t        or both.\n   788\t\n   789\t    Returns\n   790\t    -------\n   791\t    pandas.DataFrame\n   792\t        Table of feasible capital combinations and associated metrics.\n   793\t    \"\"\"\n   794\t\n   795\t    if constraint_scope not in {\"sleeves\", \"total\", \"both\"}:\n   796\t        raise ValueError(\"constraint_scope must be one of: sleeves, total, both\")\n   797\t    if max_evals is not None and max_evals < 0:\n   798\t        raise ValueError(\"max_evals must be non-negative\")\n   799\t\n   800\t    stream_cache = _StreamCache(cfg, idx_series, seed)\n   801\t\n   802\t    if optimize:\n   803\t        opt_df, status = _optimize_sleeve_sizes(\n   804\t            cfg,\n   805\t            idx_series,\n   806\t            max_te=max_te,\n   807\t            max_breach=max_breach,\n   808\t            max_cvar=max_cvar,\n   809\t            max_shortfall=max_shortfall,\n   810\t            min_external=min_external,\n   811\t            max_external=max_external,\n   812\t            min_active=min_active,\n   813\t            max_active=max_active,\n   814\t            min_internal=min_internal,\n   815\t            max_internal=max_internal,\n   816\t            seed=seed,\n   817\t            constraint_scope=constraint_scope,\n   818\t            objective=objective,\n   819\t            maxiter=optimizer_maxiter,\n   820\t            stream_cache=stream_cache,\n   821\t        )\n   822\t        if opt_df is not None:\n   823\t            meets = bool(opt_df.loc[0, \"constraints_satisfied\"])\n   824\t            if bool(opt_df.loc[0, \"optimizer_success\"]) and meets:\n   825\t                return opt_df.reset_index(drop=True)\n   826\t        grid_df = _grid_sleeve_sizes(\n   827\t            cfg,\n   828\t            idx_series,\n   829\t            max_te=max_te,\n   830\t            max_breach=max_breach,\n   831\t            max_cvar=max_cvar,\n   832\t            max_shortfall=max_shortfall,\n   833\t            step=step,\n   834\t            min_external=min_external,\n   835\t            max_external=max_external,\n   836\t            min_active=min_active,\n   837\t            max_active=max_active,\n   838\t            min_internal=min_internal,\n   839\t            max_internal=max_internal,\n   840\t            sort_by=\"objective_value\",\n   841\t            seed=seed,\n   842\t            max_evals=max_evals,\n   843\t            constraint_scope=constraint_scope,\n   844\t            objective=objective,\n   845\t            stream_cache=stream_cache,\n   846\t        )\n   847\t        if grid_df.empty:\n   848\t            if opt_df is None:\n   849\t                return pd.DataFrame()\n   850\t            opt_df[\"optimizer_status\"] = f\"fallback_failed:{status}\"\n--- tests suggestor all ---\n     1\tfrom pathlib import Path\n     2\tfrom typing import Any\n     3\t\n     4\timport numpy as np\n     5\timport pandas as pd\n     6\timport pytest\n     7\t\n     8\timport pa_core.cli as cli_module\n     9\tfrom pa_core.cli import main\n    10\tfrom pa_core.config import ModelConfig, load_config\n    11\tfrom pa_core.data import load_index_returns\n    12\tfrom pa_core.sim.metrics import summary_table\n    13\tfrom pa_core.sleeve_suggestor import (\n    14\t    _StreamCache,\n    15\t    _coerce_metric,\n    16\t    _extract_metrics,\n    17\t    suggest_sleeve_sizes,\n    18\t)\n    19\t\n    20\tyaml: Any = pytest.importorskip(\"yaml\")\n    21\t\n    22\t\n    23\tdef _constraint_summary(*agents: str) -> pd.DataFrame:\n    24\t    return pd.DataFrame(\n    25\t        [\n    26\t            {\n    27\t                \"Agent\": agent,\n    28\t                \"monthly_TE\": 0.1,\n    29\t                \"monthly_BreachProb\": 0.2,\n    30\t                \"monthly_CVaR\": -0.3,\n    31\t                \"terminal_ShortfallProb\": 0.4,\n    32\t            }\n    33\t            for agent in agents\n    34\t        ]\n    35\t    )\n    36\t\n    37\t\n    38\tdef test_stream_cache_probes_missing_stream_capability_once(monkeypatch):\n    39\t    \"\"\"A stable missing capability must not double orchestration work for every allocation.\"\"\"\n    40\t    cfg = ModelConfig(N_SIMULATIONS=1, N_MONTHS=1, financing_mode=\"broadcast\")\n    41\t    constructions = 0\n    42\t\n    43\t    class OrchestratorWithoutStreams:\n    44\t        def __init__(self, _cfg, _idx_series):\n    45\t            nonlocal constructions\n    46\t            constructions += 1\n    47\t\n    48\t    monkeypatch.setattr(\n    49\t        \"pa_core.sleeve_suggestor.SimulatorOrchestrator\", OrchestratorWithoutStreams\n    50\t    )\n    51\t    cache = _StreamCache(cfg, pd.Series([0.0]), seed=7)\n    52\t\n    53\t    assert cache.get() is None\n    54\t    assert cache.get() is None\n    55\t    assert constructions == 1\n    56\t\n    57\t\n    58\tdef test_total_constraints_fail_closed_without_total_metrics():\n    59\t    \"\"\"Portfolio-wide limits cannot be declared satisfied without a portfolio row.\"\"\"\n    60\t    summary = _constraint_summary(\"ExternalPA\", \"ActiveExt\", \"InternalPA\")\n    61\t\n    62\t    assert (\n    63\t        _extract_metrics(\n    64\t            summary,\n    65\t            max_te=1.0,\n    66\t            max_breach=1.0,\n    67\t            max_cvar=1.0,\n    68\t            max_shortfall=1.0,\n    69\t            constraint_scope=\"total\",\n    70\t        )\n    71\t        is None\n    72\t    )\n    73\t\n    74\t\n    75\tdef test_metric_coercion_accepts_finite_text_and_rejects_invalid_values():\n    76\t    \"\"\"Report-shaped strings are valid inputs, but malformed or non-finite risk data is not.\"\"\"\n    77\t    assert _coerce_metric(\"1.25\") == pytest.approx(1.25)\n    78\t    for invalid in (None, \"not-a-number\", object(), np.inf, \"nan\"):\n    79\t        assert _coerce_metric(invalid) is None\n    80\t\n    81\t\n    82\tdef test_suggest_sleeve_sizes_rejects_negative_evaluation_budget():\n    83\t    \"\"\"A negative cap must fail explicitly instead of evaluating an arbitrary priority slice.\"\"\"\n    84\t    cfg = ModelConfig(N_SIMULATIONS=1, N_MONTHS=1, financing_mode=\"broadcast\")\n    85\t\n    86\t    with pytest.raises(ValueError, match=\"max_evals must be non-negative\"):\n    87\t        suggest_sleeve_sizes(\n    88\t            cfg,\n    89\t            pd.Series([0.0]),\n    90\t            max_te=1.0,\n    91\t            max_breach=1.0,\n    92\t            max_cvar=1.0,\n    93\t            max_shortfall=1.0,\n    94\t            max_evals=-1,\n    95\t        )\n    96\t\n    97\t\n    98\tdef test_suggest_sleeve_sizes_returns_feasible():\n    99\t    cfg = load_config(\"examples/scenarios/test_params.yml\")\n   100\t    cfg = cfg.model_copy(update={\"N_SIMULATIONS\": 50})\n   101\t    idx_series = pd.Series([0.0] * cfg.N_MONTHS)\n   102\t    df = suggest_sleeve_sizes(\n   103\t        cfg,\n   104\t        idx_series,\n   105\t        max_te=0.02,\n   106\t        max_breach=0.5,\n   107\t        max_cvar=0.05,\n   108\t        max_shortfall=0.5,\n   109\t        step=0.5,\n   110\t        seed=1,\n   111\t    )\n   112\t    assert not df.empty\n   113\t    assert {\n   114\t        \"external_pa_capital\",\n   115\t        \"active_ext_capital\",\n   116\t        \"internal_pa_capital\",\n   117\t    }.issubset(df.columns)\n   118\t\n   119\t\n   120\tdef test_suggest_sleeve_sizes_respects_bounds():\n   121\t    cfg = load_config(\"examples/scenarios/test_params.yml\")\n   122\t    cfg = cfg.model_copy(update={\"N_SIMULATIONS\": 50})\n   123\t    idx_series = pd.Series([0.0] * cfg.N_MONTHS)\n   124\t    max_te = 0.02\n   125\t    max_breach = 0.5\n   126\t    max_cvar = 0.05\n   127\t    max_shortfall = 0.5\n   128\t    df = suggest_sleeve_sizes(\n   129\t        cfg,\n   130\t        idx_series,\n   131\t        max_te=max_te,\n   132\t        max_breach=max_breach,\n   133\t        max_cvar=max_cvar,\n   134\t        max_shortfall=max_shortfall,\n   135\t        step=0.5,\n   136\t        seed=1,\n   137\t    )\n   138\t    assert (df.filter(regex=\"_TE\").fillna(0) <= max_te).all().all()\n   139\t    assert (df.filter(regex=\"_BreachProb\").fillna(0) <= max_breach).all().all()\n   140\t    assert (df.filter(regex=\"_CVaR\").fillna(0).abs() <= max_cvar).all().all()\n   141\t    assert (df.filter(regex=\"_ShortfallProb\").fillna(0) <= max_shortfall).all().all()\n   142\t\n   143\t\n   144\tdef test_cli_sleeve_suggestion(tmp_path, monkeypatch):\n   145\t    cfg = {\"N_SIMULATIONS\": 10, \"N_MONTHS\": 1, \"financing_mode\": \"broadcast\"}\n   146\t    cfg_path = tmp_path / \"cfg.yaml\"\n   147\t    cfg_path.write_text(yaml.safe_dump(cfg))\n   148\t    idx_csv = Path(__file__).resolve().parents[1] / \"data\" / \"sp500tr_fred_divyield.csv\"\n   149\t    out_file = tmp_path / \"out.xlsx\"\n   150\t    monkeypatch.setattr(\"builtins.input\", lambda _: \"0\")\n   151\t    main(\n   152\t        [\n   153\t            \"--config\",\n   154\t            str(cfg_path),\n   155\t            \"--index\",\n   156\t            str(idx_csv),\n   157\t            \"--output\",\n   158\t            str(out_file),\n   159\t            \"--seed\",\n   160\t            \"0\",\n   161\t            \"--suggest-sleeves\",\n   162\t            \"--max-te\",\n   163\t            \"0.02\",\n   164\t            \"--max-breach\",\n   165\t            \"0.5\",\n   166\t            \"--max-cvar\",\n   167\t            \"0.05\",\n   168\t            \"--sleeve-step\",\n   169\t            \"0.5\",\n   170\t        ]\n   171\t    )\n   172\t    assert out_file.exists()\n   173\t\n   174\t\n   175\tdef test_cli_sleeve_suggestion_auto_apply(tmp_path, monkeypatch):\n   176\t    cfg = {\"N_SIMULATIONS\": 10, \"N_MONTHS\": 1, \"financing_mode\": \"broadcast\"}\n   177\t    cfg_path = tmp_path / \"cfg.yaml\"\n   178\t    cfg_path.write_text(yaml.safe_dump(cfg))\n   179\t    idx_csv = Path(__file__).resolve().parents[1] / \"data\" / \"sp500tr_fred_divyield.csv\"\n   180\t    out_file = tmp_path / \"out.xlsx\"\n   181\t\n   182\t    def _fail_input(*_args):\n   183\t        raise AssertionError(\"input should not be called\")\n   184\t\n   185\t    monkeypatch.setattr(\"builtins.input\", _fail_input)\n   186\t    main(\n   187\t        [\n   188\t            \"--config\",\n   189\t            str(cfg_path),\n   190\t            \"--index\",\n   191\t            str(idx_csv),\n   192\t            \"--output\",\n   193\t            str(out_file),\n   194\t            \"--seed\",\n   195\t            \"0\",\n   196\t            \"--suggest-sleeves\",\n   197\t            \"--suggest-apply-index\",\n   198\t            \"0\",\n   199\t            \"--max-te\",\n   200\t            \"0.02\",\n   201\t            \"--max-breach\",\n   202\t            \"0.5\",\n   203\t            \"--max-cvar\",\n   204\t            \"0.05\",\n   205\t            \"--sleeve-step\",\n   206\t            \"0.5\",\n   207\t        ]\n   208\t    )\n   209\t    assert out_file.exists()\n   210\t\n   211\t\n   212\tdef test_cli_sleeve_suggestion_applies_to_inputs(tmp_path, monkeypatch):\n   213\t    cfg = {\n   214\t        \"N_SIMULATIONS\": 1,\n   215\t        \"N_MONTHS\": 1,\n   216\t        \"financing_mode\": \"broadcast\",\n   217\t        \"analysis_mode\": \"single_with_sensitivity\",\n   218\t        \"total_fund_capital\": 300.0,\n   219\t        \"external_pa_capital\": 100.0,\n   220\t        \"active_ext_capital\": 50.0,\n   221\t        \"internal_pa_capital\": 150.0,\n   222\t        \"risk_metrics\": [\"Return\", \"Risk\", \"terminal_ShortfallProb\"],\n   223\t    }\n   224\t    cfg_path = tmp_path / \"cfg.yaml\"\n   225\t    cfg_path.write_text(yaml.safe_dump(cfg))\n   226\t    idx_csv = Path(__file__).resolve().parents[1] / \"data\" / \"sp500tr_fred_divyield.csv\"\n   227\t    out_file = tmp_path / \"out.xlsx\"\n   228\t\n   229\t    suggestions = pd.DataFrame(\n   230\t        [\n   231\t            {\n   232\t                \"external_pa_capital\": 200.0,\n   233\t                \"active_ext_capital\": 50.0,\n   234\t                \"internal_pa_capital\": 50.0,\n   235\t            }\n   236\t        ]\n   237\t    )\n   238\t    monkeypatch.setattr(\n   239\t        \"pa_core.sleeve_suggestor.suggest_sleeve_sizes\",\n   240\t        lambda *_args, **_kwargs: suggestions,\n   241\t    )\n   242\t    monkeypatch.setattr(\n   243\t        \"pa_core.sim.sensitivity.one_factor_deltas\",\n   244\t        lambda *_args, **_kwargs: pd.DataFrame(),\n   245\t    )\n   246\t\n   247\t    captured: dict[str, object] = {}\n   248\t\n   249\t    def _export_to_excel(inputs_dict, _summary, _raw_returns_dict, **_kwargs):\n   250\t        captured[\"inputs_dict\"] = inputs_dict\n   251\t\n   252\t    monkeypatch.setattr(\"pa_core.agents.registry.build_from_config\", lambda _cfg: object())\n   253\t    monkeypatch.setattr(\"pa_core.reporting.export_to_excel\", _export_to_excel)\n   254\t    monkeypatch.setattr(\n   255\t        \"pa_core.sim.draw_financing_series\",\n   256\t        lambda *_args, **_kwargs: (\n   257\t            np.zeros((1, 1)),\n   258\t            np.zeros((1, 1)),\n   259\t            np.zeros((1, 1)),\n   260\t        ),\n   261\t    )\n   262\t    monkeypatch.setattr(\n   263\t        \"pa_core.sim.draw_joint_returns\",\n   264\t        lambda *_args, **_kwargs: (\n   265\t            np.zeros((1, 1)),\n   266\t            np.zeros((1, 1)),\n   267\t            np.zeros((1, 1)),\n   268\t            np.zeros((1, 1)),\n   269\t        ),\n   270\t    )\n   271\t    monkeypatch.setattr(\n   272\t        \"pa_core.sim.covariance.build_cov_matrix\",\n   273\t        lambda *_args, **_kwargs: np.zeros((4, 4)),\n   274\t    )\n   275\t    monkeypatch.setattr(\n   276\t        \"pa_core.simulations.simulate_agents\",\n   277\t        lambda *_args, **_kwargs: {\"Base\": np.zeros((1, 1))},\n   278\t    )\n   279\t\n   280\t    main(\n   281\t        [\n   282\t            \"--config\",\n   283\t            str(cfg_path),\n   284\t            \"--index\",\n   285\t            str(idx_csv),\n   286\t            \"--output\",\n   287\t            str(out_file),\n   288\t            \"--suggest-sleeves\",\n   289\t            \"--suggest-apply-index\",\n   290\t            \"0\",\n   291\t            \"--sensitivity\",\n   292\t        ]\n   293\t    )\n   294\t\n   295\t    inputs = captured.get(\"inputs_dict\")\n   296\t    assert isinstance(inputs, dict)\n   297\t    assert inputs[\"external_pa_capital\"] == 200.0\n   298\t    assert inputs[\"active_ext_capital\"] == 50.0\n   299\t    assert inputs[\"internal_pa_capital\"] == 50.0\n   300\t\n   301\t\n   302\tdef test_suggest_sleeve_sizes_total_constraints(monkeypatch):\n   303\t    cfg = load_config(\"examples/scenarios/test_params.yml\")\n   304\t    cfg = cfg.model_copy(update={\"N_SIMULATIONS\": 2, \"N_MONTHS\": 2})\n   305\t    idx_series = pd.Series([0.0] * cfg.N_MONTHS)\n   306\t\n   307\t    base = np.array([[0.0, 0.0], [0.0, 0.0]])\n   308\t    ext = np.array([[0.1, -0.1], [0.1, -0.1]])\n   309\t    act = np.array([[0.05, -0.05], [0.05, -0.05]])\n   310\t    intr = np.array([[0.2, -0.2], [0.2, -0.2]])\n   311\t    total = ext + act + intr\n   312\t    returns = {\n   313\t        \"Base\": base,\n   314\t        \"ExternalPA\": ext,\n   315\t        \"ActiveExt\": act,\n   316\t        \"InternalPA\": intr,\n   317\t        \"Total\": total,\n   318\t    }\n   319\t    summary = summary_table(returns, benchmark=\"Base\")\n   320\t\n   321\t    class DummyOrchestrator:\n   322\t        def __init__(self, cfg, idx_series):\n   323\t            self.cfg = cfg\n   324\t            self.idx_series = idx_series\n   325\t\n   326\t        def run(self, seed=None):\n   327\t            return returns, summary\n   328\t\n   329\t    monkeypatch.setattr(\"pa_core.sleeve_suggestor.SimulatorOrchestrator\", DummyOrchestrator)\n   330\t\n   331\t    df = suggest_sleeve_sizes(\n   332\t        cfg,\n   333\t        idx_series,\n   334\t        max_te=0.0,\n   335\t        max_breach=1.0,\n   336\t        max_cvar=1.0,\n   337\t        max_shortfall=1.0,\n   338\t        step=1.0,\n   339\t        constraint_scope=\"total\",\n   340\t    )\n   341\t    assert df.empty\n   342\t\n   343\t    df = suggest_sleeve_sizes(\n   344\t        cfg,\n   345\t        idx_series,\n   346\t        max_te=1.5,\n   347\t        max_breach=1.0,\n   348\t        max_cvar=1.0,\n   349\t        max_shortfall=1.0,\n   350\t        step=1.0,\n   351\t        constraint_scope=\"total\",\n   352\t    )\n   353\t    assert not df.empty\n   354\t    assert {\n   355\t        \"Total_monthly_TE\",\n   356\t        \"Total_monthly_BreachProb\",\n   357\t        \"Total_monthly_CVaR\",\n   358\t        \"Total_terminal_ShortfallProb\",\n   359\t    }.issubset(df.columns)\n   360\t    assert (df[\"Total_monthly_TE\"] <= 1.5).all()\n   361\t    assert (df[\"Total_monthly_BreachProb\"] <= 1.0).all()\n   362\t    assert (df[\"Total_monthly_CVaR\"].abs() <= 1.0).all()\n   363\t    assert (df[\"Total_terminal_ShortfallProb\"] <= 1.0).all()\n   364\t\n   365\t\n   366\tdef test_suggest_sleeve_sizes_caps_max_evals(monkeypatch):\n   367\t    cfg = ModelConfig(N_SIMULATIONS=1, N_MONTHS=1, financing_mode=\"broadcast\")\n   368\t    idx_series = pd.Series([0.0])\n   369\t\n   370\t    returns = {\n   371\t        \"Base\": np.zeros((1, 1)),\n   372\t        \"ExternalPA\": np.zeros((1, 1)),\n   373\t        \"ActiveExt\": np.zeros((1, 1)),\n   374\t        \"InternalPA\": np.zeros((1, 1)),\n   375\t    }\n   376\t    summary = summary_table(returns, benchmark=\"Base\")\n   377\t\n   378\t    class DummyOrchestrator:\n   379\t        def __init__(self, cfg, idx_series):\n   380\t            self.cfg = cfg\n   381\t            self.idx_series = idx_series\n   382\t\n   383\t        def run(self, seed=None):\n   384\t            return returns, summary\n   385\t\n   386\t    monkeypatch.setattr(\"pa_core.sleeve_suggestor.SimulatorOrchestrator\", DummyOrchestrator)\n   387\t\n   388\t    df = suggest_sleeve_sizes(\n   389\t        cfg,\n   390\t        idx_series,\n   391\t        max_te=1.0,\n   392\t        max_breach=1.0,\n   393\t        max_cvar=1.0,\n   394\t        max_shortfall=1.0,\n   395\t        step=0.5,\n   396\t        max_evals=2,\n   397\t    )\n   398\t\n   399\t    assert len(df) == 2\n   400\t\n   401\t\n   402\tdef test_suggest_sleeve_sizes_reuses_cached_streams(monkeypatch):\n   403\t    cfg = ModelConfig(\n   404\t        N_SIMULATIONS=1,\n   405\t        N_MONTHS=1,\n   406\t        financing_mode=\"broadcast\",\n   407\t        total_fund_capital=100.0,\n   408\t        external_pa_capital=50.0,\n   409\t        active_ext_capital=25.0,\n   410\t        internal_pa_capital=25.0,\n   411\t    )\n   412\t    idx_series = pd.Series([0.0])\n   413\t\n   414\t    r = np.zeros((1, 1))\n   415\t    streams = (r, r, r, r, r, r, r)\n   416\t    calls = {\"draw\": 0}\n   417\t\n   418\t    class DummyOrchestrator:\n   419\t        def __init__(self, cfg, idx_series):\n   420\t            self.cfg = cfg\n   421\t            self.idx_series = idx_series\n   422\t\n   423\t        def draw_streams(self, seed=None):\n   424\t            calls[\"draw\"] += 1\n   425\t            return streams\n   426\t\n   427\t        def run(self, seed=None):\n   428\t            raise AssertionError(\"run should not be called when streams are cached\")\n   429\t\n   430\t    monkeypatch.setattr(\"pa_core.sleeve_suggestor.SimulatorOrchestrator\", DummyOrchestrator)\n   431\t\n   432\t    df = suggest_sleeve_sizes(\n   433\t        cfg,\n   434\t        idx_series,\n   435\t        max_te=1.0,\n   436\t        max_breach=1.0,\n   437\t        max_cvar=1.0,\n   438\t        max_shortfall=1.0,\n   439\t        step=0.5,\n   440\t        max_evals=3,\n   441\t    )\n   442\t\n   443\t    assert calls[\"draw\"] == 1\n   444\t    assert not df.empty\n   445\t\n   446\t\n   447\tdef test_suggest_sleeve_sizes_skips_invalid_metrics(monkeypatch):\n   448\t    cfg = ModelConfig(N_SIMULATIONS=1, N_MONTHS=1, financing_mode=\"broadcast\")\n   449\t    idx_series = pd.Series([0.0])\n   450\t\n   451\t    returns = {\n   452\t        \"Base\": np.zeros((1, 1)),\n   453\t        \"ExternalPA\": np.zeros((1, 1)),\n   454\t        \"ActiveExt\": np.zeros((1, 1)),\n   455\t        \"InternalPA\": np.zeros((1, 1)),\n   456\t    }\n   457\t    summary = summary_table(returns, benchmark=\"Base\")\n   458\t    summary.loc[summary[\"Agent\"] == \"ExternalPA\", \"monthly_TE\"] = np.nan\n   459\t\n   460\t    class DummyOrchestrator:\n   461\t        def __init__(self, cfg, idx_series):\n   462\t            self.cfg = cfg\n   463\t            self.idx_series = idx_series\n   464\t\n   465\t        def run(self, seed=None):\n   466\t            return returns, summary\n   467\t\n   468\t    monkeypatch.setattr(\"pa_core.sleeve_suggestor.SimulatorOrchestrator\", DummyOrchestrator)\n   469\t\n   470\t    df = suggest_sleeve_sizes(\n   471\t        cfg,\n   472\t        idx_series,\n   473\t        max_te=1.0,\n   474\t        max_breach=1.0,\n   475\t        max_cvar=1.0,\n   476\t        max_shortfall=1.0,\n   477\t        step=1.0,\n   478\t    )\n   479\t\n   480\t    assert df.empty\n   481\t\n   482\t\n   483\tdef test_sleeve_suggestor_matches_cli_summary(tmp_path, monkeypatch):\n   484\t    cfg_data = {\n   485\t        \"N_SIMULATIONS\": 4,\n   486\t        \"N_MONTHS\": 3,\n   487\t        \"financing_mode\": \"broadcast\",\n   488\t        \"analysis_mode\": \"single_with_sensitivity\",\n   489\t        \"total_fund_capital\": 1000.0,\n   490\t        \"external_pa_capital\": 500.0,\n   491\t        \"active_ext_capital\": 250.0,\n   492\t        \"internal_pa_capital\": 250.0,\n   493\t        \"risk_metrics\": [\"terminal_ShortfallProb\"],\n   494\t    }\n   495\t    cfg_path = tmp_path / \"cfg.yml\"\n   496\t    cfg_path.write_text(yaml.safe_dump(cfg_data))\n   497\t    idx_path = tmp_path / \"index.csv\"\n   498\t    idx_path.write_text(\"Monthly_TR\\n0.01\\n0.02\\n-0.01\\n0.03\\n\")\n   499\t\n   500\t    cfg = load_config(cfg_path)\n   501\t    idx_series = load_index_returns(idx_path)\n   502\t\n   503\t    suggestions = suggest_sleeve_sizes(\n   504\t        cfg,\n   505\t        idx_series,\n   506\t        max_te=1.0,\n   507\t        max_breach=1.0,\n   508\t        max_cvar=1.0,\n   509\t        max_shortfall=1.0,\n   510\t        step=0.25,\n   511\t        min_external=500.0,\n   512\t        max_external=500.0,\n   513\t        min_active=250.0,\n   514\t        max_active=250.0,\n   515\t        min_internal=250.0,\n   516\t        max_internal=250.0,\n   517\t        seed=123,\n   518\t    )\n   519\t    assert len(suggestions) == 1\n   520\t\n   521\t    captured: dict[str, pd.DataFrame] = {}\n   522\t\n   523\t    def _capture_summary(summary_df):\n   524\t        captured.setdefault(\"summary\", summary_df)\n   525\t\n   526\t    monkeypatch.setattr(cli_module, \"print_enhanced_summary\", _capture_summary)\n   527\t    monkeypatch.setattr(\"pa_core.reporting.export_to_excel\", lambda *_args, **_kwargs: None)\n   528\t    main(\n   529\t        [\n   530\t            \"--config\",\n   531\t            str(cfg_path),\n   532\t            \"--index\",\n   533\t            str(idx_path),\n   534\t            \"--output\",\n   535\t            str(tmp_path / \"out.xlsx\"),\n   536\t            \"--seed\",\n   537\t            \"123\",\n   538\t            \"--sensitivity\",\n   539\t        ],\n   540\t    )\n   541\t\n   542\t    summary = captured.get(\"summary\")\n   543\t    assert isinstance(summary, pd.DataFrame)\n   544\t    row = suggestions.iloc[0]\n   545\t    for agent in [\"ExternalPA\", \"ActiveExt\", \"InternalPA\"]:\n   546\t        sub = summary[summary[\"Agent\"] == agent]\n   547\t        assert not sub.empty\n   548\t        summary_row = sub.iloc[0]\n   549\t        np.testing.assert_allclose(\n   550\t            float(summary_row[\"monthly_TE\"]),\n   551\t            float(row[f\"{agent}_monthly_TE\"]),\n   552\t        )\n   553\t        np.testing.assert_allclose(\n   554\t            float(summary_row[\"monthly_BreachProb\"]),\n   555\t            float(row[f\"{agent}_monthly_BreachProb\"]),\n   556\t        )\n   557\t        np.testing.assert_allclose(\n   558\t            float(summary_row[\"monthly_CVaR\"]),\n   559\t            float(row[f\"{agent}_monthly_CVaR\"]),\n   560\t        )\n   561\t        np.testing.assert_allclose(\n   562\t            float(summary_row[\"terminal_ShortfallProb\"]),\n   563\t            float(row[f\"{agent}_terminal_ShortfallProb\"]),\n   564\t        )\n   565\t\n   566\t\n   567\tdef _make_linear_summary(cfg: ModelConfig) -> pd.DataFrame:\n   568\t    per_cap = {\n   569\t        \"ExternalPA\": {\n   570\t            \"terminal_AnnReturn\": 0.03,\n   571\t            \"terminal_ExcessReturn\": 0.025,\n   572\t            \"monthly_TE\": 0.0001,\n   573\t            \"monthly_BreachProb\": 0.0002,\n   574\t            \"monthly_CVaR\": -0.0003,\n   575\t            \"terminal_ShortfallProb\": 0.0004,\n   576\t        },\n   577\t        \"ActiveExt\": {\n   578\t            \"terminal_AnnReturn\": 0.01,\n   579\t            \"terminal_ExcessReturn\": 0.008,\n   580\t            \"monthly_TE\": 0.0001,\n   581\t            \"monthly_BreachProb\": 0.0002,\n   582\t            \"monthly_CVaR\": -0.0003,\n   583\t            \"terminal_ShortfallProb\": 0.0004,\n   584\t        },\n   585\t        \"InternalPA\": {\n   586\t            \"terminal_AnnReturn\": 0.02,\n   587\t            \"terminal_ExcessReturn\": 0.015,\n   588\t            \"monthly_TE\": 0.0001,\n   589\t            \"monthly_BreachProb\": 0.0002,\n   590\t            \"monthly_CVaR\": -0.0003,\n   591\t            \"terminal_ShortfallProb\": 0.0004,\n   592\t        },\n   593\t    }\n   594\t    rows = []\n   595\t    totals = {\n   596\t        \"terminal_AnnReturn\": 0.0,\n   597\t        \"terminal_ExcessReturn\": 0.0,\n   598\t        \"monthly_TE\": 0.0,\n   599\t        \"monthly_BreachProb\": 0.0,\n   600\t        \"monthly_CVaR\": 0.0,\n   601\t        \"terminal_ShortfallProb\": 0.0,\n   602\t    }\n   603\t    for agent, capital in (\n   604\t        (\"ExternalPA\", cfg.external_pa_capital),\n   605\t        (\"ActiveExt\", cfg.active_ext_capital),\n   606\t        (\"InternalPA\", cfg.internal_pa_capital),\n   607\t    ):\n   608\t        metrics = {k: v * capital for k, v in per_cap[agent].items()}\n   609\t        totals = {k: totals[k] + metrics[k] for k in totals}\n   610\t        rows.append({\"Agent\": agent, **metrics})\n   611\t    rows.append({\"Agent\": \"Total\", **totals})\n   612\t    return pd.DataFrame(rows)\n   613\t\n   614\t\n   615\tdef test_suggest_sleeve_sizes_optimize_prefers_best(monkeypatch):\n   616\t    _ = pytest.importorskip(\"scipy\")\n   617\t    cfg = ModelConfig(\n   618\t        N_SIMULATIONS=1,\n   619\t        N_MONTHS=1,\n   620\t        financing_mode=\"broadcast\",\n   621\t        total_fund_capital=100.0,\n   622\t        external_pa_capital=40.0,\n   623\t        active_ext_capital=30.0,\n   624\t        internal_pa_capital=30.0,\n   625\t    )\n   626\t    idx_series = pd.Series([0.0])\n   627\t\n   628\t    class DummyOrchestrator:\n   629\t        def __init__(self, cfg, idx_series):\n   630\t            self.cfg = cfg\n   631\t            self.idx_series = idx_series\n   632\t\n   633\t        def run(self, seed=None):\n   634\t            return {}, _make_linear_summary(self.cfg)\n   635\t\n   636\t    monkeypatch.setattr(\"pa_core.sleeve_suggestor.SimulatorOrchestrator\", DummyOrchestrator)\n   637\t\n   638\t    df = suggest_sleeve_sizes(\n   639\t        cfg,\n   640\t        idx_series,\n   641\t        max_te=0.05,\n   642\t        max_breach=0.05,\n   643\t        max_cvar=0.05,\n   644\t        max_shortfall=0.05,\n   645\t        step=0.5,\n   646\t        min_external=0.0,\n   647\t        max_external=80.0,\n   648\t        min_active=0.0,\n   649\t        max_active=80.0,\n   650\t        min_internal=0.0,\n   651\t        max_internal=100.0,\n   652\t        optimize=True,\n   653\t        objective=\"total_return\",\n   654\t    )\n   655\t    assert not df.empty\n   656\t    row = df.iloc[0]\n   657\t    assert row[\"optimizer_success\"]\n   658\t    assert row[\"constraints_satisfied\"]\n   659\t    assert row[\"external_pa_capital\"] == pytest.approx(80.0)\n   660\t    assert row[\"active_ext_capital\"] == pytest.approx(0.0)\n   661\t    assert row[\"internal_pa_capital\"] == pytest.approx(20.0)\n   662\t\n   663\t    rng = np.random.default_rng(0)\n   664\t    random_scores = []\n   665\t    for _ in range(25):\n   666\t        ext = float(rng.uniform(0.0, 80.0))\n   667\t        act = float(rng.uniform(0.0, 80.0))\n   668\t        remaining = 100.0 - ext - act\n   669\t        if remaining < 0:\n   670\t            continue\n   671\t        random_scores.append(0.03 * ext + 0.02 * remaining + 0.01 * act)\n   672\t    assert row[\"objective_value\"] >= max(random_scores)\n   673\t\n   674\t\n   675\tdef test_suggest_sleeve_sizes_optimize_missing_scipy_falls_back(monkeypatch):\n   676\t    cfg = ModelConfig(\n   677\t        N_SIMULATIONS=1,\n   678\t        N_MONTHS=1,\n   679\t        financing_mode=\"broadcast\",\n   680\t        total_fund_capital=100.0,\n   681\t        external_pa_capital=40.0,\n   682\t        active_ext_capital=30.0,\n   683\t        internal_pa_capital=30.0,\n   684\t    )\n   685\t    idx_series = pd.Series([0.0])\n   686\t\n   687\t    class DummyOrchestrator:\n   688\t        def __init__(self, cfg, idx_series):\n   689\t            self.cfg = cfg\n   690\t            self.idx_series = idx_series\n   691\t\n   692\t        def run(self, seed=None):\n   693\t            return {}, _make_linear_summary(self.cfg)\n   694\t\n   695\t    monkeypatch.setattr(\"pa_core.sleeve_suggestor.SimulatorOrchestrator\", DummyOrchestrator)\n   696\t    monkeypatch.setattr(\"pa_core.sleeve_suggestor._load_minimize\", lambda: None)\n   697\t\n   698\t    df = suggest_sleeve_sizes(\n   699\t        cfg,\n   700\t        idx_series,\n   701\t        max_te=0.05,\n   702\t        max_breach=0.05,\n   703\t        max_cvar=0.05,\n   704\t        max_shortfall=0.05,\n   705\t        step=0.5,\n   706\t        optimize=True,\n   707\t        objective=\"total_return\",\n   708\t    )\n   709\t    assert not df.empty\n   710\t    assert str(df.loc[0, \"optimizer_status\"]).startswith(\"grid_fallback\")\n   711\t\n   712\t\n   713\tdef test_suggest_sleeve_sizes_infeasible_constraints_returns_status(monkeypatch):\n   714\t    cfg = ModelConfig(\n   715\t        N_SIMULATIONS=1,\n   716\t        N_MONTHS=1,\n   717\t        financing_mode=\"broadcast\",\n   718\t        total_fund_capital=100.0,\n   719\t        external_pa_capital=40.0,\n   720\t        active_ext_capital=30.0,\n   721\t        internal_pa_capital=30.0,\n   722\t    )\n   723\t    idx_series = pd.Series([0.0])\n   724\t\n   725\t    class DummyOrchestrator:\n   726\t        def __init__(self, cfg, idx_series):\n   727\t            self.cfg = cfg\n   728\t            self.idx_series = idx_series\n   729\t\n   730\t        def run(self, seed=None):\n   731\t            return {}, _make_linear_summary(self.cfg)\n   732\t\n   733\t    class DummyResult:\n   734\t        def __init__(self, x):\n   735\t            self.x = np.array(x, dtype=float)\n   736\t            self.success = False\n   737\t            self.message = \"failed\"\n   738\t\n   739\t    def _fake_minimize(fun, x0, method=None, bounds=None, constraints=None, options=None):\n   740\t        return DummyResult(x0)\n   741\t\n   742\t    monkeypatch.setattr(\"pa_core.sleeve_suggestor.SimulatorOrchestrator\", DummyOrchestrator)\n   743\t    monkeypatch.setattr(\"pa_core.sleeve_suggestor._load_minimize\", lambda: _fake_minimize)\n   744\t\n   745\t    df = suggest_sleeve_sizes(\n   746\t        cfg,\n   747\t        idx_series,\n   748\t        max_te=1e-6,\n   749\t        max_breach=1e-6,\n   750\t        max_cvar=1e-6,\n   751\t        max_shortfall=1e-6,\n   752\t        step=0.5,\n   753\t        optimize=True,\n   754\t        objective=\"total_return\",\n   755\t    )\n   756\t    assert not df.empty\n   757\t    assert not bool(df.loc[0, \"constraints_satisfied\"])\n   758\t    assert str(df.loc[0, \"optimizer_status\"]).startswith(\"fallback_failed\")\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_17","type":"agent_message","text":"The strongest defect so far is not a numerical formula: sweep and sleeve-sizing paths mutate convenience fields with `model_copy`, bypassing the compiler that rebuilds agents. I’m now proving whether those declared levers actually change simulated results, with controls."}}
