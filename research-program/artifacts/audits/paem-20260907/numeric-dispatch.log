01\t                f\"{name} (indices {name_to_indices[name]})\" for name in duplicate_names\n  1102\t            )\n  1103\t            errors.append(\"agent names must be unique; duplicates found: \" + duplicate_detail)\n  1104\t        benchmark_count = sum(1 for name in names if name == \"Base\")\n  1105\t        if benchmark_count != 1:\n  1106\t            base_indices = name_to_indices.get(\"Base\", [])\n  1107\t            extra_hint = \"\"\n  1108\t            if benchmark_count == 0:\n  1109\t                extra_hint = \" Add an agent with name 'Base' to the agents list.\"\n  1110\t                if names:\n  1111\t                    existing_names = \", \".join(sorted(set(names)))\n  1112\t                    extra_hint += f\" Existing agents: {existing_names}.\"\n  1113\t            else:\n  1114\t                extra_hint = f\" Found Base at indices {base_indices}; remove duplicates.\"\n  1115\t            errors.append(\n  1116\t                f\"exactly one benchmark agent named 'Base' is required; found {benchmark_count}.\"\n  1117\t                f\"{extra_hint}\"\n  1118\t            )\n  1119\t\n  1120\t        for idx, agent in enumerate(self.agents):\n  1121\t            if agent.capital < 0:\n  1122\t                errors.append(\n  1123\t                    f\"agents[{idx}] ({agent.name}) capital must be >= 0; got {agent.capital}\"\n  1124\t                )\n  1125\t            if not SHARE_MIN <= agent.beta_share <= SHARE_MAX:\n  1126\t                errors.append(\n  1127\t                    f\"agents[{idx}] ({agent.name}) beta_share must be between 0 and 1; got {agent.beta_share}\"\n  1128\t                )\n  1129\t            if not SHARE_MIN <= agent.alpha_share <= SHARE_MAX:\n  1130\t                errors.append(\n  1131\t                    f\"agents[{idx}] ({agent.name}) alpha_share must be between 0 and 1; got {agent.alpha_share}\"\n  1132\t                )\n  1133\t            if agent.beta_share + agent.alpha_share > SHARE_MAX + SHARE_SUM_TOLERANCE:\n  1134\t                errors.append(\n  1135\t                    f\"agents[{idx}] ({agent.name}) beta_share + alpha_share must be <= 1; \"\n  1136\t                    f\"got {agent.beta_share + agent.alpha_share}. \"\n  1137\t                    \"Reduce beta_share or alpha_share so the total is <= 1.\"\n  1138\t                )\n  1139\t\n  1140\t        if self.agents:\n  1141\t            total_agent_capital = sum(\n  1142\t                agent.capital for agent in self.agents if agent.name != \"Base\"\n  1143\t            )\n  1144\t            if total_agent_capital > self.total_fund_capital + SHARE_SUM_TOLERANCE:\n  1145\t                errors.append(\n  1146\t                    \"sum(non-benchmark agent capital) must be <= total_fund_capital; \"\n  1147\t                    f\"got {total_agent_capital} > {self.total_fund_capital}. \"\n  1148\t                    \"Benchmark capital is treated as the total fund capital.\"\n  1149\t                )\n  1150\t\n  1151\t        if errors:\n  1152\t            raise ValueError(\"; \".join(errors))\n  1153\t        return self\n  1154\t\n  1155\t    @model_validator(mode=\"after\")\n  1156\t    def check_analysis_mode(self) -> \"ModelConfig\":\n  1157\t        self._trace_transform(self, \"check_analysis_mode\")\n  1158\t        valid_modes = [\n  1159\t            \"capital\",\n  1160\t            \"returns\",\n  1161\t            \"alpha_shares\",\n  1162\t            \"vol_mult\",\n  1163\t            \"single_with_sensitivity\",\n  1164\t        ]\n  1165\t        if self.analysis_mode not in valid_modes:\n  1166\t            raise ValueError(f\"analysis_mode must be one of: {valid_modes}\")\n  1167\t        return self\n  1168\t\n  1169\t    @model_validator(mode=\"after\")\n  1170\t    def check_vol_regime_window(self) -> \"ModelConfig\":\n  1171\t        self._trace_transform(self, \"check_vol_regime_window\")\n  1172\t        if self.vol_regime == \"two_state\" and self.vol_regime_window <= 1:\n  1173\t            raise ValueError(\"vol_regime_window must be > 1 for two_state regime\")\n  1174\t        return self\n  1175\t\n  1176\t    @field_validator(\"backend\", mode=\"before\")\n  1177\t    @classmethod\n  1178\t    def reject_unsupported_backend(cls, value: Any) -> Any:\n  1179\t        if value not in SUPPORTED_BACKENDS:\n  1180\t            valid_backends = list(SUPPORTED_BACKENDS)\n  1181\t            raise ValueError(\n  1182\t                f\"backend must be one of: {valid_backends} ({BACKEND_UNAVAILABLE_DETAIL})\"\n  1183\t            )\n  1184\t        return value\n  1185\t\n  1186\t    @model_validator(mode=\"after\")\n  1187\t    def check_backend(self) -> \"ModelConfig\":\n  1188\t        self._trace_transform(self, \"check_backend\")\n  1189\t        return self\n  1190\t\n  1191\t    @model_validator(mode=\"after\")\n  1192\t    def check_simulation_params(self) -> \"ModelConfig\":\n  1193\t        self._trace_transform(self, \"check_simulation_params\")\n  1194\t        from .validators import validate_simulation_parameters\n  1195\t\n--- metrics ---\n     1\tfrom __future__ import annotations\n     2\t\n     3\timport warnings\n     4\tfrom importlib.metadata import entry_points\n     5\tfrom statistics import NormalDist\n     6\tfrom typing import Callable, Dict, Mapping, cast\n     7\t\n     8\timport pandas as pd\n     9\t\n    10\tfrom ..backend import xp as np\n    11\tfrom ..types import ArrayLike\n    12\tfrom ..units import DEFAULT_BREACH_THRESHOLD, DEFAULT_SHORTFALL_THRESHOLD\n    13\t\n    14\t__all__ = [\n    15\t    \"active_return_volatility\",\n    16\t    \"per_path_active_return_volatility\",\n    17\t    \"tracking_error\",\n    18\t    \"value_at_risk\",\n    19\t    \"cvar_monthly\",\n    20\t    \"cvar_terminal\",\n    21\t    \"metric_standard_error\",\n    22\t    \"cvar_standard_error\",\n    23\t    \"cvar_confidence_interval\",\n    24\t    \"monte_carlo_convergence_diagnostic\",\n    25\t    \"compound\",\n    26\t    \"annualised_return\",\n    27\t    \"annualised_return_percentile\",\n    28\t    \"annualised_vol\",\n    29\t    \"breach_probability\",\n    30\t    \"breach_count_path0\",\n    31\t    \"breach_count\",\n    32\t    \"conditional_value_at_risk\",\n    33\t    \"max_cumulative_sum_drawdown\",\n    34\t    \"max_drawdown\",\n    35\t    \"compounded_return_below_zero_fraction\",\n    36\t    \"time_under_water\",\n    37\t    \"terminal_return_below_threshold_prob\",\n    38\t    \"shortfall_probability\",\n    39\t    \"summary_table\",\n    40\t    \"metric_definitions_df\",\n    41\t    \"register_metric\",\n    42\t]\n    43\t\n    44\t\n    45\t_EXTRA_METRICS: Dict[str, Callable[[ArrayLike], float]] = {}\n    46\t_EXTRA_METRIC_DEFINITIONS: Dict[str, Dict[str, str]] = {}\n    47\t\n    48\t\n    49\tdef register_metric(\n    50\t    name: str,\n    51\t    func: Callable[[ArrayLike], float],\n    52\t    *,\n    53\t    metric_type: str = \"diagnostic\",\n    54\t    description: str | None = None,\n    55\t) -> None:\n    56\t    \"\"\"Register a custom risk metric for inclusion in ``summary_table``.\"\"\"\n    57\t    if name in _EXTRA_METRICS:\n    58\t        raise KeyError(f\"Metric already registered: {name}\")\n    59\t    _EXTRA_METRICS[name] = func\n    60\t    _EXTRA_METRIC_DEFINITIONS[name] = {\n    61\t        \"Metric\": name,\n    62\t        \"MetricType\": metric_type,\n    63\t        \"Description\": description or \"User-registered metric.\",\n    64\t    }\n    65\t\n    66\t\n    67\tdef _load_metric_plugins() -> None:\n    68\t    for ep in entry_points(group=\"pa_core.risk_metrics\"):\n    69\t        register_metric(ep.name, ep.load())\n    70\t\n    71\t\n    72\t_load_metric_plugins()\n    73\t\n    74\t\n    75\tdef active_return_volatility(\n    76\t    strategy: ArrayLike,\n    77\t    benchmark: ArrayLike,\n    78\t    *,\n    79\t    periods_per_year: int = 12,\n    80\t) -> float:\n    81\t    \"\"\"Return annualised volatility of monthly active returns (tracking error).\n    82\t\n    83\t    The volatility is computed over all monthly draws (and all paths when 2D),\n    84\t    then annualised using ``periods_per_year``. This is a monthly-draw metric,\n    85\t    not a terminal outcome metric.\n    86\t    \"\"\"\n    87\t    if strategy.shape != benchmark.shape:\n    88\t        raise ValueError(\"shape mismatch\")\n    89\t    diff = np.asarray(strategy) - np.asarray(benchmark)\n    90\t    if diff.size <= 1:\n    91\t        return 0.0\n    92\t    return float(np.std(diff, ddof=1) * np.sqrt(periods_per_year))\n    93\t\n    94\t\n    95\tdef per_path_active_return_volatility(\n    96\t    strategy: ArrayLike,\n    97\t    benchmark: ArrayLike,\n    98\t    *,\n    99\t    periods_per_year: int = 12,\n   100\t) -> float:\n   101\t    \"\"\"Return annualised tracking error averaged over per-path active-return vols.\n   102\t\n   103\t    Unlike :func:`active_return_volatility`, which pools every ``(path, month)``\n   104\t    active return into a single dispersion, this computes the annualised\n   105\t    volatility of active returns *within each path* and then averages those\n   106\t    per-path tracking errors across paths. Because the pooled estimator also\n   107\t    absorbs cross-path dispersion of the active-return mean, it is typically\n   108\t    higher than this per-path average; this metric isolates the tracking error a\n   109\t    single path experiences over time. This is a monthly-draw metric.\n   110\t    \"\"\"\n   111\t    if strategy.shape != benchmark.shape:\n   112\t        raise ValueError(\"shape mismatch\")\n   113\t    diff = np.asarray(strategy, dtype=np.float64) - np.asarray(benchmark, dtype=np.float64)\n   114\t    if diff.size <= 1:\n   115\t        return 0.0\n   116\t    if diff.ndim == 1:\n   117\t        return float(np.std(diff, ddof=1) * np.sqrt(periods_per_year))\n   118\t    if diff.shape[1] <= 1:\n   119\t        # A single month per path leaves the within-path sample std undefined.\n   120\t        return 0.0\n   121\t    per_path = np.std(diff, axis=1, ddof=1)\n   122\t    return float(np.mean(per_path) * np.sqrt(periods_per_year))\n   123\t\n   124\t\n   125\tdef tracking_error(\n   126\t    strategy: ArrayLike,\n   127\t    benchmark: ArrayLike,\n   128\t    *,\n   129\t    periods_per_year: int = 12,\n   130\t) -> float:\n   131\t    \"\"\"Deprecated alias for :func:`active_return_volatility` (monthly-draw metric).\"\"\"\n   132\t    warnings.warn(\n   133\t        \"tracking_error is deprecated; use active_return_volatility\",\n   134\t        DeprecationWarning,\n   135\t        stacklevel=2,\n   136\t    )\n   137\t    return active_return_volatility(\n   138\t        strategy,\n   139\t        benchmark,\n   140\t        periods_per_year=periods_per_year,\n   141\t    )\n   142\t\n   143\t\n   144\tdef value_at_risk(returns: ArrayLike, confidence: float = 0.95) -> float:\n   145\t    \"\"\"Return monthly VaR from all monthly draws at the given confidence level.\n   146\t\n   147\t    The VaR is computed on the flattened draws (paths x months), so each month\n   148\t    of each path is weighted equally. This is a monthly-draw metric, not a\n   149\t    terminal outcome metric.\n   150\t    \"\"\"\n   151\t    if not 0 < confidence < 1:\n   152\t        raise ValueError(\"confidence must be between 0 and 1\")\n   153\t    flat = np.asarray(returns).reshape(-1)\n   154\t    percentile = 100 * (1 - confidence)\n   155\t    return float(np.percentile(flat, percentile))\n   156\t\n   157\t\n   158\tdef compound(returns: ArrayLike) -> ArrayLike:\n   159\t    \"\"\"Return cumulative compounded returns along axis 1 (per-path time series).\n   160\t\n   161\t    Each path is compounded across months; no cross-path aggregation is done.\n   162\t    \"\"\"\n   163\t    arr = np.asarray(returns, dtype=np.float64)\n   164\t    return np.cumprod(1.0 + arr, axis=1) - 1.0  # type: ignore[no-any-return]\n   165\t\n   166\t\n   167\tdef annualised_return(returns: ArrayLike, periods_per_year: int = 12) -> float:\n   168\t    \"\"\"Return annualised compound return from terminal compounded outcomes.\n   169\t\n   170\t    Each path contributes one terminal compounded return, which is averaged\n   171\t    before annualising. This is a terminal-outcome metric.\n   172\t    \"\"\"\n   173\t    comp = compound(returns)\n   174\t    total_return = comp[:, -1]\n   175\t    years = returns.shape[1] / periods_per_year\n   176\t    base = 1.0 + float(np.mean(total_return))\n   177\t    if base <= 0.0:\n   178\t        # Mean terminal multiple is wiped out (mean compounded return <= -100%):\n   179\t        # the annualised compound return is a total loss. Return -1.0 rather than\n   180\t        # raising a RuntimeWarning / returning NaN from a fractional power of a\n   181\t        # non-positive base.\n   182\t        return -1.0\n   183\t    return float(np.power(base, 1.0 / years) - 1.0)\n   184\t\n   185\t\n   186\tdef annualised_return_percentile(returns: ArrayLike, q: float, periods_per_year: int = 12) -> float:\n   187\t    \"\"\"Return the annualised compound return at the ``q``-th percentile of paths.\n   188\t\n   189\t    :func:`annualised_return` averages the terminal compounded return across\n   190\t    paths *before* annualising; that arithmetic mean of terminal wealth is\n   191\t    dominated by the right tail and a typical path does not resemble it. This\n   192\t    function instead annualises the ``q``-th percentile of the per-path terminal\n   193\t    compounded returns, so ``q=50`` gives the median CAGR a typical outcome\n   194\t    resembles and ``q=10``/``q=90`` bound the distribution. This is a\n   195\t    terminal-outcome metric.\n   196\t    \"\"\"\n   197\t    arr = np.asarray(returns, dtype=np.float64)\n   198\t    if arr.size == 0:\n   199\t        raise ValueError(\"returns must not be empty\")\n   200\t    if arr.ndim == 1:\n   201\t        arr = arr.reshape(1, -1)\n   202\t    if arr.ndim != 2:\n   203\t        raise ValueError(\"returns must be a 1D or 2D array\")\n   204\t    comp = compound(arr)\n   205\t    total_return = comp[:, -1]\n   206\t    years = arr.shape[1] / periods_per_year\n   207\t    base = 1.0 + float(np.percentile(total_return, q))\n   208\t    if base <= 0.0:\n   209\t        # Percentile terminal multiple wiped out: report a total loss rather than\n   210\t        # raising from a fractional power of a non-positive base (mirrors\n   211\t        # :func:`annualised_return`).\n   212\t        return -1.0\n   213\t    return float(np.power(base, 1.0 / years) - 1.0)\n   214\t\n   215\t\n   216\tdef annualised_vol(returns: ArrayLike, periods_per_year: int = 12) -> float:\n   217\t    \"\"\"Return annualised volatility from monthly returns.\n   218\t\n   219\t    The volatility is computed over all monthly draws (paths x months) and then\n   220\t    annualised. This is a monthly-draw metric.\n   221\t    \"\"\"\n   222\t    arr = np.asarray(returns, dtype=np.float64)\n   223\t    if arr.size == 0:\n   224\t        raise ValueError(\"returns must not be empty\")\n   225\t    if arr.size == 1:\n   226\t        # The ddof=1 sample standard deviation is undefined for a single\n   227\t        # observation; report 0.0 rather than NaN from the divide-by-zero.\n   228\t        return 0.0\n   229\t    return float(np.std(arr, ddof=1) * np.sqrt(periods_per_year))\n   230\t\n   231\t\n   232\tdef breach_probability(\n   233\t    returns: ArrayLike,\n   234\t    threshold: float,\n   235\t    *,\n   236\t    path: int | None = None,\n   237\t    mode: str = \"month\",\n   238\t) -> float:\n   239\t    \"\"\"Return the fraction of breaches under ``threshold`` using ``mode``.\n   240\t\n   241\t    For 2D arrays shaped (paths, periods):\n   242\t    - ``mode=\"month\"`` reports the share of all simulated months across all\n   243\t      paths that fall below ``threshold`` (Option C). Each month of every path\n   244\t      contributes equally, so the denominator is ``paths * periods``.\n   245\t    - ``mode=\"any\"`` reports the fraction of simulation paths that breach at\n   246\t      least once during the horizon (Option A).\n   247\t    - ``mode=\"terminal\"`` reports the fraction of paths that breach in the\n   248\t      terminal month (Option B).\n   249\t    For 1D arrays, ``mode=\"month\"`` is the share of months below the threshold,\n   250\t    while the other modes return 1.0 or 0.0 for the single path. ``path`` is\n   251\t    ignored and kept only for backward compatibility with legacy callers; all\n   252\t    modes use every available path and month, never just the first path. The\n   253\t    \"month\" mode is a monthly-draw metric, while \"any\" and \"terminal\" are\n   254\t    terminal-path metrics.\n   255\t    \"\"\"\n   256\t    arr = np.asarray(returns, dtype=np.float64)\n   257\t    if arr.size == 0:\n   258\t        raise ValueError(\"returns must not be empty\")\n   259\t    if mode == \"month\":\n   260\t        return float(np.mean(arr < threshold))\n   261\t    if mode not in {\"any\", \"terminal\"}:\n   262\t        raise ValueError('mode must be one of \"month\", \"any\", or \"terminal\"')\n   263\t    if arr.ndim == 1:\n   264\t        breached = bool(np.any(arr < threshold)) if mode == \"any\" else bool(arr[-1] < threshold)\n   265\t        return float(breached)\n   266\t    if mode == \"any\":\n   267\t        return float(np.mean(np.any(arr < threshold, axis=1)))\n   268\t    if mode == \"terminal\":\n   269\t        return float(np.mean(arr[:, -1] < threshold))\n   270\t    raise ValueError('mode must be one of \"month\", \"any\", or \"terminal\"')\n   271\t\n   272\t\n   273\tdef terminal_return_below_threshold_prob(\n   274\t    returns: ArrayLike,\n   275\t    threshold: float = -0.05,\n   276\t    *,\n   277\t    periods_per_year: int = 12,\n   278\t) -> float:\n   279\t    \"\"\"Return probability terminal compounded return is below a horizon threshold.\n   280\t\n   281\t    ``threshold`` is interpreted as an annualised return hurdle. It is converted\n   282\t    to a horizon-adjusted compounded threshold via\n   283\t    ``(1 + threshold) ** years - 1`` where ``years = periods / periods_per_year``.\n   284\t    For 2D inputs, the probability is computed from terminal compounded returns\n   285\t    over the full horizon. For 1D inputs, rolling windows of length\n   286\t    ``min(periods_per_year, len(returns))`` estimate the shortfall frequency,\n   287\t    using the same annual-to-horizon conversion for each window. This is a\n   288\t    terminal-outcome metric.\n   289\t    \"\"\"\n   290\t\n   291\t    arr = np.asarray(returns, dtype=np.float64)\n   292\t    if arr.size == 0:\n   293\t        raise ValueError(\"returns must not be empty\")\n   294\t    if arr.ndim == 1:\n   295\t        window = min(arr.shape[0], periods_per_year)\n   296\t        years = window / periods_per_year\n   297\t        horizon_threshold = float(np.power(1.0 + threshold, years) - 1.0)\n   298\t        if window == 1:\n   299\t            window_returns = arr\n   300\t        else:\n   301\t            window_returns = np.empty(arr.shape[0] - window + 1, dtype=np.float64)\n   302\t            for idx in range(window_returns.size):\n   303\t                window_returns[idx] = np.prod(1.0 + arr[idx : idx + window]) - 1.0\n   304\t        return float(np.mean(window_returns < horizon_threshold))\n   305\t    years = arr.shape[1] / periods_per_year\n   306\t    horizon_threshold = float(np.power(1.0 + threshold, years) - 1.0)\n   307\t    comp = compound(arr)\n   308\t    final_returns = comp[:, -1]\n   309\t    return float(np.mean(final_returns < horizon_threshold))\n   310\t\n   311\t\n   312\tdef shortfall_probability(\n   313\t    returns: ArrayLike,\n   314\t    threshold: float = -0.05,\n   315\t    *,\n   316\t    periods_per_year: int = 12,\n   317\t) -> float:\n   318\t    \"\"\"Deprecated alias for :func:`terminal_return_below_threshold_prob` (terminal metric).\"\"\"\n   319\t    warnings.warn(\n   320\t        \"shortfall_probability is deprecated; use terminal_return_below_threshold_prob\",\n   321\t        DeprecationWarning,\n   322\t        stacklevel=2,\n   323\t    )\n   324\t    return terminal_return_below_threshold_prob(\n   325\t        returns,\n   326\t        threshold,\n   327\t        periods_per_year=periods_per_year,\n   328\t    )\n   329\t\n   330\t\n   331\tdef breach_count_path0(returns: ArrayLike, threshold: float, *, path: int = 0) -> int:\n   332\t    \"\"\"Return the number of monthly breaches below ``threshold`` for one path.\n   333\t\n   334\t    This is a path-specific diagnostic (defaulting to path 0). It does not\n   335\t    average across simulations and should not be interpreted as an expected\n   336\t    breach count across paths. It is intentionally a path 0 only metric unless\n   337\t    ``path`` is overridden.\n   338\t    \"\"\"\n   339\t\n   340\t    arr = np.asarray(returns, dtype=np.float64)\n   341\t    if arr.ndim == 1:\n   342\t        series = arr\n   343\t    else:\n   344\t        if not (0 <= path < arr.shape[0]):\n   345\t            raise IndexError(\"path index out of range\")\n   346\t        series = arr[path]\n   347\t    return int(np.sum(series < threshold))\n   348\t\n   349\t\n   350\tdef breach_count(returns: ArrayLike, threshold: float, *, path: int = 0) -> int:\n   351\t    \"\"\"Deprecated alias for :func:`breach_count_path0` (path 0 only).\"\"\"\n   352\t    warnings.warn(\n   353\t        \"breach_count is deprecated; use breach_count_path0 (path 0 only)\",\n   354\t        DeprecationWarning,\n   355\t        stacklevel=2,\n   356\t    )\n   357\t    return breach_count_path0(returns, threshold, path=path)\n   358\t\n   359\t\n   360\tdef conditional_value_at_risk(returns: ArrayLike, confidence: float = 0.95) -> float:\n   361\t    \"\"\"Return monthly conditional VaR (expected shortfall) at ``confidence``.\n   362\t\n   363\t    The VaR cutoff uses the lower quantile (discrete \"floor\") at\n   364\t    ``1 - confidence``. The tail is defined strictly below that cutoff\n   365\t    (``returns < VaR``), so observations equal to the VaR are excluded. If the\n   366\t    strict tail is empty (for example when all observations equal the VaR), the\n   367\t    function falls back to returning the VaR itself.\n   368\t\n   369\t    The function operates on the flattened input array. For monthly returns\n   370\t    this corresponds to CVaR across all monthly draws. This is a monthly-draw\n   371\t    metric, not a terminal outcome metric.\n   372\t    \"\"\"\n   373\t\n   374\t    if not 0 < confidence < 1:\n   375\t        raise ValueError(\"confidence must be between 0 and 1\")\n   376\t    flat = np.asarray(returns).reshape(-1)\n   377\t    percentile = np.quantile(flat, 1 - confidence, method=\"lower\")\n   378\t    tail = flat[flat < percentile]\n   379\t    if tail.size == 0:\n   380\t        return float(percentile)\n   381\t    return float(np.mean(tail))\n   382\t\n   383\t\n   384\tdef cvar_monthly(returns: ArrayLike, confidence: float = 0.95) -> float:\n   385\t    \"\"\"Return monthly CVaR computed over all monthly draws (paths x months).\n   386\t\n   387\t    Each month of every path contributes equally; this is not a terminal CVaR.\n   388\t    \"\"\"\n   389\t    return conditional_value_at_risk(returns, confidence=confidence)\n   390\t\n   391\t\n   392\tdef cvar_terminal(\n   393\t    returns: ArrayLike, confidence: float = 0.95, *, periods_per_year: int = 12\n   394\t) -> float:\n   395\t    \"\"\"Return terminal CVaR computed from horizon compounded outcomes.\n   396\t\n   397\t    The CVaR is computed over one terminal compounded return per path. This is\n   398\t    a terminal-outcome metric (one draw per path).\n   399\t    \"\"\"\n   400\t    arr = np.asarray(returns, dtype=np.float64)\n   401\t    if arr.size == 0:\n   402\t        raise ValueError(\"returns must not be empty\")\n   403\t    if arr.ndim == 1:\n   404\t        terminal = compound(arr[None, :])[:, -1]\n   405\t    else:\n   406\t        terminal = compound(arr)[:, -1]\n   407\t    return conditional_value_at_risk(terminal, confidence=confidence)\n   408\t\n   409\t\n   410\tdef metric_standard_error(values: ArrayLike) -> float:\n   411\t    \"\"\"Return the Monte Carlo standard error of a scalar estimate sample.\n   412\t\n   413\t    ``values`` should contain independent path-level or draw-level estimates of\n   414\t    the same quantity. The function reports ``sample_std / sqrt(n)`` with\n   415\t    ``ddof=1`` and returns ``0.0`` for a single observation.\n   416\t    \"\"\"\n   417\t\n   418\t    arr = np.asarray(values, dtype=np.float64).reshape(-1)\n   419\t    if arr.size == 0:\n   420\t        raise ValueError(\"values must not be empty\")\n   421\t    if arr.size == 1:\n   422\t        return 0.0\n   423\t    return float(np.std(arr, ddof=1) / np.sqrt(arr.size))\n   424\t\n   425\t\n   426\tdef _cvar_tail_values(returns: ArrayLike, confidence: float = 0.95) -> ArrayLike:\n   427\t    if not 0 < confidence < 1:\n   428\t        raise ValueError(\"confidence must be between 0 and 1\")\n   429\t    flat = np.asarray(returns, dtype=np.float64).reshape(-1)\n   430\t    if flat.size == 0:\n   431\t        raise ValueError(\"returns must not be empty\")\n   432\t    cutoff = np.quantile(flat, 1 - confidence, method=\"lower\")\n   433\t    tail = flat[flat < cutoff]\n   434\t    return cast(ArrayLike, tail)\n   435\t\n   436\t\n   437\tdef cvar_standard_error(returns: ArrayLike, confidence: float = 0.95) -> float:\n   438\t    \"\"\"Return a sampling-error diagnostic for the CVaR tail mean.\n   439\t\n   440\t    The estimate is the standard error of the returns that fall beyond the same\n   441\t    strict lower-tail cutoff used by :func:`conditional_value_at_risk`. It is a\n   442\t    Monte Carlo precision diagnostic, not model risk. If fewer than two strict\n   443\t    tail observations are available, the diagnostic is undefined and returns\n   444\t    ``NaN`` rather than implying zero sampling error.\n   445\t    \"\"\"\n   446\t\n   447\t    tail = np.asarray(_cvar_tail_values(returns, confidence=confidence), dtype=np.float64)\n   448\t    if tail.size < 2:\n   449\t        return float(\"nan\")\n   450\t    return metric_standard_error(tail)\n   451\t\n   452\t\n   453\tdef cvar_confidence_interval(\n   454\t    returns: ArrayLike,\n   455\t    confidence: float = 0.95,\n   456\t    *,\n   457\t    interval_confidence: float = 0.95,\n   458\t) -> tuple[float, float]:\n   459\t    \"\"\"Return a normal-approximation confidence interval around CVaR.\"\"\"\n   460\t\n   461\t    if not 0 < interval_confidence < 1:\n   462\t        raise ValueError(\"interval_confidence must be between 0 and 1\")\n   463\t    center = conditional_value_at_risk(returns, confidence=confidence)\n   464\t    se = cvar_standard_error(returns, confidence=confidence)\n   465\t    z = NormalDist().inv_cdf(0.5 + interval_confidence / 2.0)\n   466\t    return (float(center - z * se), float(center + z * se))\n   467\t\n   468\t\n   469\tdef monte_carlo_convergence_diagnostic(\n   470\t    returns: ArrayLike,\n   471\t    *,\n   472\t    metric: str = \"terminal_CVaR\",\n   473\t    confidence: float = 0.95,\n   474\t    checkpoints: tuple[float, ...] = (0.25, 0.5, 0.75, 1.0),\n   475\t    periods_per_year: int = 12,\n   476\t) -> pd.DataFrame:\n   477\t    \"\"\"Return metric estimates at increasing path-count checkpoints.\n   478\t\n   479\t    ``returns`` must be shaped ``(paths, months)``. The diagnostic makes\n   480\t    convergence visible by recomputing a selected metric on the first N paths at\n   481\t    each checkpoint and reporting the absolute delta from the full-sample value.\n   482\t    \"\"\"\n   483\t\n   484\t    arr = np.asarray(returns, dtype=np.float64)\n   485\t    if arr.size == 0:\n   486\t        raise ValueError(\"returns must not be empty\")\n   487\t    if arr.ndim == 1:\n   488\t        arr = arr.reshape(1, -1)\n   489\t    if arr.ndim != 2:\n   490\t        raise ValueError(\"returns must be a 1D or 2D array\")\n   491\t    if not checkpoints:\n   492\t        raise ValueError(\"checkpoints must not be empty\")\n   493\t    if any(checkpoint <= 0.0 or checkpoint > 1.0 for checkpoint in checkpoints):\n   494\t        raise ValueError(\"checkpoints must be in the interval (0, 1]\")\n   495\t\n   496\t    def estimate(sample: ArrayLike) -> float:\n   497\t        if metric == \"terminal_CVaR\":\n   498\t            return cvar_terminal(sample, confidence=confidence, periods_per_year=periods_per_year)\n   499\t        if metric == \"monthly_CVaR\":\n   500\t            return cvar_monthly(sample, confidence=confidence)\n   501\t        if metric == \"terminal_AnnReturn\":\n   502\t            return annualised_return(sample, periods_per_year=periods_per_year)\n   503\t        raise ValueError(\n   504\t            'metric must be one of \"terminal_CVaR\", \"monthly_CVaR\", or \"terminal_AnnReturn\"'\n   505\t        )\n   506\t\n   507\t    full_estimate = estimate(arr)\n   508\t    rows = []\n   509\t    path_count = arr.shape[0]\n   510\t    for checkpoint in checkpoints:\n   511\t        sample_paths = max(1, int(np.ceil(path_count * checkpoint)))\n   512\t        sample_estimate = estimate(arr[:sample_paths])\n   513\t        rows.append(\n   514\t            {\n   515\t                \"metric\": metric,\n   516\t                \"checkpoint\": float(checkpoint),\n   517\t                \"paths\": int(sample_paths),\n   518\t                \"estimate\": sample_estimate,\n   519\t                \"full_sample_estimate\": full_estimate,\n   520\t                \"abs_delta_from_full\": abs(sample_estimate - full_estimate),\n   521\t            }\n   522\t        )\n   523\t    return pd.DataFrame(rows)\n   524\t\n   525\t\n   526\tdef max_cumulative_sum_drawdown(returns: ArrayLike) -> float:\n   527\t    \"\"\"Return the worst drawdown observed over the full compounded horizon.\n   528\t\n   529\t    Drawdowns are computed on compounded monthly wealth paths, and the minimum\n   530\t    drawdown across all paths and periods is returned (monthly-path semantics).\n   531\t    This is a monthly-path metric, not a terminal-only metric.\n   532\t    \"\"\"\n   533\t\n   534\t    arr = np.asarray(returns, dtype=np.float64)\n   535\t    if arr.size == 0:\n   536\t        raise ValueError(\"returns must not be empty\")\n   537\t    if arr.ndim == 1:\n   538\t        arr = arr[None, :]\n   539\t    compounded = compound(arr)\n   540\t    wealth = 1.0 + compounded\n   541\t    # Include the initial wealth so the first-period drop is measured correctly.\n   542\t    wealth = np.concatenate([np.ones((wealth.shape[0], 1)), wealth], axis=1)\n   543\t    running_max = np.maximum.accumulate(wealth, axis=1)\n   544\t    drawdown = wealth / running_max - 1.0\n   545\t    return float(np.min(drawdown))\n   546\t\n   547\t\n   548\tdef max_drawdown(returns: ArrayLike) -> float:\n   549\t    \"\"\"Deprecated alias for :func:`max_cumulative_sum_drawdown` (monthly-path metric).\"\"\"\n   550\t    warnings.warn(\n   551\t        \"max_drawdown is deprecated; use max_cumulative_sum_drawdown\",\n   552\t        DeprecationWarning,\n   553\t        stacklevel=2,\n   554\t    )\n   555\t    return max_cumulative_sum_drawdown(returns)\n   556\t\n   557\t\n   558\tdef compounded_return_below_zero_fraction(returns: ArrayLike) -> float:\n   559\t    \"\"\"Return fraction of monthly periods with negative compounded return.\n   560\t\n   561\t    The fraction is computed over all (path, month) compounded outcomes, so\n   562\t    each monthly draw is weighted equally.\n   563\t    \"\"\"\n   564\t\n   565\t    comp = compound(returns)\n   566\t    return float(np.mean(comp < 0.0))\n   567\t\n   568\t\n   569\tdef time_under_water(returns: ArrayLike) -> float:\n   570\t    \"\"\"Deprecated alias for :func:`compounded_return_below_zero_fraction` (monthly-draw metric).\"\"\"\n   571\t    warnings.warn(\n   572\t        \"time_under_water is deprecated; use compounded_return_below_zero_fraction\",\n   573\t        DeprecationWarning,\n   574\t        stacklevel=2,\n   575\t    )\n   576\t    return compounded_return_below_zero_fraction(returns)\n   577\t\n   578\t\n   579\tdef summary_table(\n   580\t    returns_map: Mapping[str, ArrayLike],\n   581\t    *,\n   582\t    periods_per_year: int = 12,\n   583\t    var_conf: float = 0.95,\n   584\t    breach_threshold: float = DEFAULT_BREACH_THRESHOLD,\n   585\t    shortfall_threshold: float = DEFAULT_SHORTFALL_THRESHOLD,\n   586\t    benchmark: str | None = None,\n   587\t) -> pd.DataFrame:\n   588\t    \"\"\"Return a summary DataFrame of key metrics for each agent.\n   589\t\n   590\t    Output columns are prefixed with ``monthly_`` when computed from the full\n   591\t    distribution of monthly draws, and ``terminal_`` when computed from\n   592\t    terminal compounded outcomes.\n   593\t\n   594\t    Parameters\n   595\t    ----------\n   596\t    returns_map:\n   597\t        Mapping of agent name to monthly return series (shape: paths x months).\n   598\t        terminal_AnnReturn, monthly_AnnVol, and monthly_TE outputs are annualised\n   599\t        using ``periods_per_year``.\n   600\t    breach_threshold:\n   601\t        Monthly return threshold for :func:`breach_probability`, which reports\n   602\t        the share of all simulated months across paths that breach. Defaults to\n   603\t        the module-level default in :mod:`pa_core.units`.\n   604\t    shortfall_threshold:\n   605\t        Annualised threshold for :func:`terminal_return_below_threshold_prob`.\n   606\t        Defaults to the module-level default in :mod:`pa_core.units`.\n   607\t\n   608\t    Notes\n   609\t    -----\n   610\t    ``monthly_BreachCountPath0`` is a path 0 diagnostic count (not a cross-path\n   611\t    expectation) and is included for debugging parity with legacy outputs.\n   612\t    \"\"\"\n   613\t\n   614\t    returns = returns_map\n   615\t    if benchmark and \"Total\" not in returns_map and benchmark in returns_map:\n   616\t        from ..portfolio import compute_total_contribution_returns\n   617\t\n   618\t        total = compute_total_contribution_returns(returns_map)\n   619\t        if total is not None:\n   620\t            returns = dict(returns_map)\n   621\t            returns[\"Total\"] = total\n   622\t\n   623\t    rows = []\n   624\t    bench_arr = returns.get(benchmark) if benchmark else None\n   625\t    bench_ann_ret = (\n   626\t        annualised_return(bench_arr, periods_per_year) if bench_arr is not None else None\n   627\t    )\n   628\t    for name, arr in returns.items():\n   629\t        ann_ret = annualised_return(arr, periods_per_year)\n   630\t        ann_ret_p50 = annualised_return_percentile(arr, 50, periods_per_year)\n   631\t        ann_ret_p10 = annualised_return_percentile(arr, 10, periods_per_year)\n   632\t        ann_ret_p90 = annualised_return_percentile(arr, 90, periods_per_year)\n   633\t        ann_vol = annualised_vol(arr, periods_per_year)\n   634\t        excess_return = ann_ret - bench_ann_ret if bench_ann_ret is not None else ann_ret\n   635\t        var = value_at_risk(arr, confidence=var_conf)\n   636\t        cvar_month = cvar_monthly(arr, confidence=var_conf)\n   637\t        cvar_term = cvar_terminal(arr, confidence=var_conf, periods_per_year=periods_per_year)\n   638\t        cvar_month_se = cvar_standard_error(arr, confidence=var_conf)\n   639\t        cvar_month_ci_low, cvar_month_ci_high = cvar_confidence_interval(\n   640\t            arr,\n   641\t            confidence=var_conf,\n   642\t        )\n   643\t        arr_np = np.asarray(arr, dtype=np.float64)\n   644\t        terminal_returns = compound(arr_np if arr_np.ndim == 2 else arr_np[None, :])[:, -1]\n   645\t        cvar_term_se = cvar_standard_error(terminal_returns, confidence=var_conf)\n   646\t        cvar_term_ci_low, cvar_term_ci_high = cvar_confidence_interval(\n   647\t            terminal_returns,\n   648\t            confidence=var_conf,\n   649\t        )\n   650\t        convergence = monte_carlo_convergence_diagnostic(\n   651\t            arr_np,\n   652\t            metric=\"terminal_CVaR\",\n   653\t            confidence=var_conf,\n   654\t            periods_per_year=periods_per_year,\n   655\t            checkpoints=(0.5, 1.0),\n   656\t        )\n   657\t        terminal_cvar_half_delta = float(convergence[\"abs_delta_from_full\"].iloc[0])\n   658\t        breach = breach_probability(arr, breach_threshold)\n   659\t        bcount = breach_count_path0(arr, breach_threshold)\n   660\t        shortfall = terminal_return_below_threshold_prob(\n   661\t            arr,\n   662\t            shortfall_threshold,\n   663\t            periods_per_year=periods_per_year,\n   664\t        )\n   665\t        mdd = max_cumulative_sum_drawdown(arr)\n   666\t        tuw = compounded_return_below_zero_fraction(arr)\n   667\t        te = (\n   668\t            active_return_volatility(arr, bench_arr, periods_per_year=periods_per_year)\n   669\t            if bench_arr is not None and name != benchmark\n   670\t            else None\n   671\t        )\n   672\t        te_per_path = (\n   673\t            per_path_active_return_volatility(arr, bench_arr, periods_per_year=periods_per_year)\n   674\t            if bench_arr is not None and name != benchmark\n   675\t            else None\n   676\t        )\n   677\t        extras = {k: fn(arr) for k, fn in _EXTRA_METRICS.items()}\n   678\t        rows.append(\n   679\t            {\n   680\t                \"Agent\": name,\n   681\t                \"terminal_AnnReturn\": ann_ret,\n   682\t                \"terminal_AnnReturn_P50\": ann_ret_p50,\n   683\t                \"terminal_AnnReturn_P10\": ann_ret_p10,\n   684\t                \"terminal_AnnReturn_P90\": ann_ret_p90,\n   685\t                \"terminal_ExcessReturn\": excess_return,\n   686\t                \"monthly_AnnVol\": ann_vol,\n   687\t                \"monthly_VaR\": var,\n   688\t                \"monthly_CVaR\": cvar_month,\n   689\t                \"monthly_CVaR_SE\": cvar_month_se,\n   690\t                \"monthly_CVaR_CI95_Low\": cvar_month_ci_low,\n   691\t                \"monthly_CVaR_CI95_High\": cvar_month_ci_high,\n   692\t                \"terminal_CVaR\": cvar_term,\n   693\t                \"terminal_CVaR_SE\": cvar_term_se,\n   694\t                \"terminal_CVaR_CI95_Low\": cvar_term_ci_low,\n   695\t                \"terminal_CVaR_CI95_High\": cvar_term_ci_high,\n   696\t                \"terminal_CVaR_HalfSampleDelta\": terminal_cvar_half_delta,\n   697\t                \"monthly_MaxDD\": mdd,\n   698\t                \"monthly_TimeUnderWater\": tuw,\n   699\t                \"monthly_BreachProb\": breach,\n   700\t                \"monthly_BreachCountPath0\": bcount,\n   701\t                \"terminal_ShortfallProb\": shortfall,\n   702\t                \"monthly_TE\": te,\n   703\t                \"monthly_TE_PerPath\": te_per_path,\n   704\t                **extras,\n   705\t            }\n   706\t        )\n   707\t\n   708\t    df = pd.DataFrame(rows)\n   709\t    return df\n   710\t\n   711\t\n   712\t_METRIC_DEFINITIONS = [\n   713\t    {\n   714\t        \"Metric\": \"terminal_AnnReturn\",\n   715\t        \"MetricType\": \"terminal_outcome\",\n   716\t        \"Description\": (\n   717\t            \"Annualized compounded return from the mean of terminal outcomes \"\n   718\t            \"(an E[wealth]-style average a typical path does not resemble).\"\n   719\t        ),\n   720\t    },\n   721\t    {\n   722\t        \"Metric\": \"terminal_AnnReturn_P50\",\n   723\t        \"MetricType\": \"terminal_outcome\",\n   724\t        \"Description\": (\n   725\t            \"Median annualized compounded return (CAGR) across paths; the \"\n   726\t            \"outcome a typical path resembles.\"\n   727\t        ),\n   728\t    },\n   729\t    {\n   730\t        \"Metric\": \"terminal_AnnReturn_P10\",\n   731\t        \"MetricType\": \"terminal_outcome\",\n   732\t        \"Description\": \"10th-percentile annualized compounded return across paths.\",\n   733\t    },\n   734\t    {\n   735\t        \"Metric\": \"terminal_AnnReturn_P90\",\n   736\t        \"MetricType\": \"terminal_outcome\",\n   737\t        \"Description\": \"90th-percentile annualized compounded return across paths.\",\n   738\t    },\n   739\t    {\n   740\t        \"Metric\": \"terminal_ExcessReturn\",\n   741\t        \"MetricType\": \"terminal_outcome\",\n   742\t        \"Description\": \"Annualized return minus benchmark annualized return.\",\n   743\t    },\n   744\t    {\n   745\t        \"Metric\": \"monthly_AnnVol\",\n   746\t        \"MetricType\": \"monthly_draw\",\n   747\t        \"Description\": \"Annualized volatility from monthly return draws.\",\n   748\t    },\n   749\t    {\n   750\t        \"Metric\": \"monthly_VaR\",\n   751\t        \"MetricType\": \"monthly_draw\",\n   752\t        \"Description\": \"Monthly value at risk at configured confidence.\",\n   753\t    },\n   754\t    {\n   755\t        \"Metric\": \"monthly_CVaR\",\n   756\t        \"MetricType\": \"monthly_draw\",\n   757\t        \"Description\": \"Monthly conditional value at risk at configured confidence.\",\n   758\t    },\n   759\t    {\n   760\t        \"Metric\": \"monthly_CVaR_SE\",\n   761\t        \"MetricType\": \"diagnostic\",\n   762\t        \"Description\": \"Monte Carlo standard error of the monthly CVaR tail mean.\",\n   763\t    },\n   764\t    {\n   765\t        \"Metric\": \"monthly_CVaR_CI95_Low\",\n   766\t        \"MetricType\": \"diagnostic\",\n   767\t        \"Description\": \"Lower bound of the normal-approximation 95% interval around monthly CVaR.\",\n   768\t    },\n   769\t    {\n   770\t        \"Metric\": \"monthly_CVaR_CI95_High\",\n   771\t        \"MetricType\": \"diagnostic\",\n   772\t        \"Description\": \"Upper bound of the normal-approximation 95% interval around monthly CVaR.\",\n   773\t    },\n   774\t    {\n   775\t        \"Metric\": \"terminal_CVaR\",\n   776\t        \"MetricType\": \"terminal_outcome\",\n   777\t        \"Description\": \"Conditional value at risk of terminal compounded outcomes.\",\n   778\t    },\n   779\t    {\n   780\t        \"Metric\": \"terminal_CVaR_SE\",\n   781\t        \"MetricType\": \"diagnostic\",\n   782\t        \"Description\": \"Monte Carlo standard error of the terminal CVaR tail mean.\",\n   783\t    },\n   784\t    {\n   785\t        \"Metric\": \"terminal_CVaR_CI95_Low\",\n   786\t        \"MetricType\": \"diagnostic\",\n   787\t        \"Description\": \"Lower bound of the normal-approximation 95% interval around terminal CVaR.\",\n   788\t    },\n   789\t    {\n   790\t        \"Metric\": \"terminal_CVaR_CI95_High\",\n   791\t        \"MetricType\": \"diagnostic\",\n   792\t        \"Description\": \"Upper bound of the normal-approximation 95% interval around terminal CVaR.\",\n   793\t    },\n   794\t    {\n   795\t        \"Metric\": \"terminal_CVaR_HalfSampleDelta\",\n   796\t        \"MetricType\": \"diagnostic\",\n   797\t        \"Description\": (\n   798\t            \"Absolute difference between terminal CVaR estimated on the first half \"\n   799\t            \"of paths and on the full Monte Carlo sample.\"\n   800\t        ),\n   801\t    },\n   802\t    {\n   803\t        \"Metric\": \"monthly_MaxDD\",\n   804\t        \"MetricType\": \"monthly_draw\",\n   805\t        \"Description\": \"Worst drawdown across compounded wealth paths.\",\n   806\t    },\n   807\t    {\n   808\t        \"Metric\": \"monthly_TimeUnderWater\",\n   809\t        \"MetricType\": \"monthly_draw\",\n   810\t        \"Description\": \"Fraction of months with negative compounded return.\",\n   811\t    },\n   812\t    {\n   813\t        \"Metric\": \"monthly_BreachProb\",\n   814\t        \"MetricType\": \"monthly_draw\",\n   815\t        \"Description\": \"Share of simulated months below the breach threshold.\",\n   816\t    },\n   817\t    {\n   818\t        \"Metric\": \"monthly_BreachCountPath0\",\n   819\t        \"MetricType\": \"diagnostic\",\n   820\t        \"Description\": \"Count of months below the breach threshold for path 0.\",\n   821\t    },\n   822\t    {\n   823\t        \"Metric\": \"terminal_ShortfallProb\",\n   824\t        \"MetricType\": \"terminal_outcome\",\n   825\t        \"Description\": \"Probability terminal compounded return is below the threshold.\",\n   826\t    },\n   827\t    {\n   828\t        \"Metric\": \"monthly_TE\",\n   829\t        \"MetricType\": \"monthly_draw\",\n   830\t        \"Description\": (\n   831\t            \"Annualized tracking error versus benchmark, pooling every \"\n   832\t            \"(path, month) active return into a single dispersion.\"\n   833\t        ),\n   834\t    },\n   835\t    {\n   836\t        \"Metric\": \"monthly_TE_PerPath\",\n   837\t        \"MetricType\": \"monthly_draw\",\n   838\t        \"Description\": (\n   839\t            \"Annualized tracking error averaged over per-path active-return \"\n   840\t            \"volatilities (excludes cross-path dispersion; typically lower than \"\n   841\t            \"monthly_TE).\"\n   842\t        ),\n   843\t    },\n   844\t]\n   845\t\n   846\t\n   847\tdef metric_definitions_df() -> pd.DataFrame:\n   848\t    \"\"\"Return a machine-readable table of standard summary metric definitions.\"\"\"\n   849\t    definitions = list(_METRIC_DEFINITIONS)\n   850\t    if _EXTRA_METRIC_DEFINITIONS:\n   851\t        existing = {definition[\"Metric\"] for definition in definitions}\n   852\t        for name, definition in _EXTRA_METRIC_DEFINITIONS.items():\n   853\t            if name not in existing:\n   854\t                definitions.append(definition)\n   855\t    return pd.DataFrame(definitions, columns=[\"Metric\", \"MetricType\", \"Description\"])\n--- sim paths financing ---\n     1\tfrom __future__ import annotations\n     2\t\n     3\timport logging\n     4\timport math\n     5\timport warnings\n     6\tfrom typing import Any, Dict, Mapping, Sequence, cast\n     7\t\n     8\timport numpy.typing as npt\n     9\tfrom numpy.typing import NDArray\n    10\t\n    11\tfrom ..backend import xp as np\n    12\tfrom ..types import GeneratorLike\n    13\tfrom ..validators import NUMERICAL_STABILITY_EPSILON\n    14\tfrom .financing import draw_financing_series, simulate_financing\n    15\tfrom .params import CANONICAL_PARAMS_MARKER, CANONICAL_PARAMS_VERSION\n    16\tfrom .simulation_initialization import ensure_rng\n    17\t\n    18\t__all__ = [\n    19\t    \"simulate_financing\",\n    20\t    \"prepare_mc_universe\",\n    21\t    \"prepare_return_shocks\",\n    22\t    \"draw_named_returns\",\n    23\t    \"draw_returns\",\n    24\t    \"draw_joint_returns\",\n    25\t    \"draw_financing_series\",\n    26\t    \"map_sleeve_alpha_streams\",\n    27\t    \"simulate_alpha_streams\",\n    28\t]\n    29\t\n    30\t\n    31\t_VALID_RETURN_DISTS = {\"normal\", \"student_t\"}\n    32\t_VALID_RETURN_COPULAS = {\"gaussian\", \"t\"}\n    33\t_CORR_VALIDATION_TOL = 1e-8\n    34\t\n    35\tlogger = logging.getLogger(__name__)\n    36\t\n    37\t\n    38\tdef _coerce_return_t_df(t_df: Any) -> float:\n    39\t    try:\n    40\t        value = float(t_df)\n    41\t    except (TypeError, ValueError, OverflowError):\n    42\t        raise ValueError(\n    43\t            \"return_t_df must be finite and greater than 2 for finite variance\"\n    44\t        ) from None\n    45\t    if not math.isfinite(value):\n    46\t        raise ValueError(\"return_t_df must be finite and greater than 2 for finite variance\")\n    47\t    return value\n    48\t\n    49\t\n    50\tdef _validate_return_draw_settings(\n    51\t    distribution: str | Sequence[str], copula: str, t_df: Any\n    52\t) -> float:\n    53\t    if isinstance(distribution, str):\n    54\t        distributions: tuple[str, ...] = (distribution,)\n    55\t    else:\n    56\t        distributions = tuple(distribution)\n    57\t    for dist in distributions:\n    58\t        if dist not in _VALID_RETURN_DISTS:\n    59\t            raise ValueError(f\"return_distribution must be one of: {sorted(_VALID_RETURN_DISTS)}\")\n    60\t    if copula not in _VALID_RETURN_COPULAS:\n    61\t        raise ValueError(f\"return_copula must be one of: {sorted(_VALID_RETURN_COPULAS)}\")\n    62\t    if all(dist == \"normal\" for dist in distributions) and copula != \"gaussian\":\n    63\t        raise ValueError(\"return_copula must be 'gaussian' when return_distribution is 'normal'\")\n    64\t    t_df_value = _coerce_return_t_df(t_df)\n    65\t    if any(dist == \"student_t\" for dist in distributions):\n    66\t        if t_df_value <= 2.0:\n    67\t            raise ValueError(\"return_t_df must be finite and greater than 2 for finite variance\")\n    68\t    return t_df_value\n    69\t\n    70\t\n    71\tdef _resolve_return_distributions(\n    72\t    base: str, overrides: Sequence[str | None] | None = None\n    73\t) -> tuple[str, str, str, str]:\n    74\t    if overrides is None:\n    75\t        return (base, base, base, base)\n    76\t    if len(overrides) != 4:\n    77\t        raise ValueError(\"return_distributions must have length 4\")\n    78\t    return (\n    79\t        overrides[0] or base,\n    80\t        overrides[1] or base,\n    81\t        overrides[2] or base,\n    82\t        overrides[3] or base,\n    83\t    )\n    84\t\n    85\t\n    86\tdef _resolve_stream_return_distributions(\n    87\t    base: str,\n    88\t    stream_names: Sequence[str],\n    89\t    overrides: Mapping[str, str | None] | Sequence[str | None] | None = None,\n    90\t) -> tuple[str, ...]:\n    91\t    if overrides is None:\n    92\t        return tuple(base for _ in stream_names)\n    93\t    if isinstance(overrides, Mapping):\n    94\t        return tuple(overrides.get(name) or base for name in stream_names)\n    95\t    if len(overrides) != len(stream_names):\n    96\t        raise ValueError(\"return_distributions must have the same length as stream_names\")\n    97\t    return tuple(dist or base for dist in overrides)\n    98\t\n    99\t\n   100\tdef _validate_correlation_matrix(corr: NDArray[Any]) -> None:\n   101\t    if not np.all(np.isfinite(corr)):\n   102\t        raise ValueError(\"Correlation matrix contains non-finite values\")\n   103\t    min_val = float(np.min(corr))\n   104\t    max_val = float(np.max(corr))\n   105\t    if min_val < -1.0 - _CORR_VALIDATION_TOL or max_val > 1.0 + _CORR_VALIDATION_TOL:\n   106\t        raise ValueError(\n   107\t            \"Correlation matrix values must be within [-1, 1]\"\n   108\t            f\"; min={min_val:.3f}, max={max_val:.3f}\"\n   109\t        )\n   110\t    diag = np.diag(corr)\n   111\t    if not np.allclose(diag, 1.0, atol=_CORR_VALIDATION_TOL):\n   112\t        idx = int(np.argmax(np.abs(diag - 1.0)))\n   113\t        raise ValueError(f\"Correlation matrix diagonal must be 1; idx {idx} has {diag[idx]:.6f}\")\n   114\t\n   115\t\n   116\tdef _validate_covariance_matrix(cov: NDArray[Any]) -> NDArray[Any]:\n   117\t    if not np.all(np.isfinite(cov)):\n   118\t        raise ValueError(\"Covariance matrix contains non-finite values\")\n   119\t    covariance = np.asarray(cov, dtype=float)\n   120\t    precision = (\n   121\t        np.finfo(cov.dtype).eps if np.issubdtype(cov.dtype, np.floating) else np.finfo(float).eps\n   122\t    )\n   123\t    symmetry_tolerance = max(float(precision), np.finfo(float).eps)\n   124\t    local_scale = np.maximum(np.abs(covariance), np.abs(covariance.T))\n   125\t    normalized = np.divide(\n   126\t        covariance,\n   127\t        local_scale,\n   128\t        out=np.zeros_like(covariance),\n   129\t        where=local_scale != 0.0,\n   130\t    )\n   131\t    if np.any(np.abs(normalized - normalized.T) > symmetry_tolerance):\n   132\t        raise ValueError(\"Covariance matrix must be symmetric\")\n   133\t    upper = np.triu_indices_from(covariance, k=1)\n   134\t    lower = (upper[1], upper[0])\n   135\t    midpoints = covariance[upper] + 0.5 * (covariance[lower] - covariance[upper])\n   136\t    covariance = covariance.copy()\n   137\t    covariance[upper] = covariance[lower] = midpoints\n   138\t    variances = np.diag(covariance).copy()\n   139\t    if np.any(variances < 0.0):\n   140\t        raise ValueError(\"Covariance matrix variances must be non-negative\")\n   141\t    positive_variance = variances > 0.0\n   142\t    if np.any(covariance[~positive_variance, :] != 0.0):\n   143\t        raise ValueError(\n   144\t            \"Covariance matrix must be positive semidefinite; zero variance requires zero covariance\"\n   145\t        )\n   146\t    if not np.any(positive_variance):\n   147\t        return cast(npt.NDArray[Any], covariance)\n   148\t    standard_deviations = np.sqrt(variances[positive_variance])\n   149\t    denominator = np.outer(standard_deviations, standard_deviations)\n   150\t    positive_covariance = covariance[np.ix_(positive_variance, positive_variance)]\n   151\t    correlation = positive_covariance / denominator\n   152\t    if np.any(np.abs(correlation) > 1.0 + symmetry_tolerance):\n   153\t        raise ValueError(\n   154\t            \"Covariance matrix must be positive semidefinite; absolute correlation cannot exceed 1\"\n   155\t        )\n   156\t    min_eigenvalue = float(np.linalg.eigvalsh(correlation).min())\n   157\t    if min_eigenvalue >= 0.0:\n   158\t        return cast(npt.NDArray[Any], covariance)\n   159\t    eigenvalues, eigenvectors = np.linalg.eigh(correlation)\n   160\t    negative = eigenvalues < 0.0\n   161\t    negative_eigenvectors = eigenvectors[:, negative]\n   162\t    negative_vectors = np.abs(negative_eigenvectors)\n   163\t    # Bound each negative Rayleigh quotient by its own entrywise input-rounding\n   164\t    # uncertainty plus the observed eigensolver residual.  The latter keeps a\n   165\t    # PSD matrix consumable when eigvalsh and eigh differ at machine precision,\n   166\t    # without importing scale from unrelated covariance blocks.\n   167\t    rounding_tolerance = symmetry_tolerance * np.sum(\n   168\t        negative_vectors * (np.abs(correlation) @ negative_vectors), axis=0\n   169\t    )\n   170\t    eigensolver_residual = np.linalg.norm(\n   171\t        correlation @ negative_eigenvectors - negative_eigenvectors * eigenvalues[negative],\n   172\t        axis=0,\n   173\t    )\n   174\t    rounding_tolerance += eigensolver_residual\n   175\t    invalid = eigenvalues[negative] < -rounding_tolerance\n   176\t    if np.any(invalid):\n   177\t        invalid_min_eigenvalue = float(np.min(eigenvalues[negative][invalid]))\n   178\t        raise ValueError(\n   179\t            \"Covariance matrix must be positive semidefinite\"\n   180\t            f\"; normalized min eigenvalue {invalid_min_eigenvalue:.3e}\"\n   181\t        )\n   182\t    correlation = (eigenvectors * np.clip(eigenvalues, 0.0, None)) @ eigenvectors.T\n   183\t    correlation_scale = np.sqrt(np.diag(correlation))\n   184\t    correlation /= np.outer(correlation_scale, correlation_scale)\n   185\t    covariance[np.ix_(positive_variance, positive_variance)] = correlation * denominator\n   186\t    np.fill_diagonal(covariance, variances)\n   187\t    return cast(npt.NDArray[Any], covariance)\n   188\t\n   189\t\n   190\tdef _validate_finite_means(mean: NDArray[Any]) -> None:\n   191\t    if not np.all(np.isfinite(mean)):\n   192\t        raise ValueError(\"Return means must contain only finite values\")\n   193\t\n   194\t\n   195\tdef _project_to_near_psd_correlation(corr: NDArray[Any]) -> NDArray[Any]:\n   196\t    sym = 0.5 * (corr + corr.T)\n   197\t    eigvals, eigvecs = np.linalg.eigh(sym)\n   198\t    eigvals_clipped = np.clip(eigvals, 0.0, None)\n   199\t    psd = eigvecs @ np.diag(eigvals_clipped) @ eigvecs.T\n   200\t    psd = 0.5 * (psd + psd.T)\n   201\t    diag = np.sqrt(np.clip(np.diag(psd), 0.0, None))\n   202\t    if np.any(diag <= 0.0):\n   203\t        raise ValueError(\"Correlation repair failed; non-positive diagonal after projection\")\n   204\t    denom = diag[:, None] * diag[None, :]\n   205\t    repaired = np.divide(psd, denom, out=np.eye(psd.shape[0]), where=denom != 0.0)\n   206\t    repaired = 0.5 * (repaired + repaired.T)\n   207\t    np.fill_diagonal(repaired, 1.0)\n   208\t    return cast(NDArray[Any], repaired)\n   209\t\n   210\t\n   211\tdef _resolve_correlation_matrix(params: Dict[str, Any]) -> tuple[NDArray[Any], dict[str, Any]]:\n   212\t    corr = np.array(\n   213\t        [\n   214\t            [1.0, params[\"rho_idx_H\"], params[\"rho_idx_E\"], params[\"rho_idx_M\"]],\n   215\t            [params[\"rho_idx_H\"], 1.0, params[\"rho_H_E\"], params[\"rho_H_M\"]],\n   216\t            [params[\"rho_idx_E\"], params[\"rho_H_E\"], 1.0, params[\"rho_E_M\"]],\n   217\t            [params[\"rho_idx_M\"], params[\"rho_H_M\"], params[\"rho_E_M\"], 1.0],\n   218\t        ],\n   219\t        dtype=float,\n   220\t    )\n   221\t    corr = 0.5 * (corr + corr.T)\n   222\t    _validate_correlation_matrix(corr)\n   223\t\n   224\t    repair_mode = params.get(\"correlation_repair_mode\", \"warn_fix\")\n   225\t    if repair_mode not in {\"error\", \"warn_fix\"}:\n   226\t        raise ValueError(\"correlation_repair_mode must be 'error' or 'warn_fix'\")\n   227\t    shrinkage = float(params.get(\"correlation_repair_shrinkage\", 0.0) or 0.0)\n   228\t    if not 0.0 <= shrinkage <= 1.0:\n   229\t        raise ValueError(\"correlation_repair_shrinkage must be between 0 and 1\")\n   230\t\n   231\t    eigvals_input = np.linalg.eigvalsh(corr)\n   232\t    min_eig_input = float(eigvals_input.min())\n   233\t\n   234\t    corr_work = corr\n   235\t    applied_steps: list[str] = []\n   236\t    if shrinkage > 0.0:\n   237\t        corr_work = (1.0 - shrinkage) * corr_work + shrinkage * np.eye(corr.shape[0])\n   238\t        applied_steps.append(\"shrinkage\")\n   239\t\n   240\t    eigvals_work = np.linalg.eigvalsh(corr_work)\n   241\t    min_eig_work = float(eigvals_work.min())\n   242\t    repaired = corr_work\n   243\t    if min_eig_work < -_CORR_VALIDATION_TOL:\n   244\t        if repair_mode == \"error\":\n   245\t            raise ValueError(f\"Correlation matrix is not PSD; min eigenvalue {min_eig_work:.3e}.\")\n   246\t        repaired = _project_to_near_psd_correlation(corr_work)\n   247\t        applied_steps.append(\"eigen_clip\")\n   248\t    eigvals_after = np.linalg.eigvalsh(repaired)\n   249\t    min_eig_after = float(eigvals_after.min())\n   250\t    max_delta = float(np.max(np.abs(repaired - corr)))\n   251\t    repair_applied = bool(applied_steps)\n   252\t    max_delta_threshold = params.get(\"correlation_repair_max_abs_delta\")\n   253\t    if max_delta_threshold is not None and repair_applied:\n   254\t        max_delta_threshold = float(max_delta_threshold)\n   255\t        if max_delta > max_delta_threshold:\n   256\t            raise ValueError(\n   257\t                \"Correlation repair max_abs_delta \"\n   258\t                f\"{max_delta:.3e} exceeds correlation_repair_max_abs_delta \"\n   259\t                f\"{max_delta_threshold:.3e}.\"\n   260\t            )\n   261\t\n   262\t    info = {\n   263\t        \"repair_applied\": repair_applied,\n   264\t        \"repair_mode\": repair_mode,\n   265\t        \"method\": \"none\" if not applied_steps else \"+\".join(applied_steps),\n   266\t        \"shrinkage\": shrinkage,\n   267\t        \"min_eigenvalue_before\": min_eig_input,\n   268\t        \"min_eigenvalue_after\": min_eig_after,\n   269\t        \"max_abs_delta\": max_delta,\n   270\t        \"corr_before\": corr.tolist(),\n   271\t        \"corr_after\": repaired.tolist(),\n   272\t        \"corr_delta\": (repaired - corr).tolist(),\n   273\t    }\n   274\t    params[\"_correlation_repair_info\"] = info\n   275\t\n   276\t    if repair_applied:\n   277\t        logger.warning(\n   278\t            \"Correlation repair applied: mode=%s, method=%s, shrinkage=%.3f, \"\n   279\t            \"min_eig_before=%.3e, min_eig_after=%.3e, max_abs_delta=%.3e\",\n   280\t            repair_mode,\n   281\t            info[\"method\"],\n   282\t            shrinkage,\n   283\t            min_eig_input,\n   284\t            min_eig_after,\n   285\t            max_delta,\n   286\t        )\n   287\t    return repaired, info\n   288\t\n   289\t\n   290\tdef _safe_multivariate_normal(\n   291\t    rng: GeneratorLike,\n   292\t    mean: npt.NDArray[Any],\n   293\t    cov: npt.NDArray[Any],\n   294\t    size: tuple[int, int],\n   295\t) -> npt.NDArray[Any]:\n   296\t    try:\n   297\t        return cast(npt.NDArray[Any], rng.multivariate_normal(mean=mean, cov=cov, size=size))\n   298\t    except np.linalg.LinAlgError:\n   299\t        return cast(\n   300\t            npt.NDArray[Any],\n   301\t            rng.multivariate_normal(\n   302\t                mean=mean,\n   303\t                cov=cov + np.eye(len(mean)) * NUMERICAL_STABILITY_EPSILON,\n   304\t                size=size,\n   305\t            ),\n   306\t        )\n   307\t\n   308\t\n   309\tdef _draw_student_t(\n   310\t    *,\n   311\t    rng: GeneratorLike,\n   312\t    mean: npt.NDArray[Any],\n   313\t    sigma: npt.NDArray[Any],\n   314\t    corr: npt.NDArray[Any],\n   315\t    size: tuple[int, int],\n   316\t    df: float,\n   317\t    copula: str,\n   318\t) -> npt.NDArray[Any]:\n   319\t    n_dim = mean.size\n   320\t    z = _safe_multivariate_normal(rng, np.zeros(n_dim), corr, size)\n   321\t    scale = np.sqrt((df - 2.0) / df)\n   322\t    if copula == \"t\":\n   323\t        chi = rng.chisquare(df, size=size)\n   324\t        denom = np.sqrt(chi / df)[..., None]\n   325\t    else:\n   326\t        chi = rng.chisquare(df, size=(*size, n_dim))\n   327\t        denom = np.sqrt(chi / df)\n   328\t    shocks = z * (scale / denom)\n   329\t    return cast(npt.NDArray[Any], mean + shocks * sigma)\n   330\t\n","exit_code":0,"status":"completed"}}
