ionary mapping alias -> field_name\n    98\t    \"\"\"\n    99\t    if model_class is None:\n   100\t        model_class = ModelConfig\n   101\t\n   102\t    mappings = {}\n   103\t\n   104\t    for field_name, field_info in model_class.model_fields.items():\n   105\t        # Check if field has an alias\n   106\t        if hasattr(field_info, \"alias\") and field_info.alias:\n   107\t            alias = field_info.alias\n   108\t            # Use the alias as the human-readable name\n   109\t            mappings[alias] = field_name\n   110\t        else:\n   111\t            # For fields without aliases, use the field name as both key and value\n   112\t            # This maintains backward compatibility\n   113\t            mappings[field_name] = field_name\n   114\t\n   115\t    return mappings\n   116\t\n   117\t\n   118\tclass AgentConfig(BaseModel):\n   119\t    name: str\n   120\t    capital: float\n   121\t    beta_share: float\n   122\t    alpha_share: float\n   123\t    extra: Dict[str, Any] = Field(default_factory=dict)\n   124\t\n   125\t\n   126\tclass RegimeConfig(BaseModel):\n   127\t    \"\"\"Configuration for a single regime in a regime-switching model.\"\"\"\n   128\t\n   129\t    model_config = ConfigDict(frozen=True)\n   130\t\n   131\t    name: str\n   132\t    idx_sigma_multiplier: float = 1.0\n   133\t    sigma_H: float | None = None\n   134\t    sigma_E: float | None = None\n   135\t    sigma_M: float | None = None\n   136\t    rho_idx_H: float | None = None\n   137\t    rho_idx_E: float | None = None\n   138\t    rho_idx_M: float | None = None\n   139\t    rho_H_E: float | None = None\n   140\t    rho_H_M: float | None = None\n   141\t    rho_E_M: float | None = None\n   142\t\n   143\t\n   144\tclass SweepParameter(BaseModel):\n   145\t    \"\"\"Sweep parameter definition for grid or random sampling.\"\"\"\n   146\t\n   147\t    model_config = ConfigDict(frozen=True)\n   148\t\n   149\t    values: List[float] | None = None\n   150\t    min: