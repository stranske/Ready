formance fee layer (issue #1904).\ntests/test_fee_layer.py:3:Covers the ``FeeSchedule`` model and validation, the ``compute_fee_drag`` /\ntests/test_fee_layer.py:4:``apply_fees`` helpers, routing through ``simulate_agents``, an end-to-end\ntests/test_fee_layer.py:19:from pa_core.fees import FeeSchedule, apply_fees, compute_fee_drag\ntests/test_fee_layer.py:29:    assert sched.mgmt_fee_bps == 0.0\ntests/test_fee_layer.py:30:    assert sched.perf_fee_pct == 0.0\ntests/test_fee_layer.py:35:def test_schedule_with_fee_is_not_zero() -> None:\ntests/test_fee_layer.py:36:    assert not FeeSchedule(mgmt_fee_bps=50.0).is_zero\ntests/test_fee_layer.py:37:    assert not FeeSchedule(perf_fee_pct=0.2).is_zero\ntests/test_fee_layer.py:40:def test_negative_or_out_of_range_fee_rejected() -> None:\ntests/test_fee_layer.py:42:        FeeSchedule(mgmt_fee_bps=-1.0)\ntests/test_fee_layer.py:44:        FeeSchedule(perf_fee_pct=-0.1)\ntests/test_fee_layer.py:46:        FeeSchedule(perf_fee_pct=1.5)\ntests/test_fee_layer.py:53:        {\"mgmt_fee_bps\": 50.0, \"perf_fee_pct\": 0.2, \"hurdle_bps\": 200.0}\ntests/test_fee_layer.py:55:    assert sched.mgmt_fee_bps == 50.0\ntests/test_fee_layer.py:56:    assert sched.perf_fee_pct == 0.2\ntests/test_fee_layer.py:61:# compute_fee_drag / apply_fees\ntests/test_fee_layer.py:65:def test_mgmt_fee_constant_monthly_drag() -> None:\ntests/test_fee_layer.py:67:    # 120 bps annual -> 0.012 annual -> 0.001 monthly flat drag\ntests/test_fee_layer.py:68:    sched = FeeSchedule(mgmt_fee_bps=120.0)\ntests/test_fee_layer.py:69:    drag = compute_fee_drag(gross, sched)\ntests/test_fee_layer.py:71:    assert np.allclose(apply_fees(gross, sched), 0.009)\ntests/test_fee_layer.py:74:def test_fee_drag_scales_by_notional_share() -> None:\ntests/test_fee_layer.py:76:    sched = FeeSchedule(mgmt_fee_bps=120.0, perf_fee_pct=0.5, hurdle_bps=0.0)\ntests/test_fee_layer.py:78:    drag = compute_fee_drag(gross, sched, notional_share=0.25)\ntests/test_fee_layer.py:80:    # U