   \"Total fund capital (mm)\",\n760-                \"internal_pa_capital\",\n761-                \"Internal PA capital (mm)\",\n762-            },\n763-        }\n--\n769-    def normalize_share_inputs(cls, data: Any) -> Any:\n770-        if not isinstance(data, dict):\n771-            return data\n772-        cls._trace_transform(data, \"normalize_share_inputs\")\n773-        share_fields = {\n774:            \"w_beta_H\": (\"In-House beta share\",),\n775:            \"w_alpha_H\": (\"In-House alpha share\",),\n776:            \"active_share\": (\"Active share (%)\", \"Active share\"),\n777:            \"theta_extpa\": (\"External PA alpha fraction\",),\n778-        }\n779-        for field, aliases in share_fields.items():\n780-            for key in (field, *aliases):\n781-                if key in data:\n782-                    data[key] = normalize_share(data[key])\n--\n919-                }\n920-            )\n921-        return normalized\n922-\n923-    @model_validator(mode=\"after\")\n924:    def check_financing_model(self) -> \"ModelConfig\":\n925:        self._trace_transform(self, \"check_financing_model\")\n926-        valid = {\"simple_proxy\", \"schedule\"}\n927:        if self.financing_model not in valid:\n928:            raise ValueError(f\"financing_model must be one of: {sorted(valid)}\")\n929:        if self.financing_model == \"schedule\" and self.financing_schedule_path is None:\n930-            raise ValueError(\"financing_schedule_path required for schedule financing model\")\n931-        return self\n932-\n933-    @model_validator(mode=\"after\")\n934-    def check_financing_spikes_have_volatility(self) -> \"ModelConfig\":\n--\n940-    def check_capital(self) -> \"ModelConfig\":\n941-        self._trace_transform(self, \"check_capital\")\n942-        from .validators import validate_capital_allocation\n943-\n944-        cap_sum = self.external_pa_capital + self.active_ext_capital + self.internal_pa_capital\n945:        if cap_sum > self.total_fund_capital:\n946:            raise ValueError(\"Capital allocation exceeds total_fund_capital\")\n947-\n948-        # Enhanced capital validation with margin requirements\n949-        validation_results = validate_capital_allocation(\n950-            external_pa_capital=self.external_pa_capital,\n951-            active_ext_capital=self.active_ext_capital,\n952-            internal_pa_capital=self.internal_pa_capital,\n953:            total_fund_capital=self.total_fund_capital,\n954-            reference_sigma=self.reference_sigma,\n955-            volatility_multiple=self.volatility_multiple,\n956:            financing_model=self.financing_model,\n957-            margin_schedule_path=self.financing_schedule_path,\n958-            term_months=self.financing_term_months,\n959-        )\n960-\n961-        # Check for critical errors\n--\n1071-        return self\n1072-\n1073-    @model_validator(mode=\"after\")\n1074-    def check_shares(self) -> \"ModelConfig\":\n1075-        self._trace_transform(self, \"check_shares\")\n1076:        for name, val in [(\"w_beta_H\", self.w_beta_H), (\"w_alpha_H\", self.w_alpha_H)]:\n1077-            if not SHARE_MIN <= val <= SHARE_MAX:\n1078-                raise ValueError(f\"{name} must be between 0 and 1\")\n1079:        if abs(self.w_beta_H + self.w_alpha_H - 1.0) > SHARE_SUM_TOLERANCE:\n1080:            raise ValueError(\"w_beta_H and w_alpha_H must sum to 1\")\n1081-        for name, val in [\n1082:            (\"theta_extpa\", self.theta_extpa),\n1083:            (\"active_share\", self.active_share),\n1084-        ]:\n1085-            if not SHARE_MIN <= val <= SHARE_MAX:\n1086-                raise ValueError(f\"{name} must be between 0 and 1\")\n1087-        return self\n1088-\n--\n1139-\n1140-        if self.agents:\n1141-            total_agent_capital = sum(\n1142-                agent.capital for agent in self.agents if agent.name != \"Base\"\n1143-            )\n1144:            if total_agent_capital > self.total_fund_capital + SHARE_SUM_TOLERANCE:\n1145-                errors.append(\n1146:                    \"sum(non-benchmark agent capital) must be <= total_fund_capital; \"\n1147:                    f\"got {total_agent_capital} > {self.total_fund_capital}. \"\n1148-                    \"Benchmark capital is treated as the total fund capital.\"\n1149-                )\n1150-\n1151-        if errors:\n1152-            raise ValueError(\"; \".join(errors))\n--\n1199-            \"in_house_return_step_pct\": self.in_house_return_step_pct,\n1200-            \"in_house_vol_step_pct\": self.in_house_vol_step_pct,\n1201-            \"alpha_ext_return_step_pct\": self.alpha_ext_return_step_pct,\n1202-            \"alpha_ext_vol_step_pct\": self.alpha_ext_vol_step_pct,\n1203-            \"external_pa_alpha_step_pct\": self.external_pa_alpha_step_pct,\n1204:            \"active_share_step_pct\": self.active_share_step_pct,\n1205-            \"sd_multiple_step\": self.sd_multiple_step,\n1206-        }\n1207-\n1208-        validation_results = validate_simulation_parameters(\n1209-            n_simulations=self.N_SIMULATIONS, step_sizes=step_sizes\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc 'repo=/Users/teacher/.codex/automations/research-program/clones/Portable-Alpha-Extension-Model\ncd \"$repo\"\nprintf '\"'%s\\\\n' '--- sweep 372-750 ---'\nnl -ba pa_core/sweep.py | sed -n '360,780p'\nprintf '%s\\\\n' '--- facade options / single / sweep ---'\nnl -ba pa_core/facade.py | sed -n '220,680p'\nprintf '%s\\\\n' '--- config models 180-460 and validators ---'\nnl -ba pa_core/config.py | sed -n '170,460p'\nnl -ba pa_core/config.py | sed -n '900,1120p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc 'repo=/Users/teacher/.codex/automations/research-program/clones/Portable-Alpha-Extension-Model\ncd \"$repo\"\nprintf '\"'%s\\\\n' '--- sweep 372-750 ---'\nnl -ba pa_core/sweep.py | sed -n '360,780p'\nprintf '%s\\\\n' '--- facade options / single / sweep ---'\nnl -ba pa_core/facade.py | sed -n '220,680p'\nprintf '%s\\\\n' '--- config models 180-460 and validators ---'\nnl -ba pa_core/config.py | sed -n '170,460p'\nnl -ba pa_core/config.py | sed -n '900,1120p'\"","aggregated_output":"--- sweep 372-750 ---\n   360\t    ``rng_returns`` reproduce identical regime paths, while remaining an\n   361\t    independent stream from the return draws.\n   362\t    \"\"\"\n   363\t    state_repr = json.dumps(rng_returns.bit_generator.state, sort_keys=True, default=str)\n   364\t    digest = hashlib.sha256((\"pa_core.regime:\" + state_repr).encode(\"utf-8\")).digest()\n   365\t    entropy = int.from_bytes(digest, \"big\")\n   366\t    return spawn_rngs(entropy, 1)[0]\n   367\t\n   368\t\n   369\tdef run_parameter_sweep(\n   370\t    cfg: ModelConfig,\n   371\t    index_series: pd.Series,\n   372\t    rng_returns: GeneratorLike,\n   373\t    fin_rngs: Mapping[str, GeneratorLike],\n   374\t    seed: int | None = None,\n   375\t    rng_regime: GeneratorLike | None = None,\n   376\t    progress: Callable[[int, int], None] | None = None,\n   377\t) -> List[SweepResult]:\n   378\t    \"\"\"Run the parameter sweep and collect results.\n   379\t\n   380\t    Index returns are normalised to monthly units before simulation, and\n   381\t    summary metrics (terminal_AnnReturn/monthly_AnnVol/monthly_TE) are annualised\n   382\t    from monthly returns.\n   383\t\n   384\t    Parameters\n   385\t    ----------\n   386\t    progress:\n   387\t        Optional callback accepting ``(current, total)`` to report progress. When\n   388\t        ``None``, a ``tqdm`` progress bar is displayed.\n   389\t    \"\"\"\n   390\t    results: List[SweepResult] = []\n   391\t    if rng_regime is None:\n   392\t        if seed is not None:\n   393\t            rng_regime = spawn_rngs(seed, 2)[1]\n   394\t        else:\n   395\t            # No master seed and no explicit regime RNG: derive one\n   396\t            # deterministically from the supplied ``rng_returns`` so that direct\n   397\t            # callers that seed ``rng_returns``/``fin_rngs`` (the established\n   398\t            # reproducibility pattern) still get repeatable regime paths instead\n   399\t            # of OS entropy. Reading ``bit_generator.state`` does not advance\n   400\t            # ``rng_returns``, so this leaves the downstream draws untouched.\n   401\t            rng_regime = _derive_regime_rng(rng_returns)\n   402\t\n   403\t    index_series = normalize_index_series(pd.Series(index_series), get_index_series_unit())\n   404\t    mu_idx = float(index_series.mean())\n   405\t    idx_sigma, _, _ = select_vol_regime_sigma(\n   406\t        index_series,\n   407\t        regime=cfg.vol_regime,\n   408\t        window=cfg.vol_regime_window,\n   409\t    )\n   410\t    n_samples = int(len(index_series))\n   411\t\n   412\t    total = _estimate_total_combinations(cfg)\n   413\t    logger.info(\"Starting parameter sweep\", extra={\"total_combinations\": total})\n   414\t\n   415\t    override_keys = _override_keys_for_config(cfg)\n   416\t    shock_incompatible_keys = {\n   417\t        \"rho_idx_H\",\n   418\t        \"rho_idx_E\",\n   419\t        \"rho_idx_M\",\n   420\t        \"rho_H_E\",\n   421\t        \"rho_H_M\",\n   422\t        \"rho_E_M\",\n   423\t        \"correlation_repair_mode\",\n   424\t        \"correlation_repair_shrinkage\",\n   425\t        \"return_distribution\",\n   426\t        \"return_t_df\",\n   427\t        \"return_copula\",\n   428\t        \"return_distribution_idx\",\n   429\t        \"return_distribution_H\",\n   430\t        \"return_distribution_E\",\n   431\t        \"return_distribution_M\",\n   432\t    }\n   433\t    financing_keys = {\n   434\t        \"internal_financing_mean_month\",\n   435\t        \"internal_financing_sigma_month\",\n   436\t        \"internal_spike_prob\",\n   437\t        \"internal_spike_factor\",\n   438\t        \"ext_pa_financing_mean_month\",\n   439\t        \"ext_pa_financing_sigma_month\",\n   440\t        \"ext_pa_spike_prob\",\n   441\t        \"ext_pa_spike_factor\",\n   442\t        \"act_ext_financing_mean_month\",\n   443\t        \"act_ext_financing_sigma_month\",\n   444\t        \"act_ext_spike_prob\",\n   445\t        \"act_ext_spike_factor\",\n   446\t        \"financing_mode\",\n   447\t    }\n   448\t    sigma_override_keys = {\"sigma_H\", \"sigma_E\", \"sigma_M\"}\n   449\t    return_param_keys = {\n   450\t        \"return_unit\",\n   451\t        \"mu_H\",\n   452\t        \"mu_E\",\n   453\t        \"mu_M\",\n   454\t        \"sigma_H\",\n   455\t        \"sigma_E\",\n   456\t        \"sigma_M\",\n   457\t        \"rho_idx_H\",\n   458\t        \"rho_idx_E\",\n   459\t        \"rho_idx_M\",\n   460\t        \"rho_H_E\",\n   461\t        \"rho_H_M\",\n   462\t        \"rho_E_M\",\n   463\t        \"correlation_repair_mode\",\n   464\t        \"correlation_repair_shrinkage\",\n   465\t        \"return_distribution\",\n   466\t        \"return_t_df\",\n   467\t        \"return_copula\",\n   468\t        \"return_distribution_idx\",\n   469\t        \"return_distribution_H\",\n   470\t        \"return_distribution_E\",\n   471\t        \"return_distribution_M\",\n   472\t        \"covariance_shrinkage\",\n   473\t    }\n   474\t    reuse_return_shocks = not override_keys.intersection(shock_incompatible_keys)\n   475\t    reuse_financing_series = not override_keys.intersection(financing_keys)\n   476\t    if cfg.regimes is not None:\n   477\t        reuse_return_shocks = False\n   478\t    if cfg.covariance_shrinkage != \"none\" and override_keys.intersection(sigma_override_keys):\n   479\t        reuse_return_shocks = False\n   480\t    returns_static = not override_keys.intersection(return_param_keys)\n   481\t    financing_static = not override_keys.intersection(financing_keys)\n   482\t\n   483\t    # Common random numbers: reset RNGs before each combination so parameter\n   484\t    # changes are compared against identical random draws. When a master seed\n   485\t    # is provided, derive the baseline RNG state from that seed.\n   486\t    if seed is None:\n   487\t        rng_returns_state = copy.deepcopy(rng_returns.bit_generator.state)\n   488\t        rng_regime_state = copy.deepcopy(rng_regime.bit_generator.state)\n   489\t        fin_rng_states = {\n   490\t            name: copy.deepcopy(rng.bit_generator.state) for name, rng in fin_rngs.items()\n   491\t        }\n   492\t    else:\n   493\t        base_rng_returns, base_rng_regime = spawn_rngs(seed, 2)\n   494\t        base_fin_rngs = spawn_agent_rngs(seed, list(fin_rngs.keys()))\n   495\t        rng_returns_state = copy.deepcopy(base_rng_returns.bit_generator.state)\n   496\t        rng_regime_state = copy.deepcopy(base_rng_regime.bit_generator.state)\n   497\t        fin_rng_states = {\n   498\t            name: copy.deepcopy(base_fin_rngs[name].bit_generator.state) for name in fin_rngs.keys()\n   499\t        }\n   500\t\n   501\t    base_sigma = None\n   502\t    base_corr = None\n   503\t    base_params = None\n   504\t    base_regime_params = None\n   505\t    base_regime_paths = None\n   506\t    if returns_static or reuse_return_shocks:\n   507\t        base_return_inputs = normalize_return_inputs(cfg)\n   508\t        sigma_h = float(base_return_inputs[\"sigma_H\"])\n   509\t        sigma_e = float(base_return_inputs[\"sigma_E\"])\n   510\t        sigma_m = float(base_return_inputs[\"sigma_M\"])\n   511\t        base_cov = build_cov_matrix(\n   512\t            cfg.rho_idx_H,\n   513\t            cfg.rho_idx_E,\n   514\t            cfg.rho_idx_M,\n   515\t            cfg.rho_H_E,\n   516\t            cfg.rho_H_M,\n   517\t            cfg.rho_E_M,\n   518\t            idx_sigma,\n   519\t            sigma_h,\n   520\t            sigma_e,\n   521\t            sigma_m,\n   522\t            covariance_shrinkage=cfg.covariance_shrinkage,\n   523\t            n_samples=n_samples,\n   524\t        )\n   525\t        base_sigma, base_corr = resolve_covariance_inputs(\n   526\t            base_cov,\n   527\t            idx_sigma=idx_sigma,\n   528\t            sigma_h=sigma_h,\n   529\t            sigma_e=sigma_e,\n   530\t            sigma_m=sigma_m,\n   531\t            rho_idx_H=cfg.rho_idx_H,\n   532\t            rho_idx_E=cfg.rho_idx_E,\n   533\t            rho_idx_M=cfg.rho_idx_M,\n   534\t            rho_H_E=cfg.rho_H_E,\n   535\t            rho_H_M=cfg.rho_H_M,\n   536\t            rho_E_M=cfg.rho_E_M,\n   537\t        )\n   538\t        base_params = build_params(\n   539\t            cfg,\n   540\t            mu_idx=mu_idx,\n   541\t            idx_sigma=float(base_sigma[0]),\n   542\t            return_overrides=build_covariance_return_overrides(base_sigma, base_corr),\n   543\t        )\n   544\t        if cfg.regimes is not None:\n   545\t            if cfg.regime_transition is None:\n   546\t                raise ValueError(\"regime_transition is required when regimes are specified\")\n   547\t            base_regime_params, _labels = build_regime_draw_params(\n   548\t                cfg,\n   549\t                mu_idx=mu_idx,\n   550\t                idx_sigma=float(base_sigma[0]),\n   551\t                n_samples=n_samples,\n   552\t            )\n   553\t            rng_regime_base = spawn_rngs(None, 1)[0]\n   554\t            rng_regime_base.bit_generator.state = copy.deepcopy(rng_regime_state)\n   555\t            base_regime_paths = simulate_regime_paths(\n   556\t                n_sim=cfg.N_SIMULATIONS,\n   557\t                n_months=cfg.N_MONTHS,\n   558\t                transition=cfg.regime_transition,\n   559\t                start_state=resolve_regime_start(cfg),\n   560\t                rng=rng_regime_base,\n   561\t            )\n   562\t\n   563\t    return_shocks = None\n   564\t    if reuse_return_shocks:\n   565\t        if base_params is None:\n   566\t            raise RuntimeError(\"Base parameters are required to prepare return shocks\")\n   567\t        rng_returns_base = spawn_rngs(None, 1)[0]\n   568\t        rng_returns_base.bit_generator.state = copy.deepcopy(rng_returns_state)\n   569\t        return_shocks = prepare_return_shocks(\n   570\t            n_months=cfg.N_MONTHS,\n   571\t            n_sim=cfg.N_SIMULATIONS,\n   572\t            params=base_params,\n   573\t            rng=rng_returns_base,\n   574\t        )\n   575\t\n   576\t    financing_series = None\n   577\t    if reuse_financing_series:\n   578\t        idx_sigma_fin = float(base_sigma[0]) if base_sigma is not None else float(idx_sigma)\n   579\t        financing_params = build_params(cfg, mu_idx=mu_idx, idx_sigma=idx_sigma_fin)\n   580\t        fin_rngs_base: Dict[str, GeneratorLike] = {}\n   581\t        for name in fin_rngs.keys():\n   582\t            tmp_rng = spawn_rngs(None, 1)[0]\n   583\t            tmp_rng.bit_generator.state = copy.deepcopy(fin_rng_states[name])\n   584\t            fin_rngs_base[name] = tmp_rng\n   585\t        financing_series = draw_financing_series(\n   586\t            n_months=cfg.N_MONTHS,\n   587\t            n_sim=cfg.N_SIMULATIONS,\n   588\t            params=financing_params,\n   589\t            financing_mode=cfg.financing_mode,\n   590\t            rngs=fin_rngs_base,\n   591\t        )\n   592\t\n   593\t    combos_iter: Any = generate_parameter_combinations(cfg)\n   594\t    if progress is None:\n   595\t        combos_iter = progress_bar(combos_iter, total=total, desc=\"sweep\")\n   596\t    iterator = enumerate(combos_iter)\n   597\t\n   598\t    for i, overrides in iterator:\n   599\t        if return_shocks is None:\n   600\t            rng_returns.bit_generator.state = copy.deepcopy(rng_returns_state)\n   601\t            rng_regime.bit_generator.state = copy.deepcopy(rng_regime_state)\n   602\t        if financing_series is None:\n   603\t            for name, rng in fin_rngs.items():\n   604\t                rng.bit_generator.state = copy.deepcopy(fin_rng_states[name])\n   605\t\n   606\t        # Build each sweep case with ``model_copy`` (no full re-validation) so the\n   607\t        # grid can explore over-margin capital combinations as before, but re-run\n   608\t        # the inert-spike check so a sweep override cannot silently introduce a\n   609\t        # spike with zero financing volatility.\n   610\t        mod_cfg = cfg.model_copy(update=overrides)\n   611\t        validate_financing_spikes(mod_cfg)\n   612\t\n   613\t        if returns_static:\n   614\t            if base_params is None:\n   615\t                raise RuntimeError(\"Base parameters are required for static return sweeps\")\n   616\t            if financing_static:\n   617\t                params = base_params\n   618\t            else:\n   619\t                params = dict(base_params)\n   620\t                params.update(build_financing_params(mod_cfg))\n   621\t        else:\n   622\t            return_inputs = normalize_return_inputs(mod_cfg)\n   623\t            sigma_h = float(return_inputs[\"sigma_H\"])\n   624\t            sigma_e = float(return_inputs[\"sigma_E\"])\n   625\t            sigma_m = float(return_inputs[\"sigma_M\"])\n   626\t\n   627\t            cov = build_cov_matrix(\n   628\t                mod_cfg.rho_idx_H,\n   629\t                mod_cfg.rho_idx_E,\n   630\t                mod_cfg.rho_idx_M,\n   631\t                mod_cfg.rho_H_E,\n   632\t                mod_cfg.rho_H_M,\n   633\t                mod_cfg.rho_E_M,\n   634\t                idx_sigma,\n   635\t                sigma_h,\n   636\t                sigma_e,\n   637\t                sigma_m,\n   638\t                covariance_shrinkage=mod_cfg.covariance_shrinkage,\n   639\t                n_samples=n_samples,\n   640\t            )\n   641\t            sigma_vec, corr_mat = resolve_covariance_inputs(\n   642\t                cov,\n   643\t                idx_sigma=idx_sigma,\n   644\t                sigma_h=sigma_h,\n   645\t                sigma_e=sigma_e,\n   646\t                sigma_m=sigma_m,\n   647\t                rho_idx_H=mod_cfg.rho_idx_H,\n   648\t                rho_idx_E=mod_cfg.rho_idx_E,\n   649\t                rho_idx_M=mod_cfg.rho_idx_M,\n   650\t                rho_H_E=mod_cfg.rho_H_E,\n   651\t                rho_H_M=mod_cfg.rho_H_M,\n   652\t                rho_E_M=mod_cfg.rho_E_M,\n   653\t            )\n   654\t            params = build_params(\n   655\t                mod_cfg,\n   656\t                mu_idx=mu_idx,\n   657\t                idx_sigma=float(sigma_vec[0]),\n   658\t                return_overrides=build_covariance_return_overrides(sigma_vec, corr_mat),\n   659\t            )\n   660\t\n   661\t        regime_params = None\n   662\t        regime_paths = None\n   663\t        if mod_cfg.regimes is not None:\n   664\t            if mod_cfg.regime_transition is None:\n   665\t                raise ValueError(\"regime_transition is required when regimes are specified\")\n   666\t            if returns_static and base_regime_params is not None and base_regime_paths is not None:\n   667\t                regime_params = base_regime_params\n   668\t                regime_paths = base_regime_paths\n   669\t            else:\n   670\t                regime_params = build_regime_draw_params(\n   671\t                    mod_cfg,\n   672\t                    mu_idx=mu_idx,\n   673\t                    idx_sigma=float(params[\"idx_sigma_month\"]),\n   674\t                    n_samples=n_samples,\n   675\t                )[0]\n   676\t                regime_paths = simulate_regime_paths(\n   677\t                    n_sim=mod_cfg.N_SIMULATIONS,\n   678\t                    n_months=mod_cfg.N_MONTHS,\n   679\t                    transition=mod_cfg.regime_transition,\n   680\t                    start_state=resolve_regime_start(mod_cfg),\n   681\t                    rng=rng_regime,\n   682\t                )\n   683\t\n   684\t        r_beta, r_H, r_E, r_M = draw_joint_returns(\n   685\t            n_months=mod_cfg.N_MONTHS,\n   686\t            n_sim=mod_cfg.N_SIMULATIONS,\n   687\t            params=params,\n   688\t            rng=None if return_shocks is not None else rng_returns,\n   689\t            shocks=return_shocks,\n   690\t            regime_paths=regime_paths,\n   691\t            regime_params=regime_params,\n   692\t        )\n   693\t        if financing_series is None:\n   694\t            f_int, f_ext, f_act = draw_financing_series(\n   695\t                n_months=mod_cfg.N_MONTHS,\n   696\t                n_sim=mod_cfg.N_SIMULATIONS,\n   697\t                params=params,\n   698\t                financing_mode=mod_cfg.financing_mode,\n   699\t                rngs=fin_rngs,\n   700\t            )\n   701\t        else:\n   702\t            f_int, f_ext, f_act = financing_series\n   703\t        f_internal_pa = resolve_internal_pa_financing_series(\n   704\t            n_months=mod_cfg.N_MONTHS,\n   705\t            n_sim=mod_cfg.N_SIMULATIONS,\n   706\t            mean_month=getattr(mod_cfg, \"internal_pa_financing_mean_month\", 0.0),\n   707\t            sigma_month=getattr(mod_cfg, \"internal_pa_financing_sigma_month\", 0.0),\n   708\t            series=getattr(mod_cfg, \"internal_pa_financing_series\", None),\n   709\t            index=getattr(mod_cfg, \"internal_pa_financing_index\", None),\n   710\t            financing_mode=mod_cfg.financing_mode,\n   711\t            rng=fin_rngs.get(\"internal\") if fin_rngs else None,\n   712\t        )\n   713\t\n   714\t        agents = build_from_config(mod_cfg)\n   715\t        returns = simulate_agents(\n   716\t            agents,\n   717\t            r_beta,\n   718\t            r_H,\n   719\t            r_E,\n   720\t            r_M,\n   721\t            f_int,\n   722\t            f_ext,\n   723\t            f_act,\n   724\t            f_internal_pa,\n   725\t        )\n   726\t\n   727\t        summary = summary_table(returns, benchmark=\"Base\")\n   728\t        results.append(\n   729\t            {\n   730\t                \"combination_id\": i,\n   731\t                \"parameters\": overrides,\n   732\t                \"summary\": summary,\n   733\t            }\n   734\t        )\n   735\t\n   736\t        if progress is not None:\n   737\t            progress(i + 1, total)\n   738\t        else:\n   739\t            logger.debug(\"sweep step\", extra={\"current\": i + 1, \"total\": total})\n   740\t\n   741\t    logger.info(\"Parameter sweep complete\")\n   742\t    return results\n   743\t\n   744\t\n   745\t# ---------------------------------------------------------------------------\n   746\t# Cached sweep and result helpers\n   747\t\n   748\tSWEEP_CACHE_MAX_ENTRIES = 8\n   749\t_SWEEP_CACHE: \"OrderedDict[str, List[SweepResult]]\" = OrderedDict()\n   750\t\n   751\t\n   752\tdef _enforce_sweep_cache_limit() -> None:\n   753\t    if SWEEP_CACHE_MAX_ENTRIES < 1:\n   754\t        return\n   755\t    while len(_SWEEP_CACHE) > SWEEP_CACHE_MAX_ENTRIES:\n   756\t        _SWEEP_CACHE.popitem(last=False)\n   757\t\n   758\t\n   759\tdef _make_cache_key(cfg: ModelConfig, index_series: pd.Series, seed: int) -> str:\n   760\t    \"\"\"Return a hash key for caching parameter sweeps.\"\"\"\n   761\t    cfg_json = json.dumps(cfg.model_dump(), sort_keys=True)\n   762\t    # Use getattr to avoid static checker complaining about pandas.util access\n   763\t    hash_fn = getattr(pd, \"util\").hash_pandas_object\n   764\t    idx_hash = hashlib.sha256(hash_fn(index_series).values.tobytes()).hexdigest()\n   765\t    return hashlib.sha256((cfg_json + idx_hash + str(seed)).encode()).hexdigest()\n   766\t\n   767\t\n   768\tdef run_parameter_sweep_cached(\n   769\t    cfg: ModelConfig,\n   770\t    index_series: pd.Series,\n   771\t    seed: int,\n   772\t    progress: Callable[[int, int], None] | None = None,\n   773\t) -> List[SweepResult]:\n   774\t    \"\"\"Run ``run_parameter_sweep`` with simple in-memory caching.\n   775\t\n   776\t    The cache key is derived from the configuration, index series and seed.\n   777\t    Subsequent calls with identical parameters return the cached results\n   778\t    without re-running the simulation.\n   779\t    \"\"\"\n   780\t    if SWEEP_CACHE_MAX_ENTRIES < 1:\n--- facade options / single / sweep ---\n   220\t    covariance_shrinkage: str | None = None\n   221\t    vol_regime: str | None = None\n   222\t    vol_regime_window: int | None = None\n   223\t    analysis_mode: str | None = None\n   224\t\n   225\t\n   226\tdef apply_run_options(\n   227\t    config: \"ModelConfig\",\n   228\t    options: RunOptions | None = None,\n   229\t    sweep_params: Mapping[str, Any] | None = None,\n   230\t) -> \"ModelConfig\":\n   231\t    \"\"\"Return config updated with RunOptions and optional sweep params.\"\"\"\n   232\t\n   233\t    run_options = options or RunOptions()\n   234\t    overrides: dict[str, Any] = dict(run_options.config_overrides or {})\n   235\t\n   236\t    if run_options.return_distribution is not None:\n   237\t        overrides[\"return_distribution\"] = run_options.return_distribution\n   238\t    if run_options.return_t_df is not None:\n   239\t        overrides[\"return_t_df\"] = run_options.return_t_df\n   240\t    if run_options.return_copula is not None:\n   241\t        overrides[\"return_copula\"] = run_options.return_copula\n   242\t    if run_options.covariance_shrinkage is not None:\n   243\t        overrides[\"covariance_shrinkage\"] = run_options.covariance_shrinkage\n   244\t    if run_options.vol_regime is not None:\n   245\t        overrides[\"vol_regime\"] = run_options.vol_regime\n   246\t    if run_options.vol_regime_window is not None:\n   247\t        overrides[\"vol_regime_window\"] = run_options.vol_regime_window\n   248\t    if run_options.analysis_mode is not None:\n   249\t        overrides[\"analysis_mode\"] = run_options.analysis_mode\n   250\t    if sweep_params:\n   251\t        overrides.update(sweep_params)\n   252\t\n   253\t    if not overrides:\n   254\t        return config\n   255\t\n   256\t    data = config.model_dump()\n   257\t    data.update(overrides)\n   258\t    return config.__class__.model_validate(data)\n   259\t\n   260\t\n   261\t@dataclass(slots=True)\n   262\tclass ExportOptions:\n   263\t    \"\"\"Configuration options for exporting artifacts.\n   264\t\n   265\t    Attributes:\n   266\t        pivot: If True, write all returns in a single long-format sheet.\n   267\t        include_sensitivity: If True, include sensitivity analysis in exports.\n   268\t        include_charts: If True, embed charts in Excel output.\n   269\t        alt_text: Alt text for accessibility in exported charts.\n   270\t        include_visualizations: If True, generate comparison visualizations.\n   271\t        viz_output_dir: Optional directory for visualization HTML output.\n   272\t        show_visualizations: If True, display visualizations interactively.\n   273\t    \"\"\"\n   274\t\n   275\t    pivot: bool = False\n   276\t    include_sensitivity: bool = False\n   277\t    include_charts: bool = True\n   278\t    alt_text: str | None = None\n   279\t    include_visualizations: bool = False\n   280\t    viz_output_dir: str | Path | None = None\n   281\t    show_visualizations: bool = False\n   282\t\n   283\t\n   284\tdef run_single(\n   285\t    config: \"ModelConfig\",\n   286\t    index_series: \"pd.Series\",\n   287\t    options: RunOptions | None = None,\n   288\t) -> RunArtifacts:\n   289\t    \"\"\"Run a single simulation with optional overrides and return artifacts.\n   290\t\n   291\t    This is the primary programmatic entrypoint for running a single portfolio\n   292\t    simulation without using the CLI. It handles all setup including backend\n   293\t    resolution, RNG initialization, and parameter building.\n   294\t\n   295\t    Args:\n   296\t        config: Model configuration specifying simulation parameters.\n   297\t        index_series: Benchmark index returns as a pandas Series.\n   298\t        options: Optional RunOptions with seed, backend, and config overrides.\n   299\t\n   300\t    Returns:\n   301\t        RunArtifacts containing simulation results, summary statistics,\n   302\t        and metadata for export or further analysis.\n   303\t\n   304\t    Raises:\n   305\t        ValueError: If index_series cannot be converted to a pandas Series.\n   306\t\n   307\t    Example::\n   308\t\n   309\t        from pa_core.config import load_config\n   310\t        from pa_core.facade import run_single, RunOptions\n   311\t\n   312\t        cfg = load_config(\"config.yml\")\n   313\t        idx = pd.read_csv(\"index.csv\")[\"returns\"]\n   314\t\n   315\t        # Basic run\n   316\t        artifacts = run_single(cfg, idx)\n   317\t\n   318\t        # With seed for reproducibility\n   319\t        artifacts = run_single(cfg, idx, RunOptions(seed=42))\n   320\t\n   321\t        # With config overrides\n   322\t        artifacts = run_single(cfg, idx, RunOptions(\n   323\t            seed=42,\n   324\t            config_overrides={\"N_SIMULATIONS\": 1000}\n   325\t        ))\n   326\t    \"\"\"\n   327\t\n   328\t    import numpy as np\n   329\t    import pandas as pd\n   330\t\n   331\t    from .agents.registry import build_from_config\n   332\t    from .backend import resolve_and_set_backend\n   333\t    from .sim import (\n   334\t        draw_financing_series,\n   335\t        draw_joint_returns,\n   336\t        resolve_internal_pa_financing_series,\n   337\t    )\n   338\t    from .sim.covariance import build_cov_matrix\n   339\t    from .sim.metrics import summary_table\n   340\t    from .sim.params import (\n   341\t        build_covariance_return_overrides,\n   342\t        build_params,\n   343\t        resolve_covariance_inputs,\n   344\t    )\n   345\t    from .sim.regimes import (\n   346\t        apply_regime_labels,\n   347\t        build_regime_draw_params,\n   348\t        resolve_regime_start,\n   349\t        simulate_regime_paths,\n   350\t    )\n   351\t    from .sim.simulation_initialization import initialize_run_rngs\n   352\t    from .simulations import simulate_agents\n   353\t    from .units import normalize_return_inputs\n   354\t    from .validators import select_vol_regime_sigma\n   355\t\n   356\t    started = time.perf_counter()\n   357\t    run_options = options or RunOptions()\n   358\t    run_cfg = apply_run_options(config, run_options)\n   359\t    resolve_and_set_backend(run_options.backend, run_cfg)\n   360\t\n   361\t    idx_series = index_series\n   362\t    if isinstance(idx_series, pd.DataFrame):\n   363\t        idx_series = idx_series.squeeze()\n   364\t        if not isinstance(idx_series, pd.Series):\n   365\t            raise ValueError(\"Index data must be convertible to pandas Series\")\n   366\t    elif not isinstance(idx_series, pd.Series):\n   367\t        raise ValueError(\"Index data must be a pandas Series\")\n   368\t\n   369\t    mu_idx = float(idx_series.mean())\n   370\t    idx_sigma, _, _ = select_vol_regime_sigma(\n   371\t        idx_series,\n   372\t        regime=run_cfg.vol_regime,\n   373\t        window=run_cfg.vol_regime_window,\n   374\t    )\n   375\t    n_samples = int(len(idx_series))\n   376\t\n   377\t    return_inputs = normalize_return_inputs(run_cfg)\n   378\t    sigma_h = float(return_inputs[\"sigma_H\"])\n   379\t    sigma_e = float(return_inputs[\"sigma_E\"])\n   380\t    sigma_m = float(return_inputs[\"sigma_M\"])\n   381\t\n   382\t    cov = build_cov_matrix(\n   383\t        run_cfg.rho_idx_H,\n   384\t        run_cfg.rho_idx_E,\n   385\t        run_cfg.rho_idx_M,\n   386\t        run_cfg.rho_H_E,\n   387\t        run_cfg.rho_H_M,\n   388\t        run_cfg.rho_E_M,\n   389\t        idx_sigma,\n   390\t        sigma_h,\n   391\t        sigma_e,\n   392\t        sigma_m,\n   393\t        covariance_shrinkage=run_cfg.covariance_shrinkage,\n   394\t        n_samples=n_samples,\n   395\t    )\n   396\t    sigma_vec, corr_mat = resolve_covariance_inputs(\n   397\t        cov,\n   398\t        idx_sigma=idx_sigma,\n   399\t        sigma_h=sigma_h,\n   400\t        sigma_e=sigma_e,\n   401\t        sigma_m=sigma_m,\n   402\t        rho_idx_H=run_cfg.rho_idx_H,\n   403\t        rho_idx_E=run_cfg.rho_idx_E,\n   404\t        rho_idx_M=run_cfg.rho_idx_M,\n   405\t        rho_H_E=run_cfg.rho_H_E,\n   406\t        rho_H_M=run_cfg.rho_H_M,\n   407\t        rho_E_M=run_cfg.rho_E_M,\n   408\t    )\n   409\t\n   410\t    params = build_params(\n   411\t        run_cfg,\n   412\t        mu_idx=mu_idx,\n   413\t        idx_sigma=float(sigma_vec[0]),\n   414\t        return_overrides=build_covariance_return_overrides(sigma_vec, corr_mat),\n   415\t    )\n   416\t\n   417\t    rng_bundle = initialize_run_rngs(\n   418\t        run_options.seed,\n   419\t        legacy_agent_rng=run_options.legacy_agent_rng,\n   420\t    )\n   421\t    rng_returns = rng_bundle.rng_returns\n   422\t    rng_regime = rng_bundle.rng_regime\n   423\t    fin_rngs = rng_bundle.rngs_financing\n   424\t    substream_ids = rng_bundle.substream_ids\n   425\t    regime_params = None\n   426\t    regime_paths = None\n   427\t    regime_labels = None\n   428\t    if run_cfg.regimes is not None:\n   429\t        if run_cfg.regime_transition is None:\n   430\t            raise ValueError(\"regime_transition is required when regimes are specified\")\n   431\t        regime_params, labels = build_regime_draw_params(\n   432\t            run_cfg,\n   433\t            mu_idx=mu_idx,\n   434\t            idx_sigma=idx_sigma,\n   435\t            n_samples=n_samples,\n   436\t        )\n   437\t        regime_paths = simulate_regime_paths(\n   438\t            n_sim=run_cfg.N_SIMULATIONS,\n   439\t            n_months=run_cfg.N_MONTHS,\n   440\t            transition=run_cfg.regime_transition,\n   441\t            start_state=resolve_regime_start(run_cfg),\n   442\t            rng=rng_regime,\n   443\t        )\n   444\t        regime_labels = apply_regime_labels(regime_paths, labels)\n   445\t    r_beta, r_H, r_E, r_M = draw_joint_returns(\n   446\t        n_months=run_cfg.N_MONTHS,\n   447\t        n_sim=run_cfg.N_SIMULATIONS,\n   448\t        params=params,\n   449\t        rng=rng_returns,\n   450\t        regime_paths=regime_paths,\n   451\t        regime_params=regime_params,\n   452\t    )\n   453\t    corr_repair_info = params.get(\"_correlation_repair_info\")\n   454\t    f_int, f_ext, f_act = draw_financing_series(\n   455\t        n_months=run_cfg.N_MONTHS,\n   456\t        n_sim=run_cfg.N_SIMULATIONS,\n   457\t        params=params,\n   458\t        financing_mode=run_cfg.financing_mode,\n   459\t        rngs=fin_rngs,\n   460\t    )\n   461\t    f_internal_pa = resolve_internal_pa_financing_series(\n   462\t        n_months=run_cfg.N_MONTHS,\n   463\t        n_sim=run_cfg.N_SIMULATIONS,\n   464\t        mean_month=getattr(run_cfg, \"internal_pa_financing_mean_month\", 0.0),\n   465\t        sigma_month=getattr(run_cfg, \"internal_pa_financing_sigma_month\", 0.0),\n   466\t        series=getattr(run_cfg, \"internal_pa_financing_series\", None),\n   467\t        index=getattr(run_cfg, \"internal_pa_financing_index\", None),\n   468\t        financing_mode=run_cfg.financing_mode,\n   469\t        rng=fin_rngs.get(\"internal\") if fin_rngs else None,\n   470\t    )\n   471\t\n   472\t    agents = build_from_config(run_cfg)\n   473\t    returns = simulate_agents(\n   474\t        agents,\n   475\t        r_beta,\n   476\t        r_H,\n   477\t        r_E,\n   478\t        r_M,\n   479\t        f_int,\n   480\t        f_ext,\n   481\t        f_act,\n   482\t        f_internal_pa,\n   483\t        fee_schedule=run_cfg.fee_schedule,\n   484\t    )\n   485\t    summary = summary_table(returns, benchmark=\"Base\")\n   486\t    if getattr(run_cfg, \"sleeve_validate_on_run\", False):\n   487\t        from .reporting.constraints import validate_sleeve_constraints\n   488\t\n   489\t        violations = validate_sleeve_constraints(summary, run_cfg)\n   490\t        if violations:\n   491\t            formatted = \"\\n\".join(f\"- {violation}\" for violation in violations)\n   492\t            raise ValueError(f\"Sleeve constraint violations:\\n{formatted}\")\n   493\t    raw_returns = {name: pd.DataFrame(data) for name, data in returns.items()}\n   494\t    if regime_labels is not None:\n   495\t        raw_returns[\"Regime\"] = pd.DataFrame(regime_labels)\n   496\t    inputs = run_cfg.model_dump()\n   497\t    if isinstance(corr_repair_info, dict):\n   498\t        corr_before_raw = corr_repair_info.get(\"corr_before\")\n   499\t        corr_after_raw = corr_repair_info.get(\"corr_after\")\n   500\t        corr_delta_raw = corr_repair_info.get(\"corr_delta\")\n   501\t        if corr_before_raw is not None and corr_after_raw is not None:\n   502\t            corr_before = np.array(corr_before_raw, dtype=float)\n   503\t            corr_after = np.array(corr_after_raw, dtype=float)\n   504\t            if corr_before.shape == corr_after.shape and corr_before.size:\n   505\t                corr_delta = (\n   506\t                    np.array(corr_delta_raw, dtype=float)\n   507\t                    if corr_delta_raw is not None\n   508\t                    else corr_after - corr_before\n   509\t                )\n   510\t                labels = [\"Index\", \"H\", \"E\", \"M\"]\n   511\t                row_labels = labels if corr_before.shape[0] == len(labels) else None\n   512\t                inputs[\"_corr_before_df\"] = pd.DataFrame(\n   513\t                    corr_before,\n   514\t                    index=row_labels,\n   515\t                    columns=row_labels,\n   516\t                )\n   517\t                inputs[\"_corr_after_df\"] = pd.DataFrame(\n   518\t                    corr_after,\n   519\t                    index=row_labels,\n   520\t                    columns=row_labels,\n   521\t                )\n   522\t                inputs[\"_corr_delta_df\"] = pd.DataFrame(\n   523\t                    corr_delta,\n   524\t                    index=row_labels,\n   525\t                    columns=row_labels,\n   526\t                )\n   527\t        inputs[\"_corr_repair_info_df\"] = pd.DataFrame(\n   528\t            [\n   529\t                {\n   530\t                    \"mode\": corr_repair_info.get(\"repair_mode\"),\n   531\t                    \"method\": corr_repair_info.get(\"method\"),\n   532\t                    \"shrinkage\": corr_repair_info.get(\"shrinkage\"),\n   533\t                    \"min_eigenvalue_before\": corr_repair_info.get(\"min_eigenvalue_before\"),\n   534\t                    \"min_eigenvalue_after\": corr_repair_info.get(\"min_eigenvalue_after\"),\n   535\t                    \"max_abs_delta\": corr_repair_info.get(\"max_abs_delta\"),\n   536\t                }\n   537\t            ]\n   538\t        )\n   539\t        if corr_repair_info.get(\"repair_applied\"):\n   540\t            inputs[\"correlation_repair_applied\"] = True\n   541\t            inputs[\"correlation_repair_details\"] = json.dumps(corr_repair_info)\n   542\t    _serialize_agent_semantics_input(inputs)\n   543\t    manifest = {\n   544\t        \"seed\": run_options.seed,\n   545\t        \"substream_ids\": substream_ids,\n   546\t    }\n   547\t\n   548\t    artifacts = RunArtifacts(\n   549\t        config=run_cfg,\n   550\t        index_series=idx_series,\n   551\t        returns=returns,\n   552\t        summary=summary,\n   553\t        inputs=inputs,\n   554\t        raw_returns=raw_returns,\n   555\t        manifest=manifest,\n   556\t    )\n   557\t    from .llm.scenario_fleet import SCENARIO_RUN_OPERATION, record_scenario_run\n   558\t\n   559\t    record_scenario_run(\n   560\t        run_cfg,\n   561\t        summary,\n   562\t        seed=run_options.seed,\n   563\t        latency_ms=int((time.perf_counter() - started) * 1000),\n   564\t        operation=SCENARIO_RUN_OPERATION,\n   565\t    )\n   566\t    return artifacts\n   567\t\n   568\t\n   569\tdef run_sweep(\n   570\t    config: \"ModelConfig\",\n   571\t    index_series: \"pd.Series\",\n   572\t    sweep_params: Mapping[str, Any] | None = None,\n   573\t    options: RunOptions | None = None,\n   574\t) -> SweepArtifacts:\n   575\t    \"\"\"Run a parameter sweep with optional overrides and return artifacts.\n   576\t\n   577\t    Executes simulations across a grid of parameter combinations defined by\n   578\t    the analysis_mode in the configuration. Supports capital allocation sweeps,\n   579\t    return parameter sweeps, alpha share sweeps, and volatility multiplier sweeps.\n   580\t\n   581\t    Args:\n   582\t        config: Model configuration specifying base simulation parameters.\n   583\t        index_series: Benchmark index returns as a pandas Series.\n   584\t        sweep_params: Optional dictionary of sweep-specific parameter overrides\n   585\t            (e.g., analysis_mode, sweep ranges, step sizes).\n   586\t        options: Optional RunOptions with seed, backend, and config overrides.\n   587\t\n   588\t    Returns:\n   589\t        SweepArtifacts containing results for each parameter combination,\n   590\t        consolidated summary DataFrame, and metadata.\n   591\t\n   592\t    Raises:\n   593\t        ValueError: If index_series cannot be converted to a pandas Series.\n   594\t\n   595\t    Example::\n   596\t\n   597\t        from pa_core.config import load_config\n   598\t        from pa_core.facade import run_sweep, RunOptions\n   599\t\n   600\t        cfg = load_config(\"config.yml\")\n   601\t        idx = pd.read_csv(\"index.csv\")[\"returns\"]\n   602\t\n   603\t        # Run volatility multiplier sweep\n   604\t        sweep_params = {\n   605\t            \"analysis_mode\": \"vol_mult\",\n   606\t            \"sd_multiple_min\": 0.5,\n   607\t            \"sd_multiple_max\": 2.0,\n   608\t            \"sd_multiple_step\": 0.25,\n   609\t        }\n   610\t        artifacts = run_sweep(cfg, idx, sweep_params, RunOptions(seed=42))\n   611\t\n   612\t        # Access consolidated results\n   613\t        print(artifacts.summary)\n   614\t    \"\"\"\n   615\t\n   616\t    import pandas as pd\n   617\t\n   618\t    from .backend import resolve_and_set_backend\n   619\t    from .sim.simulation_initialization import initialize_sweep_rngs\n   620\t    from .sweep import run_parameter_sweep, sweep_results_to_dataframe\n   621\t\n   622\t    started = time.perf_counter()\n   623\t    run_options = options or RunOptions()\n   624\t    run_cfg = apply_run_options(config, run_options, sweep_params)\n   625\t    resolve_and_set_backend(run_options.backend, run_cfg)\n   626\t\n   627\t    idx_series = index_series\n   628\t    if isinstance(idx_series, pd.DataFrame):\n   629\t        idx_series = idx_series.squeeze()\n   630\t        if not isinstance(idx_series, pd.Series):\n   631\t            raise ValueError(\"Index data must be convertible to pandas Series\")\n   632\t    elif not isinstance(idx_series, pd.Series):\n   633\t        raise ValueError(\"Index data must be a pandas Series\")\n   634\t\n   635\t    rng_bundle = initialize_sweep_rngs(\n   636\t        run_options.seed,\n   637\t        legacy_agent_rng=run_options.legacy_agent_rng,\n   638\t    )\n   639\t    rng_returns = rng_bundle.rng_returns\n   640\t    fin_rngs = rng_bundle.rngs_financing\n   641\t    substream_ids = rng_bundle.substream_ids\n   642\t    child_seed = rng_bundle.seed\n   643\t    results = run_parameter_sweep(\n   644\t        run_cfg,\n   645\t        idx_series,\n   646\t        rng_returns,\n   647\t        fin_rngs,\n   648\t        seed=child_seed,\n   649\t        rng_regime=rng_bundle.rng_regime,\n   650\t    )\n   651\t    summary = sweep_results_to_dataframe(results)\n   652\t    inputs = run_cfg.model_dump()\n   653\t\n   654\t    manifest = {\n   655\t        \"seed\": run_options.seed,\n   656\t        \"substream_ids\": substream_ids,\n   657\t    }\n   658\t\n   659\t    artifacts = SweepArtifacts(\n   660\t        config=run_cfg,\n   661\t        index_series=idx_series,\n   662\t        results=results,\n   663\t        summary=summary,\n   664\t        inputs=inputs,\n   665\t        manifest=manifest,\n   666\t    )\n   667\t    from .llm.scenario_fleet import SCENARIO_SWEEP_OPERATION, record_scenario_run\n   668\t\n   669\t    record_scenario_run(\n   670\t        run_cfg,\n   671\t        summary,\n   672\t        seed=run_options.seed,\n   673\t        latency_ms=int((time.perf_counter() - started) * 1000),\n   674\t        operation=SCENARIO_SWEEP_OPERATION,\n   675\t    )\n   676\t    return artifacts\n   677\t\n   678\t\n   679\tdef export(\n   680\t    artifacts: RunArtifacts | SweepArtifacts,\n--- config models 180-460 and validators ---\n   170\t\n   171\tclass SweepConfig(BaseModel):\n   172\t    \"\"\"Sweep configuration specifying sampling method and parameter ranges.\"\"\"\n   173\t\n   174\t    model_config = ConfigDict(frozen=True)\n   175\t\n   176\t    method: Literal[\"grid\", \"random\"] = \"grid\"\n   177\t    parameters: Dict[str, SweepParameter]\n   178\t    samples: int | None = None\n   179\t    seed: int | None = None\n   180\t\n   181\t    @model_validator(mode=\"after\")\n   182\t    def check_config(self) -> \"SweepConfig\":\n   183\t        if not self.parameters:\n   184\t            raise ValueError(\"SweepConfig.parameters must not be empty.\")\n   185\t        if self.method == \"grid\":\n   186\t            if self.samples is not None:\n   187\t                raise ValueError(\"SweepConfig.samples is only supported for random sampling.\")\n   188\t            for name, param in self.parameters.items():\n   189\t                if param.values is None and param.step is None:\n   190\t                    raise ValueError(\n   191\t                        f\"SweepConfig grid sampling requires step for parameter '{name}'.\"\n   192\t                    )\n   193\t        elif self.method == \"random\":\n   194\t            if self.samples is None or self.samples <= 0:\n   195\t                raise ValueError(\"SweepConfig.samples must be positive for random sampling.\")\n   196\t        return self\n   197\t\n   198\t\n   199\tclass ModelConfig(BaseModel):\n   200\t    \"\"\"Validated simulation parameters for the portable-alpha model.\n   201\t\n   202\t    Use ``ModelConfig`` for run settings, capital allocation, and sweep ranges.\n   203\t    Use :class:`pa_core.schema.Scenario` for index/asset inputs, correlations,\n   204\t    and sleeve definitions. They intentionally serve different roles: this\n   205\t    class controls how simulations run, while ``Scenario`` supplies the market\n   206\t    data and portfolio structure. Pair with\n   207\t    :func:`pa_core.schema.load_scenario` when running a full simulation that\n   208\t    needs both run settings and market data.\n   209\t    \"\"\"\n   210\t\n   211\t    model_config = ConfigDict(populate_by_name=True, frozen=True)\n   212\t\n   213\t    _RETURN_UNIT_EXPLICIT_KEYS: ClassVar[dict[str, dict[str, tuple[str, ...]]]] = {\n   214\t        \"mu_H\": {\n   215\t            \"annual\": (\"mu_H_annual\", \"In-House annual return (%)\"),\n   216\t            \"monthly\": (\"mu_H_monthly\",),\n   217\t        },\n   218\t        \"sigma_H\": {\n   219\t            \"annual\": (\"sigma_H_annual\", \"In-House annual vol (%)\"),\n   220\t            \"monthly\": (\"sigma_H_monthly\",),\n   221\t        },\n   222\t        \"mu_E\": {\n   223\t            \"annual\": (\"mu_E_annual\", \"Alpha-Extension annual return (%)\"),\n   224\t            \"monthly\": (\"mu_E_monthly\",),\n   225\t        },\n   226\t        \"sigma_E\": {\n   227\t            \"annual\": (\"sigma_E_annual\", \"Alpha-Extension annual vol (%)\"),\n   228\t            \"monthly\": (\"sigma_E_monthly\",),\n   229\t        },\n   230\t        \"mu_M\": {\n   231\t            \"annual\": (\"mu_M_annual\", \"External annual return (%)\"),\n   232\t            \"monthly\": (\"mu_M_monthly\",),\n   233\t        },\n   234\t        \"sigma_M\": {\n   235\t            \"annual\": (\"sigma_M_annual\", \"External annual vol (%)\"),\n   236\t            \"monthly\": (\"sigma_M_monthly\",),\n   237\t        },\n   238\t    }\n   239\t    _FINANCING_SPIKE_FIELDS: ClassVar[tuple[tuple[str, str, str], ...]] = (\n   240\t        (\"internal_financing_sigma_month\", \"internal_spike_prob\", \"internal_spike_factor\"),\n   241\t        (\"ext_pa_financing_sigma_month\", \"ext_pa_spike_prob\", \"ext_pa_spike_factor\"),\n   242\t        (\"act_ext_financing_sigma_month\", \"act_ext_spike_prob\", \"act_ext_spike_factor\"),\n   243\t    )\n   244\t\n   245\t    backend: Literal[\"numpy\"] = Field(\n   246\t        default=\"numpy\",\n   247\t        description=(\n   248\t            f\"Computation backend. Only 'numpy' is supported; {BACKEND_UNAVAILABLE_DETAIL}\"\n   249\t        ),\n   250\t    )\n   251\t    N_SIMULATIONS: int = Field(gt=0, alias=\"Number of simulations\")\n   252\t    N_MONTHS: int = Field(gt=0, alias=\"Number of months\")\n   253\t    return_unit: Literal[\"annual\", \"monthly\"] = Field(\n   254\t        default=DEFAULT_RETURN_UNIT,\n   255\t        alias=\"return_unit\",\n   256\t        description=\"Input unit for return means/volatilities.\",\n   257\t    )\n   258\t    return_unit_input: Literal[\"annual\", \"monthly\"] = Field(\n   259\t        default=DEFAULT_RETURN_UNIT,\n   260\t        exclude=True,\n   261\t        description=\"Original return unit provided before normalization.\",\n   262\t    )\n   263\t    mean_conversion: Literal[\"simple\", \"geometric\"] = Field(\n   264\t        default=DEFAULT_MEAN_CONVERSION,\n   265\t        alias=\"Mean conversion\",\n   266\t        description=(\n   267\t            \"How annual mean returns are converted to monthly. 'simple' uses \"\n   268\t            \"mean/12 (the historical default); it is fast but does NOT reproduce \"\n   269\t            \"the configured annual mean once the monthly returns compound. \"\n   270\t            \"'geometric' uses (1+r)**(1/12)-1, so 12 compounded monthly means \"\n   271\t            \"recover the annual mean. Only affects mu_* inputs supplied in annual \"\n   272\t            \"units; volatilities are unchanged.\"\n   273\t        ),\n   274\t    )\n   275\t\n   276\t    return_distribution: str = Field(default=\"normal\", alias=\"Return distribution\")\n   277\t    return_t_df: float = Field(default=5.0, alias=\"Student-t df\")\n   278\t    return_copula: str = Field(default=\"gaussian\", alias=\"Return copula\")\n   279\t    return_distribution_idx: str | None = Field(default=None, alias=\"Index return distribution\")\n   280\t    return_distribution_H: str | None = Field(default=None, alias=\"In-House return distribution\")\n   281\t    return_distribution_E: str | None = Field(\n   282\t        default=None, alias=\"Alpha-Extension return distribution\"\n   283\t    )\n   284\t    return_distribution_M: str | None = Field(default=None, alias=\"External PA return distribution\")\n   285\t\n   286\t    external_pa_capital: float = Field(default=0.0, alias=\"External PA capital (mm)\")\n   287\t    active_ext_capital: float = Field(default=0.0, alias=\"Active Extension capital (mm)\")\n   288\t    internal_pa_capital: float = Field(default=0.0, alias=\"Internal PA capital (mm)\")\n   289\t    total_fund_capital: float = Field(default=1000.0, gt=0, alias=\"Total fund capital (mm)\")\n   290\t    agents: List[AgentConfig] = Field(default_factory=list)\n   291\t    fee_schedule: Dict[str, FeeSchedule] | None = Field(\n   292\t        default=None,\n   293\t        description=(\n   294\t            \"Optional per-sleeve management/performance fee schedule keyed by \"\n   295\t            \"agent name (e.g. 'ExternalPA', 'ActiveExt'). When set, that sleeve's \"\n   296\t            \"returns are reported net of fees (issue #1904). None or empty keeps \"\n   297\t            \"the historical gross-of-fee behaviour.\"\n   298\t        ),\n   299\t    )\n   300\t\n   301\t    w_beta_H: float = Field(default=0.5, alias=\"In-House beta share\")\n   302\t    w_alpha_H: float = Field(default=0.5, alias=\"In-House alpha share\")\n   303\t    theta_extpa: float = Field(default=0.5, alias=\"External PA alpha fraction\")\n   304\t    active_share: float = Field(\n   305\t        default=0.5,\n   306\t        alias=\"Active share (%)\",\n   307\t        validation_alias=AliasChoices(\"Active share (%)\", \"Active share\"),\n   308\t        description=\"Active share fraction (0..1)\",\n   309\t    )\n   310\t\n   311\t    # Transfer-coefficient (diminishing-returns) controls for the active-extension\n   312\t    # and external-PA alpha levers (issue #1924). With decay == 0 the alpha scales\n   313\t    # linearly with the lever (legacy behaviour, the default). With decay > 0 the\n   314\t    # transfer coefficient TC(s) = 1 / (1 + decay * s) makes expected alpha concave\n   315\t    # in the lever (information ratio declines as the active bet grows), matching the\n   316\t    # Grinold-Kahn / Clarke-de Silva-Thorley fundamental-law result. The optional\n   317\t    # per-share extension cost (monthly, as a fraction) produces an interior optimum.\n   318\t    active_share_tc_decay: float = Field(\n   319\t        default=0.0,\n   320\t        ge=0.0,\n   321\t        alias=\"Active-share alpha decay (kappa)\",\n   322\t        description=(\n   323\t            \"Transfer-coefficient decay for ActiveExt: TC(s)=1/(1+kappa*s). \"\n   324\t            \"0.0 = linear/legacy; larger = stronger diminishing returns to active share.\"\n   325\t        ),\n   326\t    )\n   327\t    theta_tc_decay: float = Field(\n   328\t        default=0.0,\n   329\t        ge=0.0,\n   330\t        alias=\"External-PA alpha decay (kappa)\",\n   331\t        description=\"Transfer-coefficient decay for ExternalPA: TC(theta)=1/(1+kappa*theta). 0.0 = legacy.\",\n   332\t    )\n   333\t    active_ext_cost_per_share: float = Field(\n   334\t        default=0.0,\n   335\t        ge=0.0,\n   336\t        alias=\"Active Ext extension cost (monthly %/share)\",\n   337\t        description=\"Monthly extension cost charged per unit of active_share on the ActiveExt sleeve.\",\n   338\t    )\n   339\t    ext_pa_cost_per_share: float = Field(\n   340\t        default=0.0,\n   341\t        ge=0.0,\n   342\t        alias=\"External PA extension cost (monthly %/share)\",\n   343\t        description=\"Monthly extension cost charged per unit of theta on the ExternalPA sleeve.\",\n   344\t    )\n   345\t\n   346\t    mu_H: float = Field(default=0.04, alias=\"In-House annual return (%)\")\n   347\t    sigma_H: float = Field(default=0.01, alias=\"In-House annual vol (%)\")\n   348\t    mu_E: float = Field(default=0.05, alias=\"Alpha-Extension annual return (%)\")\n   349\t    sigma_E: float = Field(default=0.02, alias=\"Alpha-Extension annual vol (%)\")\n   350\t    mu_M: float = Field(default=0.03, alias=\"External annual return (%)\")\n   351\t    sigma_M: float = Field(default=0.02, alias=\"External annual vol (%)\")\n   352\t\n   353\t    rho_idx_H: float = Field(default=0.05, alias=\"Corr index–In-House\")\n   354\t    rho_idx_E: float = Field(default=0.0, alias=\"Corr index–Alpha-Extension\")\n   355\t    rho_idx_M: float = Field(default=0.0, alias=\"Corr index–External\")\n   356\t    rho_H_E: float = Field(default=0.10, alias=\"Corr In-House–Alpha-Extension\")\n   357\t    rho_H_M: float = Field(default=0.10, alias=\"Corr In-House–External\")\n   358\t    rho_E_M: float = Field(default=0.0, alias=\"Corr Alpha-Extension–External\")\n   359\t\n   360\t    correlation_repair_mode: Literal[\"error\", \"warn_fix\"] = \"warn_fix\"\n   361\t    correlation_repair_shrinkage: float = Field(default=0.0)\n   362\t    correlation_repair_max_abs_delta: float | None = Field(default=None)\n   363\t\n   364\t    covariance_shrinkage: Literal[\"none\", \"ledoit_wolf\"] = \"none\"\n   365\t    vol_regime: Literal[\"single\", \"two_state\"] = \"single\"\n   366\t    vol_regime_window: int = 12\n   367\t\n   368\t    internal_financing_mean_month: float = Field(\n   369\t        default=0.0, alias=\"Internal financing mean (monthly %)\"\n   370\t    )\n   371\t    internal_financing_sigma_month: float = Field(\n   372\t        default=0.0, ge=0, alias=\"Internal financing vol (monthly %)\"\n   373\t    )\n   374\t    internal_spike_prob: float = Field(default=0.0, ge=0, le=1, alias=\"Internal monthly spike prob\")\n   375\t    internal_spike_factor: float = Field(default=0.0, alias=\"Internal spike multiplier\")\n   376\t\n   377\t    # Internal-PA financing cost (issue #1849). Distinct from the margin\n   378\t    # financing spread above: this is the cost of funding the in-house alpha\n   379\t    # position held by the InternalPA sleeve. Positive values are a cost and\n   380\t    # lower the sleeve return; negative values are a benefit/positive carry and\n   381\t    # are never clipped. A scenario may express the cost as a deterministic\n   382\t    # monthly mean (optionally perturbed by a vol), an explicit monthly series,\n   383\t    # or a named index futures/swap financing curve.\n   384\t    internal_pa_financing_mean_month: float = Field(\n   385\t        default=0.0,\n   386\t        alias=\"Internal PA financing mean (monthly %)\",\n   387\t        description=\"Deterministic monthly internal-PA financing cost; may be negative.\",\n   388\t    )\n   389\t    internal_pa_financing_sigma_month: float = Field(\n   390\t        default=0.0,\n   391\t        ge=0,\n   392\t        alias=\"Internal PA financing vol (monthly %)\",\n   393\t        description=\"Optional monthly stochastic vol for the internal-PA financing cost.\",\n   394\t    )\n   395\t    internal_pa_financing_series: List[float] | None = Field(\n   396\t        default=None,\n   397\t        alias=\"Internal PA financing series (monthly)\",\n   398\t        description=\"Explicit monthly internal-PA financing cost series (negatives allowed).\",\n   399\t    )\n   400\t    internal_pa_financing_index: str | None = Field(\n   401\t        default=None,\n   402\t        alias=\"Internal PA financing index\",\n   403\t        description=\"Named index futures/swap financing curve to source internal-PA costs from.\",\n   404\t    )\n   405\t\n   406\t    ext_pa_financing_mean_month: float = Field(\n   407\t        default=0.0, alias=\"External PA financing mean (monthly %)\"\n   408\t    )\n   409\t    ext_pa_financing_sigma_month: float = Field(\n   410\t        default=0.0, ge=0, alias=\"External PA financing vol (monthly %)\"\n   411\t    )\n   412\t    ext_pa_spike_prob: float = Field(\n   413\t        default=0.0, ge=0, le=1, alias=\"External PA monthly spike prob\"\n   414\t    )\n   415\t    ext_pa_spike_factor: float = Field(default=0.0, alias=\"External PA spike multiplier\")\n   416\t\n   417\t    act_ext_financing_mean_month: float = Field(\n   418\t        default=0.0, alias=\"Active Ext financing mean (monthly %)\"\n   419\t    )\n   420\t    act_ext_financing_sigma_month: float = Field(\n   421\t        default=0.0, ge=0, alias=\"Active Ext financing vol (monthly %)\"\n   422\t    )\n   423\t    act_ext_spike_prob: float = Field(\n   424\t        default=0.0, ge=0, le=1, alias=\"Active Ext monthly spike prob\"\n   425\t    )\n   426\t    act_ext_spike_factor: float = Field(default=0.0, alias=\"Active Ext spike multiplier\")\n   427\t    financing_mode: Literal[\"per_path\", \"broadcast\"] = Field(\n   428\t        ...,\n   429\t        description=(\n   430\t            \"Financing draw mode. per_path draws independent financing paths per \"\n   431\t            \"scenario and is recommended for risk/tail analysis; broadcast reuses \"\n   432\t            \"one financing vector across all simulations, which suppresses \"\n   433\t            \"financing-cost dispersion and understates tail/CVaR risk.\"\n   434\t        ),\n   435\t    )\n   436\t\n   437\t    # Parameter sweep options\n   438\t    analysis_mode: str = Field(default=\"returns\", alias=\"Analysis mode\")\n   439\t    sweep: SweepConfig | None = Field(\n   440\t        default=None,\n   441\t        description=\"Optional sweep configuration for custom parameter sampling.\",\n   442\t    )\n   443\t\n   444\t    max_external_combined_pct: float = 30.0\n   445\t    external_step_size_pct: float = 5.0\n   446\t\n   447\t    in_house_return_min_pct: float = 2.0\n   448\t    in_house_return_max_pct: float = 6.0\n   449\t    in_house_return_step_pct: float = 2.0\n   450\t    in_house_vol_min_pct: float = 1.0\n   451\t    in_house_vol_max_pct: float = 3.0\n   452\t    in_house_vol_step_pct: float = 1.0\n   453\t    alpha_ext_return_min_pct: float = 1.0\n   454\t    alpha_ext_return_max_pct: float = 5.0\n   455\t    alpha_ext_return_step_pct: float = 2.0\n   456\t    alpha_ext_vol_min_pct: float = 2.0\n   457\t    alpha_ext_vol_max_pct: float = 4.0\n   458\t    alpha_ext_vol_step_pct: float = 1.0\n   459\t\n   460\t    external_pa_alpha_min_pct: float = 25.0\n   900\t            elif isinstance(agent, Mapping):\n   901\t                agent_data = dict(agent)\n   902\t            else:\n   903\t                raise ValueError(f\"agents[{idx}] must be a mapping\")\n   904\t            missing = {\"name\", \"capital\", \"beta_share\", \"alpha_share\"} - agent_data.keys()\n   905\t            if missing:\n   906\t                raise ValueError(f\"agents[{idx}] missing keys: {sorted(missing)}\")\n   907\t            extra = agent_data.get(\"extra\") or {}\n   908\t            if not isinstance(extra, dict):\n   909\t                raise ValueError(f\"agents[{idx}].extra must be a mapping\")\n   910\t            beta_share = normalize_share(agent_data[\"beta_share\"])\n   911\t            alpha_share = normalize_share(agent_data[\"alpha_share\"])\n   912\t            normalized.append(\n   913\t                {\n   914\t                    \"name\": str(agent_data[\"name\"]),\n   915\t                    \"capital\": float(agent_data[\"capital\"]),\n   916\t                    \"beta_share\": 0.0 if beta_share is None else float(beta_share),\n   917\t                    \"alpha_share\": 0.0 if alpha_share is None else float(alpha_share),\n   918\t                    \"extra\": extra,\n   919\t                }\n   920\t            )\n   921\t        return normalized\n   922\t\n   923\t    @model_validator(mode=\"after\")\n   924\t    def check_financing_model(self) -> \"ModelConfig\":\n   925\t        self._trace_transform(self, \"check_financing_model\")\n   926\t        valid = {\"simple_proxy\", \"schedule\"}\n   927\t        if self.financing_model not in valid:\n   928\t            raise ValueError(f\"financing_model must be one of: {sorted(valid)}\")\n   929\t        if self.financing_model == \"schedule\" and self.financing_schedule_path is None:\n   930\t            raise ValueError(\"financing_schedule_path required for schedule financing model\")\n   931\t        return self\n   932\t\n   933\t    @model_validator(mode=\"after\")\n   934\t    def check_financing_spikes_have_volatility(self) -> \"ModelConfig\":\n   935\t        self._trace_transform(self, \"check_financing_spikes_have_volatility\")\n   936\t        validate_financing_spikes(self)\n   937\t        return self\n   938\t\n   939\t    @model_validator(mode=\"after\")\n   940\t    def check_capital(self) -> \"ModelConfig\":\n   941\t        self._trace_transform(self, \"check_capital\")\n   942\t        from .validators import validate_capital_allocation\n   943\t\n   944\t        cap_sum = self.external_pa_capital + self.active_ext_capital + self.internal_pa_capital\n   945\t        if cap_sum > self.total_fund_capital:\n   946\t            raise ValueError(\"Capital allocation exceeds total_fund_capital\")\n   947\t\n   948\t        # Enhanced capital validation with margin requirements\n   949\t        validation_results = validate_capital_allocation(\n   950\t            external_pa_capital=self.external_pa_capital,\n   951\t            active_ext_capital=self.active_ext_capital,\n   952\t            internal_pa_capital=self.internal_pa_capital,\n   953\t            total_fund_capital=self.total_fund_capital,\n   954\t            reference_sigma=self.reference_sigma,\n   955\t            volatility_multiple=self.volatility_multiple,\n   956\t            financing_model=self.financing_model,\n   957\t            margin_schedule_path=self.financing_schedule_path,\n   958\t            term_months=self.financing_term_months,\n   959\t        )\n   960\t\n   961\t        # Check for critical errors\n   962\t        errors = [r for r in validation_results if not r.is_valid]\n   963\t        if errors:\n   964\t            error_messages = [r.message for r in errors]\n   965\t            raise ValueError(\"; \".join(error_messages))\n   966\t\n   967\t        if \"terminal_ShortfallProb\" not in self.risk_metrics:\n   968\t            raise ConfigError(\"risk_metrics must include terminal_ShortfallProb\")\n   969\t        return self\n   970\t\n   971\t    @model_validator(mode=\"after\")\n   972\t    def check_return_distribution(self) -> \"ModelConfig\":\n   973\t        self._trace_transform(self, \"check_return_distribution\")\n   974\t        valid_distributions = {\"normal\", \"student_t\"}\n   975\t        valid_copulas = {\"gaussian\", \"t\"}\n   976\t        if self.return_distribution not in valid_distributions:\n   977\t            raise ValueError(f\"return_distribution must be one of: {sorted(valid_distributions)}\")\n   978\t        for dist in (\n   979\t            self.return_distribution_idx,\n   980\t            self.return_distribution_H,\n   981\t            self.return_distribution_E,\n   982\t            self.return_distribution_M,\n   983\t        ):\n   984\t            if dist is not None and dist not in valid_distributions:\n   985\t                raise ValueError(\n   986\t                    f\"return_distribution must be one of: {sorted(valid_distributions)}\"\n   987\t                )\n   988\t        if self.return_copula not in valid_copulas:\n   989\t            raise ValueError(f\"return_copula must be one of: {sorted(valid_copulas)}\")\n   990\t        resolved = (\n   991\t            self.return_distribution_idx or self.return_distribution,\n   992\t            self.return_distribution_H or self.return_distribution,\n   993\t            self.return_distribution_E or self.return_distribution,\n   994\t            self.return_distribution_M or self.return_distribution,\n   995\t        )\n   996\t        if all(dist == \"normal\" for dist in resolved) and self.return_copula != \"gaussian\":\n   997\t            raise ValueError(\n   998\t                \"return_copula must be 'gaussian' when return_distribution is 'normal'\"\n   999\t            )\n  1000\t        if not math.isfinite(self.return_t_df) or (\n  1001\t            any(dist == \"student_t\" for dist in resolved) and self.return_t_df <= 2.0\n  1002\t        ):\n  1003\t            raise ValueError(\"return_t_df must be finite and greater than 2 for finite variance\")\n  1004\t        return self\n  1005\t\n  1006\t    @model_validator(mode=\"after\")\n  1007\t    def check_correlations(self) -> \"ModelConfig\":\n  1008\t        self._trace_transform(self, \"check_correlations\")\n  1009\t        from .validators import validate_correlations\n  1010\t\n  1011\t        correlation_map = {\n  1012\t            \"rho_idx_H\": self.rho_idx_H,\n  1013\t            \"rho_idx_E\": self.rho_idx_E,\n  1014\t            \"rho_idx_M\": self.rho_idx_M,\n  1015\t            \"rho_H_E\": self.rho_H_E,\n  1016\t            \"rho_H_M\": self.rho_H_M,\n  1017\t            \"rho_E_M\": self.rho_E_M,\n  1018\t        }\n  1019\t        validation_results = validate_correlations(correlation_map)\n  1020\t        errors = [r for r in validation_results if not r.is_valid]\n  1021\t        if errors:\n  1022\t            error_messages = [r.message for r in errors]\n  1023\t            raise ValueError(\"; \".join(error_messages))\n  1024\t        return self\n  1025\t\n  1026\t    @model_validator(mode=\"after\")\n  1027\t    def check_regimes(self) -> \"ModelConfig\":\n  1028\t        self._trace_transform(self, \"check_regimes\")\n  1029\t        if self.regimes is None:\n  1030\t            if self.regime_transition is not None:\n  1031\t                raise ValueError(\"regime_transition requires regimes\")\n  1032\t            if self.regime_start is not None:\n  1033\t                raise ValueError(\"regime_start requires regimes\")\n  1034\t            return self\n  1035\t\n  1036\t        if not self.regimes:\n  1037\t            raise ValueError(\"regimes must include at least one regime\")\n  1038\t        names = [regime.name for regime in self.regimes]\n  1039\t        duplicate_names = sorted({name for name in names if names.count(name) > 1})\n  1040\t        if duplicate_names:\n  1041\t            raise ValueError(f\"regime names must be unique; duplicates found: {duplicate_names}\")\n  1042\t        if self.regime_transition is None:\n  1043\t            raise ValueError(\"regime_transition is required when regimes are specified\")\n  1044\t\n  1045\t        n_regimes = len(self.regimes)\n  1046\t        transition = self.regime_transition\n  1047\t        if len(transition) != n_regimes or any(len(row) != n_regimes for row in transition):\n  1048\t            raise ValueError(\"regime_transition must be a square matrix matching regimes length\")\n  1049\t\n  1050\t        for row_idx, row in enumerate(transition):\n  1051\t            row_sum = float(sum(row))\n  1052\t            if any(prob < 0.0 or prob > 1.0 for prob in row):\n  1053\t                raise ValueError(f\"regime_transition[{row_idx}] values must be between 0 and 1\")\n  1054\t            if not math.isclose(row_sum, 1.0, abs_tol=1e-6):\n  1055\t                raise ValueError(f\"regime_transition[{row_idx}] must sum to 1\")\n  1056\t\n  1057\t        if self.regime_start is not None and self.regime_start not in names:\n  1058\t            raise ValueError(\"regime_start must match a regime name\")\n  1059\t        return self\n  1060\t\n  1061\t    @model_validator(mode=\"after\")\n  1062\t    def check_correlation_repairs(self) -> \"ModelConfig\":\n  1063\t        self._trace_transform(self, \"check_correlation_repairs\")\n  1064\t        if not 0.0 <= self.correlation_repair_shrinkage <= 1.0:\n  1065\t            raise ValueError(\"correlation_repair_shrinkage must be between 0 and 1\")\n  1066\t        if (\n  1067\t            self.correlation_repair_max_abs_delta is not None\n  1068\t            and self.correlation_repair_max_abs_delta < 0.0\n  1069\t        ):\n  1070\t            raise ValueError(\"correlation_repair_max_abs_delta must be non-negative\")\n  1071\t        return self\n  1072\t\n  1073\t    @model_validator(mode=\"after\")\n  1074\t    def check_shares(self) -> \"ModelConfig\":\n  1075\t        self._trace_transform(self, \"check_shares\")\n  1076\t        for name, val in [(\"w_beta_H\", self.w_beta_H), (\"w_alpha_H\", self.w_alpha_H)]:\n  1077\t            if not SHARE_MIN <= val <= SHARE_MAX:\n  1078\t                raise ValueError(f\"{name} must be between 0 and 1\")\n  1079\t        if abs(self.w_beta_H + self.w_alpha_H - 1.0) > SHARE_SUM_TOLERANCE:\n  1080\t            raise ValueError(\"w_beta_H and w_alpha_H must sum to 1\")\n  1081\t        for name, val in [\n  1082\t            (\"theta_extpa\", self.theta_extpa),\n  1083\t            (\"active_share\", self.active_share),\n  1084\t        ]:\n  1085\t            if not SHARE_MIN <= val <= SHARE_MAX:\n  1086\t                raise ValueError(f\"{name} must be between 0 and 1\")\n  1087\t        return self\n  1088\t\n  1089\t    @model_validator(mode=\"after\")\n  1090\t    def check_agents(self) -> \"ModelConfig\":\n  1091\t        errors: list[str] = []\n  1092\t        names = [agent.name for agent in self.agents]\n  1093\t        if not names:\n  1094\t            errors.append(\"agents must include at least one agent\")\n  1095\t        name_to_indices: dict[str, list[int]] = {}\n  1096\t        for idx, name in enumerate(names):\n  1097\t            name_to_indices.setdefault(name, []).append(idx)\n  1098\t        duplicate_names = sorted({name for name in names if names.count(name) > 1})\n  1099\t        if duplicate_names:\n  1100\t            duplicate_detail = \", \".join(\n  1101\t                f\"{name} (indices {name_to_indices[name]})\" for name in duplicate_names\n  1102\t            )\n  1103\t            errors.append(\"agent names must be unique; duplicates found: \" + duplicate_detail)\n  1104\t        benchmark_count = sum(1 for name in names if name == \"Base\")\n  1105\t        if benchmark_count != 1:\n  1106\t            base_indices = name_to_indices.get(\"Base\", [])\n  1107\t            extra_hint = \"\"\n  1108\t            if benchmark_count == 0:\n  1109\t                extra_hint = \" Add an agent with name 'Base' to the agents list.\"\n  1110\t                if names:\n  1111\t                    existing_names = \", \".join(sorted(set(names)))\n  1112\t                    extra_hint += f\" Existing agents: {existing_names}.\"\n  1113\t            else:\n  1114\t                extra_hint = f\" Found Base at indices {base_indices}; remove duplicates.\"\n  1115\t            errors.append(\n  1116\t                f\"exactly one benchmark agent named 'Base' is required; found {benchmark_count}.\"\n  1117\t                f\"{extra_hint}\"\n  1118\t            )\n  1119\t\n  1120\t        for idx, agent in enumerate(self.agents):\n","exit_code":0,"status":"completed"}}
