\n   730\t\n   731\t        groups = {\n   732\t            \"Base\": {\n   733\t                \"total_fund_capital\",\n   734\t                \"Total fund capital (mm)\",\n   735\t                \"w_beta_H\",\n   736\t                \"w_alpha_H\",\n   737\t                \"In-House beta share\",\n   738\t                \"In-House alpha share\",\n   739\t            },\n   740\t            \"ExternalPA\": {\n   741\t                \"total_fund_capital\",\n   742\t                \"Total fund capital (mm)\",\n   743\t                \"external_pa_capital\",\n   744\t                \"External PA capital (mm)\",\n   745\t                \"theta_extpa\",\n   746\t                \"External PA alpha fraction\",\n   747\t            },\n   748\t            \"ActiveExt\": {\n   749\t                \"total_fund_capital\",\n   750\t                \"Total fund capital (mm)\",\n   751\t                \"active_ext_capital\",\n   752\t                \"Active Extension capital (mm)\",\n   753\t                \"active_share\",\n   754\t                \"Active share (%)\",\n   755\t                \"Active share\",\n   756\t            },\n   757\t            \"InternalPA\": {\n   758\t                \"total_fund_capital\",\n   759\t                \"Total fund capital (mm)\",\n   760\t                \"internal_pa_capital\",\n   761\t                \"Internal PA capital (mm)\",\n   762\t            },\n   763\t        }\n   764\t        return {\n   765\t            agent_name for agent_name, keys in groups.items() if any(key in data for key in keys)\n   766\t        }\n   767\t\n   768\t    @classmethod\n   769\t    def normalize_share_inputs(cls, data: Any) -> Any:\n   770\t        if not isinstance(data, dict):\n   771\t            return data\n   772\t        cls._trace_transform(data, \"normalize_share_inputs\")\n   773\t        share_fields = {\n   774\t            \"w_beta_H\": (\"In-House beta share\",),\n   775\t            \"w_alpha_H\": (\"In-House alpha share\",),\n   776\t            \"active_share\": (\"Active share (%)\", \"Active share\"),\n   777\t            \"theta_extpa\": (\"External PA alpha fraction\",),\n   778\t        }\n   779\t        for field, aliases in share_fields.items():\n   780\t            for key in (field, *aliases):\n   781\t                if key in data:\n   782\t                    data[key] = normalize_share(data[key])\n   783\t        return data\n   784\t\n   785\t    @classmethod\n   786\t    def _normalize_regime_sigma_overrides(cls, regimes: Any) -> Any:\n   787\t        if (\n   788\t            regimes is None\n   789\t            or isinstance(regimes, (str, bytes))\n   790\t            or not isinstance(regimes, Sequence)\n   791\t        ):\n   792\t            return regimes\n   793\t\n   794\t        normalized: list[Any] = []\n   795\t        for regime in regimes:\n   796\t            if isinstance(regime, RegimeConfig):\n   797\t                updates = {\n   798\t                    field: annual_vol_to_monthly(float(value))\n   799\t                    for field in (\"sigma_H\", \"sigma_E\", \"sigma_M\")\n   800\t                    if (value := getattr(regime, field)) is not None\n   801\t                }\n   802\t                normalized.append(regime.model_copy(update=updates) if updates else regime)\n   803\t                continue\n   804\t\n   805\t            if isinstance(regime, Mapping):\n   806\t                regime_data = dict(regime)\n   807\t                for field in (\"sigma_H\", \"sigma_E\", \"sigma_M\"):\n   808\t                    value = regime_data.get(field)\n   809\t                    if value is not None:\n   810\t                        regime_data[field] = annual_vol_to_monthly(float(value))\n   811\t                normalized.append(regime_data)\n   812\t                continue\n   813\t\n   814\t            normalized.append(regime)\n   815\t        return normalized\n   816\t\n   817\t    @classmethod\n   818\t    def normalize_return_units(cls, data: Any) -> Any:\n   819\t        if not isinstance(data, dict):\n   820\t            return data\n   821\t        cls._trace_transform(data, \"normalize_return_units\")\n   822\t        updated, explicit_unit, legacy_fields = cls._apply_explicit_return_units(data)\n   823\t        unit = explicit_unit or updated.get(\"return_unit\", DEFAULT_RETURN_UNIT)\n   824\t        if explicit_unit and \"return_unit\" in updated and updated[\"return_unit\"] != explicit_unit:\n   825\t            raise ValueError(\n   826\t                \"return_unit conflicts with explicitly unit-tagged return inputs. \"\n   827\t                \"Align return_unit with the explicit mu/sigma unit or remove return_unit.\"\n   828\t            )\n   829\t        updated[\"return_unit_input\"] = unit\n   830\t        if \"return_unit\" not in updated:\n   831\t            updated[\"return_unit\"] = unit\n   832\t        if legacy_fields:\n   833\t            warning_fields = \", \".join(sorted(legacy_fields))\n   834\t            warnings.warn(\n   835\t                \"Ambiguous return inputs detected for legacy fields: \"\n   836\t                f\"{warning_fields}. Use explicit keys like mu_H_annual or mu_H_monthly. \"\n   837\t                \"Legacy field names will be deprecated.\",\n   838\t                DeprecationWarning,\n   839\t                stacklevel=2,\n   840\t            )\n   841\t        if unit == CANONICAL_RETURN_UNIT:\n   842\t            return updated\n   843\t        if unit != DEFAULT_RETURN_UNIT:\n   844\t            return updated\n   845\t\n   846\t        # Allow values to be supplied via field names or aliases.\n   847\t        def _get_value(field: str) -> tuple[Any, list[str]]:\n   848\t            field_info = cls.model_fields[field]\n   849\t            candidates = [field]\n   850\t            alias = getattr(field_info, \"alias\", None)\n   851\t            if alias:\n   852\t                candidates.append(alias)\n   853\t            for key in candidates:\n   854\t                if key in updated:\n   855\t                    return updated[key], candidates\n   856\t            return field_info.default, candidates\n   857\t\n   858\t        mean_method, _ = _get_value(\"mean_conversion\")\n   859\t        if mean_method not in (\"simple\", \"geometric\"):\n   860\t            # Leave the invalid value in place so the Literal field validator\n   861\t            # raises a clear error; fall back to the historical default here so\n   862\t            # the pre-validation conversion stays deterministic.\n   863\t            mean_method = DEFAULT_MEAN_CONVERSION\n   864\t        for field in (\"mu_H\", \"mu_E\", \"mu_M\"):\n   865\t            value, keys = _get_value(field)\n   866\t            converted = annual_mean_to_monthly(value, method=mean_method)\n   867\t            for key in keys:\n   868\t                updated[key] = converted\n   869\t        for field in (\"sigma_H\", \"sigma_E\", \"sigma_M\"):\n   870\t            value, keys = _get_value(field)\n   871\t            converted = annual_vol_to_monthly(value)\n   872\t            for key in keys:\n   873\t                updated[key] = converted\n   874\t        if \"regimes\" in updated:\n   875\t            updated[\"regimes\"] = cls._normalize_regime_sigma_overrides(updated[\"regimes\"])\n   876\t        updated[\"return_unit\"] = CANONICAL_RETURN_UNIT\n   877\t        return updated\n   878\t\n   879\t    @model_validator(mode=\"before\")\n   880\t    @classmethod\n   881\t    def apply_transform_pipeline(cls, data: Any) -> Any:\n   882\t        \"\"\"Apply transforms in order: parse -> normalize units (incl. shares) -> compile -> validate.\"\"\"\n   883\t        if not isinstance(data, dict):\n   884\t            return data\n   885\t        cls._trace_transform(data, \"parse_raw\")\n   886\t        for _, transform in cls._transform_pipeline():\n   887\t            data = transform(data)\n   888\t        return data\n   889\t\n   890\t    @staticmethod\n   891\t    def _normalize_agents(raw_agents: Any) -> list[dict[str, Any]]:\n   892\t        if raw_agents is None:\n   893\t            return []\n   894\t        if not isinstance(raw_agents, list):\n   895\t            raise ValueError(\"agents must be a list of mappings\")\n   896\t        normalized: list[dict[str, Any]] = []\n   897\t        for idx, agent in enumerate(raw_agents):\n   898\t            if isinstance(agent, AgentConfig):\n   899\t                agent_data = agent.model_dump()\n   900\t            elif isinstance(agent, Mapping):\n   901\t                agent_data = dict(agent)\n   902\t            else:\n   903\t                raise ValueError(f\"agents[{idx}] must be a mapping\")\n   904\t            missing = {\"name\", \"capital\", \"beta_share\", \"alpha_share\"} - agent_data.keys()\n   905\t            if missing:\n   906\t                raise ValueError(f\"agents[{idx}] missing keys: {sorted(missing)}\")\n   907\t            extra = agent_data.get(\"extra\") or {}\n   908\t            if not isinstance(extra, dict):\n   909\t                raise ValueError(f\"agents[{idx}].extra must be a mapping\")\n   910\t            beta_share = normalize_share(agent_data[\"beta_share\"])\n   911\t            alpha_share = normalize_share(agent_data[\"alpha_share\"])\n   912\t            normalized.append(\n   913\t                {\n   914\t                    \"name\": str(agent_data[\"name\"]),\n   915\t                    \"capital\": float(agent_data[\"capital\"]),\n   916\t                    \"beta_share\": 0.0 if beta_share is None else float(beta_share),\n   917\t                    \"alpha_share\": 0.0 if alpha_share is None else float(alpha_share),\n   918\t                    \"extra\": extra,\n   919\t                }\n   920\t            )\n   921\t        return normalized\n   922\t\n   923\t    @model_validator(mode=\"after\")\n   924\t    def check_financing_model(self) -> \"ModelConfig\":\n   925\t        self._trace_transform(self, \"check_financing_model\")\n--- config Unit logic 460-560 ---\n   460\t    external_pa_alpha_min_pct: float = 25.0\n   461\t    external_pa_alpha_max_pct: float = 75.0\n   462\t    external_pa_alpha_step_pct: float = 5.0\n   463\t    active_share_min_pct: float = 20.0\n   464\t    active_share_max_pct: float = 100.0\n   465\t    active_share_step_pct: float = 5.0\n   466\t\n   467\t    sd_multiple_min: float = 2.0\n   468\t    sd_multiple_max: float = 4.0\n   469\t    sd_multiple_step: float = 0.25\n   470\t\n   471\t    # Margin calculation parameters\n   472\t    reference_sigma: float = 0.01  # Monthly volatility for margin calculation\n   473\t    volatility_multiple: float = 3.0  # Multiplier for margin requirement\n   474\t    financing_model: str = \"simple_proxy\"  # or \"schedule\"\n   475\t    financing_schedule_path: Path | None = None\n   476\t    financing_term_months: float = 1.0\n   477\t\n   478\t    # Regime-switching configuration\n   479\t    regimes: List[\"RegimeConfig\"] | None = Field(\n   480\t        default=None,\n   481\t        description=\"List of regime configurations for regime-switching models.\",\n   482\t    )\n   483\t    regime_start: str | None = Field(\n   484\t        default=None,\n   485\t        description=\"Initial regime name for regime-switching simulations.\",\n   486\t    )\n   487\t    regime_transition: List[List[float]] | None = Field(\n   488\t        default=None,\n   489\t        description=\"Markov transition matrix for regime switching (n_regimes x n_regimes).\",\n   490\t    )\n   491\t\n   492\t    risk_metrics: List[str] = Field(\n   493\t        default_factory=lambda: [\n   494\t            \"Return\",\n   495\t            \"Risk\",\n   496\t            \"terminal_ShortfallProb\",\n   497\t        ],\n   498\t        alias=\"risk_metrics\",\n   499\t        description=(\n   500\t            \"Advisory list selecting which metrics are reported/displayed. It \"\n   501\t            \"does not change how the simulation runs (must include \"\n   502\t            \"'terminal_ShortfallProb'). See README 'Model Limitations & Caveats'.\"\n   503\t        ),\n   504\t    )\n   505\t\n   506\t    sleeve_max_te: float | None = Field(\n   507\t        default=None,\n   508\t        description=\"Maximum tracking error constraint for sleeves (monthly).\",\n   509\t    )\n   510\t    sleeve_max_breach: float | None = Field(\n   511\t        default=None,\n   512\t        description=\"Maximum breach probability constraint for sleeves (monthly).\",\n   513\t    )\n   514\t    sleeve_max_cvar: float | None = Field(\n   515\t        default=None,\n   516\t        description=\"Maximum CVaR constraint for sleeves (monthly).\",\n   517\t    )\n   518\t    sleeve_max_shortfall: float | None = Field(\n   519\t        default=None,\n   520\t        description=\"Maximum shortfall probability constraint for sleeves (terminal).\",\n   521\t    )\n   522\t    sleeve_constraint_scope: Literal[\"total\", \"per_sleeve\"] = Field(\n   523\t        default=\"total\",\n   524\t        description=\"Constraint scope for sleeve validation (total or per-sleeve).\",\n   525\t    )\n   526\t    sleeve_validate_on_run: bool = Field(\n   527\t        default=False,\n   528\t        description=\"Validate sleeve constraints during run_single when true.\",\n   529\t    )\n   530\t\n   531\t    debug_transform_order: bool = Field(\n   532\t        default=False,\n   533\t        exclude=True,\n   534\t        description=\"Log transform execution order when true.\",\n   535\t    )\n   536\t\n   537\t    # Transform/validation pipeline (explicit order):\n   538\t    # 1) parse raw input\n   539\t    # 2) normalize units (including share normalization)\n   540\t    # 3) compile derived fields\n   541\t    # 4) validate invariants (after validators below).\n   542\t    @staticmethod\n   543\t    def _trace_transform(data_or_self: Any, step: str) -> None:\n   544\t        if isinstance(data_or_self, dict):\n   545\t            debug = bool(data_or_self.get(\"debug_transform_order\", False))\n   546\t        else:\n   547\t            debug = bool(getattr(data_or_self, \"debug_transform_order\", False))\n   548\t        if debug:\n   549\t            logger.info(\"ModelConfig transform: %s\", step)\n   550\t\n   551\t    @classmethod\n   552\t    def _transform_pipeline(cls) -> tuple[tuple[str, Callable[[Any], Any]], ...]:\n   553\t        \"\"\"Return the ordered pre-validation transform pipeline.\"\"\"\n   554\t        return (\n   555\t            (\"normalize_return_units\", cls.normalize_return_units),\n   556\t            (\"normalize_share_inputs\", cls.normalize_share_inputs),\n   557\t            (\"compile_agent_config\", cls.compile_agent_config),\n   558\t        )\n   559\t\n   560\t    @classmethod\n--- sim financing and metrics relevant --\n     1\tfrom __future__ import annotations\n     2\t\n     3\timport logging\n     4\tfrom typing import Any, Dict, Iterable, Mapping, cast\n     5\t\n     6\timport numpy.typing as npt\n     7\t\n     8\tfrom ..backend import xp as np\n     9\tfrom ..random import spawn_rngs\n    10\tfrom ..types import GeneratorLike\n    11\t\n    12\tlogger = logging.getLogger(__name__)\n    13\t\n    14\t_FINANCING_MODES = (\"broadcast\", \"per_path\")\n    15\t\n    16\t# Financing volatility keys whose non-zero values make ``broadcast`` mode\n    17\t# suppress risk dispersion (see ``broadcast_dispersion_warning``).\n    18\t_FINANCING_SIGMA_KEYS = (\n    19\t    \"internal_financing_sigma_month\",\n    20\t    \"internal_pa_financing_sigma_month\",\n    21\t    \"ext_pa_financing_sigma_month\",\n    22\t    \"act_ext_financing_sigma_month\",\n    23\t)\n    24\t\n    25\t\n    26\tdef broadcast_dispersion_warning(\n    27\t    financing_mode: str,\n    28\t    n_sim: int,\n    29\t    financing_sigmas: Iterable[float],\n    30\t) -> str | None:\n    31\t    \"\"\"Return a user-facing warning when ``broadcast`` financing suppresses risk.\n    32\t\n    33\t    ``broadcast`` reuses a single financing path across every Monte-Carlo\n    34\t    scenario. When more than one scenario is simulated and any financing\n    35\t    volatility is non-zero, that shared path removes financing-cost dispersion\n    36\t    (and any return/financing co-movement), so tail/CVaR estimates are\n    37\t    understated. Returns ``None`` when broadcast is harmless (a single scenario\n    38\t    or all financing volatilities zero) or when ``per_path`` is in effect.\n    39\t    \"\"\"\n    40\t    if financing_mode != \"broadcast\":\n    41\t        return None\n    42\t    if not n_sim or n_sim <= 1:\n    43\t        return None\n    44\t    if not any((sigma or 0.0) > 0 for sigma in financing_sigmas):\n    45\t        return None\n    46\t    return (\n    47\t        \"financing_mode='broadcast' reuses a single financing path across all \"\n    48\t        f\"{n_sim} simulations, so financing-cost dispersion is suppressed and \"\n    49\t        \"tail/CVaR risk is understated. Use financing_mode='per_path' for \"\n    50\t        \"risk/tail analysis.\"\n    51\t    )\n    52\t\n    53\t\n    54\tdef simulate_financing(\n    55\t    T: int,\n    56\t    financing_mean: float,\n    57\t    financing_sigma: float,\n    58\t    spike_prob: float,\n    59\t    spike_factor: float,\n    60\t    *,\n    61\t    seed: int | None = None,\n    62\t    n_scenarios: int = 1,\n    63\t    rng: GeneratorLike | None = None,\n    64\t) -> npt.NDArray[Any]:\n    65\t    \"\"\"Vectorised financing spread simulation with optional spikes.\"\"\"\n    66\t    if T <= 0:\n    67\t        raise ValueError(\"T must be positive\")\n    68\t    if n_scenarios <= 0:\n    69\t        raise ValueError(\"n_scenarios must be positive\")\n    70\t    if rng is None:\n    71\t        rng = spawn_rngs(seed, 1)[0]\n    72\t    base = rng.normal(loc=financing_mean, scale=financing_sigma, size=(n_scenarios, T))\n    73\t    jumps = (rng.random(size=(n_scenarios, T)) < spike_prob) * (spike_factor * financing_sigma)\n    74\t    out = cast(npt.NDArray[Any], np.clip(base + jumps, 0.0, None))\n    75\t    if n_scenarios == 1:\n    76\t        return cast(npt.NDArray[Any], out[0])\n    77\t    return out\n    78\t\n    79\t\n    80\tdef draw_financing_series(\n    81\t    *,\n    82\t    n_months: int,\n    83\t    n_sim: int,\n    84\t    params: Dict[str, Any],\n    85\t    financing_mode: str,\n    86\t    rng: GeneratorLike | None = None,\n    87\t    rngs: Mapping[str, GeneratorLike] | None = None,\n    88\t) -> tuple[npt.NDArray[Any], npt.NDArray[Any], npt.NDArray[Any]]:\n    89\t    \"\"\"Return three matrices of monthly financing spreads.\n    90\t\n    91\t    ``financing_mode`` controls whether a single monthly vector is broadcast\n    92\t    across all scenarios (\"broadcast\") or each path receives its own draw\n    93\t    (\"per_path\").\n    94\t\n    95\t    ``rngs`` may provide dedicated generators for each sleeve under the keys\n    96\t    ``\"internal\"``, ``\"external_pa\"``, and ``\"active_ext\"``. If not supplied,\n    97\t    ``rng`` will be used for all sleeves.\n    98\t    \"\"\"\n    99\t    if financing_mode not in _FINANCING_MODES:\n   100\t        raise ValueError(f\"financing_mode must be one of: {sorted(_FINANCING_MODES)}\")\n   101\t    if n_months <= 0:\n   102\t        raise ValueError(\"n_months must be positive\")\n   103\t    if n_sim <= 0:\n   104\t        raise ValueError(\"n_sim must be positive\")\n   105\t    warning = broadcast_dispersion_warning(\n   106\t        financing_mode,\n   107\t        n_sim,\n   108\t        (params.get(key, 0.0) for key in _FINANCING_SIGMA_KEYS),\n   109\t    )\n   110\t    if warning is not None:\n   111\t        logger.warning(warning)\n   112\t\n   113\t    if rngs is not None:\n   114\t        tmp_int = rngs.get(\"internal\")\n   115\t        r_int = tmp_int if tmp_int is not None else spawn_rngs(None, 1)[0]\n   116\t\n   117\t        tmp_ext = rngs.get(\"external_pa\")\n   118\t        r_ext = tmp_ext if tmp_ext is not None else spawn_rngs(None, 1)[0]\n   119\t\n   120\t        tmp_act = rngs.get(\"active_ext\")\n   121\t        r_act = tmp_act if tmp_act is not None else spawn_rngs(None, 1)[0]\n   122\t    else:\n   123\t        if rng is None:\n   124\t            rng = spawn_rngs(None, 1)[0]\n   125\t        r_int = rng\n   126\t        r_ext = rng\n   127\t        r_act = rng\n   128\t\n   129\t    def _sim(\n   130\t        mean_key: str,\n   131\t        sigma_key: str,\n   132\t        p_key: str,\n   133\t        k_key: str,\n   134\t        rng_local: GeneratorLike,\n   135\t    ) -> npt.NDArray[Any]:\n   136\t        mean = params[mean_key]\n   137\t        sigma = params[sigma_key]\n   138\t        p = params[p_key]\n   139\t        k = params[k_key]\n   140\t        draw = simulate_financing(\n   141\t            n_months,\n   142\t            mean,\n   143\t            sigma,\n   144\t            p,\n   145\t            k,\n   146\t            n_scenarios=1 if financing_mode == \"broadcast\" else n_sim,\n   147\t            rng=rng_local,\n   148\t        )\n   149\t        if draw.ndim == 1:\n   150\t            return cast(npt.NDArray[Any], np.broadcast_to(draw, (n_sim, n_months)))\n   151\t        return draw\n   152\t\n   153\t    f_int_mat = _sim(\n   154\t        \"internal_financing_mean_month\",\n   155\t        \"internal_financing_sigma_month\",\n   156\t        \"internal_spike_prob\",\n   157\t        \"internal_spike_factor\",\n   158\t        r_int,\n   159\t    )\n   160\t    f_ext_pa_mat = _sim(\n   161\t        \"ext_pa_financing_mean_month\",\n   162\t        \"ext_pa_financing_sigma_month\",\n   163\t        \"ext_pa_spike_prob\",\n   164\t        \"ext_pa_spike_factor\",\n   165\t        r_ext,\n   166\t    )\n   167\t    f_act_ext_mat = _sim(\n   168\t        \"act_ext_financing_mean_month\",\n   169\t        \"a