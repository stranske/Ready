{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc 'repo=/Users/teacher/.codex/automations/research-program/clones/Portable-Alpha-Extension-Model\ncd \"$repo\"\nprintf '\"'%s\\\\n' '--- fees ---'\nnl -ba pa_core/fees.py\nprintf '%s\\\\n' '--- agents fee integration ---'\nrg -n -C 6 'fee_schedule|apply_fees|compute_fee' pa_core/agents pa_core/simulations.py pa_core/facade.py pa_core/sweep.py\nprintf '%s\\\\n' '--- fees tests ---'\nnl -ba tests/test_fee_layer.py\nprintf '%s\\\\n' '--- config fee lines ---'\nrg -n -C 5 'fee_schedule|FeeSchedule|total_fund_capital|active_share|w_beta|w_alpha|theta_extpa|financing_mode' pa_core/config.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc 'repo=/Users/teacher/.codex/automations/research-program/clones/Portable-Alpha-Extension-Model\ncd \"$repo\"\nprintf '\"'%s\\\\n' '--- fees ---'\nnl -ba pa_core/fees.py\nprintf '%s\\\\n' '--- agents fee integration ---'\nrg -n -C 6 'fee_schedule|apply_fees|compute_fee' pa_core/agents pa_core/simulations.py pa_core/facade.py pa_core/sweep.py\nprintf '%s\\\\n' '--- fees tests ---'\nnl -ba tests/test_fee_layer.py\nprintf '%s\\\\n' '--- config fee lines ---'\nrg -n -C 5 'fee_schedule|FeeSchedule|total_fund_capital|active_share|w_beta|w_alpha|theta_extpa|financing_mode' pa_core/config.py\"","aggregated_output":"--- fees ---\n     1\t\"\"\"Per-sleeve management & performance fee layer (issue #1904).\n     2\t\n     3\tThe core engine models financing/margin cost but historically produced only\n     4\t*gross*-of-fee returns. For portable-alpha structures, external-manager\n     5\tmanagement fees and performance fees (on returns above a hurdle) are\n     6\tfirst-order and frequently decide whether the structure beats plain beta.\n     7\tWithout them every output overstates the structure.\n     8\t\n     9\tThis module adds an opt-in, per-sleeve fee schedule so callers can produce\n    10\tnet-of-fee outputs alongside the existing gross behaviour. When no schedule is\n    11\tsupplied (the default) returns are unchanged and fully backward compatible.\n    12\t\n    13\tModelling choices (intentionally a simple first increment; see the PR for\n    14\trationale and follow-ups):\n    15\t\n    16\t* Fees are deducted in **sleeve contribution-return space**. The fee basis is\n    17\t  the sleeve's underlying return, then the resulting fee is scaled back by the\n    18\t  sleeve's fund-level notional share so a 25% sleeve pays 25% of a full-fund\n    19\t  drag.\n    20\t* **Management fee** (``mgmt_fee_bps``) is an annual rate in basis points,\n    21\t  accrued linearly as a constant monthly drag ``mgmt_fee_bps / 1e4 / 12``.\n    22\t* **Performance fee** (``perf_fee_pct``) is a fraction of the monthly return\n    23\t  above an annual ``hurdle_bps`` hurdle (e.g. ``0.20`` for a 20% fee). It is\n    24\t  crystallised monthly with no high-water mark and no rebate below the hurdle\n    25\t  (negative excess is zero-clipped). A high-water-mark / notional-exact variant\n    26\t  is a documented follow-up.\n    27\t\n    28\tAll fee parameters are non-negative; an all-zero schedule is a no-op.\n    29\t\"\"\"\n    30\t\n    31\tfrom __future__ import annotations\n    32\t\n    33\tfrom typing import Any, cast\n    34\t\n    35\tfrom pydantic import BaseModel, ConfigDict, Field\n    36\t\n    37\tfrom .backend import xp as np\n    38\tfrom .types import ArrayLike\n    39\t\n    40\t__all__ = [\"FeeSchedule\", \"compute_fee_drag\", \"apply_fees\"]\n    41\t\n    42\t_BPS_PER_UNIT = 10_000.0\n    43\t_MONTHS_PER_YEAR = 12.0\n    44\t\n    45\t\n    46\tclass FeeSchedule(BaseModel):\n    47\t    \"\"\"Management + performance fee schedule for a single sleeve.\"\"\"\n    48\t\n    49\t    model_config = ConfigDict(frozen=True)\n    50\t\n    51\t    mgmt_fee_bps: float = Field(\n    52\t        default=0.0,\n    53\t        ge=0.0,\n    54\t        description=\"Annual management fee in basis points on notional.\",\n    55\t    )\n    56\t    perf_fee_pct: float = Field(\n    57\t        default=0.0,\n    58\t        ge=0.0,\n    59\t        le=1.0,\n    60\t        description=\"Performance fee as a fraction of return above the hurdle (e.g. 0.20).\",\n    61\t    )\n    62\t    hurdle_bps: float = Field(\n    63\t        default=0.0,\n    64\t        ge=0.0,\n    65\t        description=\"Annual performance-fee hurdle in basis points.\",\n    66\t    )\n    67\t\n    68\t    @property\n    69\t    def is_zero(self) -> bool:\n    70\t        \"\"\"True when the schedule charges nothing (a no-op).\"\"\"\n    71\t        return self.mgmt_fee_bps == 0.0 and self.perf_fee_pct == 0.0\n    72\t\n    73\t\n    74\tdef compute_fee_drag(\n    75\t    gross: ArrayLike,\n    76\t    schedule: FeeSchedule,\n    77\t    *,\n    78\t    notional_share: float = 1.0,\n    79\t) -> ArrayLike:\n    80\t    \"\"\"Return the per-month fee drag matrix for ``gross`` contribution returns.\n    81\t\n    82\t    The result has the same shape as ``gross`` and is always non-negative\n    83\t    (fees never increase returns). ``net = gross - compute_fee_drag(gross, ...)``.\n    84\t    \"\"\"\n    85\t    if notional_share < 0.0:\n    86\t        raise ValueError(\"notional_share must be non-negative\")\n    87\t    if notional_share == 0.0:\n    88\t        return cast(ArrayLike, np.zeros_like(gross))\n    89\t\n    90\t    gross_array = cast(Any, gross)\n    91\t    underlying_gross = gross_array / notional_share\n    92\t    mgmt_monthly = schedule.mgmt_fee_bps / _BPS_PER_UNIT / _MONTHS_PER_YEAR\n    93\t    drag = cast(ArrayLike, np.full_like(gross, mgmt_monthly))\n    94\t    if schedule.perf_fee_pct > 0.0:\n    95\t        hurdle_monthly = schedule.hurdle_bps / _BPS_PER_UNIT / _MONTHS_PER_YEAR\n    96\t        excess = np.maximum(underlying_gross - hurdle_monthly, 0.0)\n    97\t        drag = drag + schedule.perf_fee_pct * excess\n    98\t    return cast(ArrayLike, drag * notional_share)\n    99\t\n   100\t\n   101\tdef apply_fees(\n   102\t    gross: ArrayLike,\n   103\t    schedule: FeeSchedule,\n   104\t    *,\n   105\t    notional_share: float = 1.0,\n   106\t) -> ArrayLike:\n   107\t    \"\"\"Return ``gross`` net of the management + performance fees in ``schedule``.\"\"\"\n   108\t    if schedule.is_zero:\n   109\t        return gross\n   110\t    return gross - compute_fee_drag(gross, schedule, notional_share=notional_share)\n--- agents fee integration ---\npa_core/facade.py-477-        r_E,\npa_core/facade.py-478-        r_M,\npa_core/facade.py-479-        f_int,\npa_core/facade.py-480-        f_ext,\npa_core/facade.py-481-        f_act,\npa_core/facade.py-482-        f_internal_pa,\npa_core/facade.py:483:        fee_schedule=run_cfg.fee_schedule,\npa_core/facade.py-484-    )\npa_core/facade.py-485-    summary = summary_table(returns, benchmark=\"Base\")\npa_core/facade.py-486-    if getattr(run_cfg, \"sleeve_validate_on_run\", False):\npa_core/facade.py-487-        from .reporting.constraints import validate_sleeve_constraints\npa_core/facade.py-488-\npa_core/facade.py-489-        violations = validate_sleeve_constraints(summary, run_cfg)\n--\npa_core/simulations.py-11-    BaseAgent,\npa_core/simulations.py-12-    ExternalPAAgent,\npa_core/simulations.py-13-    InternalBetaAgent,\npa_core/simulations.py-14-    InternalPAAgent,\npa_core/simulations.py-15-)\npa_core/simulations.py-16-from .backend import xp as np\npa_core/simulations.py:17:from .fees import FeeSchedule, apply_fees\npa_core/simulations.py-18-from .portfolio import compute_total_contribution_returns\npa_core/simulations.py-19-from .sim import (\npa_core/simulations.py-20-    draw_financing_series,\npa_core/simulations.py-21-    draw_joint_returns,\npa_core/simulations.py-22-    prepare_mc_universe,\npa_core/simulations.py-23-    simulate_alpha_streams,\n--\npa_core/simulations.py-90-    r_E: ArrayLike,\npa_core/simulations.py-91-    r_M: ArrayLike,\npa_core/simulations.py-92-    f_int: ArrayLike,\npa_core/simulations.py-93-    f_ext_pa: ArrayLike,\npa_core/simulations.py-94-    f_act_ext: ArrayLike,\npa_core/simulations.py-95-    f_internal_pa: ArrayLike | None = None,\npa_core/simulations.py:96:    fee_schedule: Mapping[str, FeeSchedule] | None = None,\npa_core/simulations.py-97-) -> dict[str, ArrayLike]:\npa_core/simulations.py-98-    \"\"\"Return per-agent monthly returns using vectorised operations.\npa_core/simulations.py-99-\npa_core/simulations.py-100-    ``f_internal_pa`` is the optional internal-PA financing cost series\npa_core/simulations.py-101-    (issue #1849). When ``None`` it defaults to an all-zeros matrix shaped like\npa_core/simulations.py-102-    ``r_beta``, so callers that do not supply it get the historical behaviour\npa_core/simulations.py-103-    (InternalPA = pure in-house alpha).\npa_core/simulations.py-104-\npa_core/simulations.py:105:    ``fee_schedule`` is an optional per-sleeve management/performance fee\npa_core/simulations.py-106-    schedule keyed by agent name (issue #1904). When provided, the matching\npa_core/simulations.py-107-    sleeve's contribution return is reported net of fees and ``Total`` is the\npa_core/simulations.py-108-    sum of the net sleeves. When ``None`` (the default) returns are gross and\npa_core/simulations.py-109-    fully backward compatible.\npa_core/simulations.py-110-    \"\"\"\npa_core/simulations.py-111-    results: dict[str, ArrayLike] = {}\npa_core/simulations.py-112-    if f_internal_pa is None:\npa_core/simulations.py-113-        f_internal_pa = np.zeros_like(r_beta)\npa_core/simulations.py-114-    streams = (r_beta, r_H, r_E, r_M, f_int, f_ext_pa, f_act_ext, f_internal_pa)\npa_core/simulations.py-115-    for agent in agents:\npa_core/simulations.py-116-        alpha, financing = _resolve_streams(agent, *streams)\npa_core/simulations.py-117-        gross = agent.monthly_returns(r_beta, alpha, financing)\npa_core/simulations.py:118:        if fee_schedule is not None:\npa_core/simulations.py:119:            schedule = fee_schedule.get(agent.p.name)\npa_core/simulations.py-120-            if schedule is not None:\npa_core/simulations.py-121-                notional_share = agent.p.beta_share + agent.p.alpha_share\npa_core/simulations.py:122:                gross = apply_fees(gross, schedule, notional_share=notional_share)\npa_core/simulations.py-123-        results[agent.p.name] = gross\npa_core/simulations.py-124-\npa_core/simulations.py-125-    total = compute_total_returns(results)\npa_core/simulations.py-126-    if total is not None:\npa_core/simulations.py-127-        results[\"Total\"] = total\npa_core/simulations.py-128-    return results\n--- fees tests ---\n     1\t\"\"\"Tests for the per-sleeve management/performance fee layer (issue #1904).\n     2\t\n     3\tCovers the ``FeeSchedule`` model and validation, the ``compute_fee_drag`` /\n     4\t``apply_fees`` helpers, routing through ``simulate_agents``, an end-to-end\n     5\t``run_single`` sensitivity check, and config plumbing (default + round-trip).\n     6\t\"\"\"\n     7\t\n     8\tfrom __future__ import annotations\n     9\t\n    10\timport numpy as np\n    11\timport pandas as pd\n    12\timport pytest\n    13\tfrom pydantic import ValidationError\n    14\t\n    15\tfrom pa_core.agents.internal_pa import InternalPAAgent\n    16\tfrom pa_core.agents.types import AgentParams\n    17\tfrom pa_core.config import AgentConfig, load_config\n    18\tfrom pa_core.facade import RunOptions, run_single\n    19\tfrom pa_core.fees import FeeSchedule, apply_fees, compute_fee_drag\n    20\tfrom pa_core.simulations import simulate_agents\n    21\t\n    22\t# ---------------------------------------------------------------------------\n    23\t# FeeSchedule model\n    24\t# ---------------------------------------------------------------------------\n    25\t\n    26\t\n    27\tdef test_default_schedule_is_zero() -> None:\n    28\t    sched = FeeSchedule()\n    29\t    assert sched.mgmt_fee_bps == 0.0\n    30\t    assert sched.perf_fee_pct == 0.0\n    31\t    assert sched.hurdle_bps == 0.0\n    32\t    assert sched.is_zero\n    33\t\n    34\t\n    35\tdef test_schedule_with_fee_is_not_zero() -> None:\n    36\t    assert not FeeSchedule(mgmt_fee_bps=50.0).is_zero\n    37\t    assert not FeeSchedule(perf_fee_pct=0.2).is_zero\n    38\t\n    39\t\n    40\tdef test_negative_or_out_of_range_fee_rejected() -> None:\n    41\t    with pytest.raises(ValidationError):\n    42\t        FeeSchedule(mgmt_fee_bps=-1.0)\n    43\t    with pytest.raises(ValidationError):\n    44\t        FeeSchedule(perf_fee_pct=-0.1)\n    45\t    with pytest.raises(ValidationError):\n    46\t        FeeSchedule(perf_fee_pct=1.5)\n    47\t    with pytest.raises(ValidationError):\n    48\t        FeeSchedule(hurdle_bps=-5.0)\n    49\t\n    50\t\n    51\tdef test_schedule_coerces_from_dict() -> None:\n    52\t    sched = FeeSchedule.model_validate(\n    53\t        {\"mgmt_fee_bps\": 50.0, \"perf_fee_pct\": 0.2, \"hurdle_bps\": 200.0}\n    54\t    )\n    55\t    assert sched.mgmt_fee_bps == 50.0\n    56\t    assert sched.perf_fee_pct == 0.2\n    57\t    assert sched.hurdle_bps == 200.0\n    58\t\n    59\t\n    60\t# ---------------------------------------------------------------------------\n    61\t# compute_fee_drag / apply_fees\n    62\t# ---------------------------------------------------------------------------\n    63\t\n    64\t\n    65\tdef test_mgmt_fee_constant_monthly_drag() -> None:\n    66\t    gross = np.full((2, 3), 0.01)\n    67\t    # 120 bps annual -> 0.012 annual -> 0.001 monthly flat drag\n    68\t    sched = FeeSchedule(mgmt_fee_bps=120.0)\n    69\t    drag = compute_fee_drag(gross, sched)\n    70\t    assert np.allclose(drag, 0.001)\n    71\t    assert np.allclose(apply_fees(gross, sched), 0.009)\n    72\t\n    73\t\n    74\tdef test_fee_drag_scales_by_notional_share() -> None:\n    75\t    gross = np.full((1, 2), 0.005)\n    76\t    sched = FeeSchedule(mgmt_fee_bps=120.0, perf_fee_pct=0.5, hurdle_bps=0.0)\n    77\t\n    78\t    drag = compute_fee_drag(gross, sched, notional_share=0.25)\n    79\t\n    80\t    # Underlying sleeve return is 2%; fee drag is 25% of the full-sleeve fee:\n    81\t    # (0.001 management + 0.5 * 0.02 performance) * 0.25 = 0.00275.\n    82\t    assert np.allclose(drag, 0.00275)\n    83\t    assert np.allclose(apply_fees(gross, sched, notional_share=0.25), 0.00225)\n    84\t\n    85\t\n    86\tdef test_perf_fee_charged_above_hurdle_only() -> None:\n    87\t    gross = np.array([[0.02, -0.01, 0.0]])\n    88\t    sched = FeeSchedule(perf_fee_pct=0.5, hurdle_bps=0.0)  # 50% of positive return\n    89\t    drag = compute_fee_drag(gross, sched)\n    90\t    # No rebate / fee on returns at or below the (zero) hurdle.\n    91\t    assert np.allclose(drag, [[0.01, 0.0, 0.0]])\n    92\t\n    93\t\n    94\tdef test_perf_fee_respects_hurdle() -> None:\n    95\t    gross = np.full((1, 1), 0.01)\n    96\t    # hurdle 120 bps annual -> 0.001 monthly; 100% perf on the excess above it.\n    97\t    sched = FeeSchedule(perf_fee_pct=1.0, hurdle_bps=120.0)\n    98\t    drag = compute_fee_drag(gross, sched)\n    99\t    assert np.allclose(drag, 0.01 - 0.001)\n   100\t\n   101\t\n   102\tdef test_zero_schedule_is_noop() -> None:\n   103\t    gross = np.full((2, 2), 0.03)\n   104\t    # is_zero short-circuits and returns the same object untouched.\n   105\t    assert apply_fees(gross, FeeSchedule()) is gross\n   106\t\n   107\t\n   108\t# ---------------------------------------------------------------------------\n   109\t# simulate_agents routing\n   110\t# ---------------------------------------------------------------------------\n   111\t\n   112\t\n   113\tdef test_simulate_agents_applies_fee_to_named_sleeve_only() -> None:\n   114\t    n_sim, n_months = 3, 4\n   115\t    rng = np.random.default_rng(2)\n   116\t    r_beta = rng.normal(size=(n_sim, n_months))\n   117\t    r_H = np.full((n_sim, n_months), 0.02)\n   118\t    f = np.zeros((n_sim, n_months))\n   119\t    agents = [InternalPAAgent(AgentParams(\"InternalPA\", 100.0, 0.0, 1.0, {}))]\n   120\t\n   121\t    gross = simulate_agents(agents, r_beta, r_H, r_H, r_H, f, f, f)\n   122\t    net = simulate_agents(\n   123\t        agents,\n   124\t        r_beta,\n   125\t        r_H,\n   126\t        r_H,\n   127\t        r_H,\n   128\t        f,\n   129\t        f,\n   130\t        f,\n   131\t        fee_schedule={\"InternalPA\": FeeSchedule(mgmt_fee_bps=120.0)},\n   132\t    )\n   133\t    assert np.allclose(gross[\"InternalPA\"], 0.02)\n   134\t    assert np.allclose(net[\"InternalPA\"], 0.019)  # exactly the 0.001 mgmt drag\n   135\t\n   136\t    # A schedule for a sleeve that is not present is a no-op.\n   137\t    untouched = simulate_agents(\n   138\t        agents,\n   139\t        r_beta,\n   140\t        r_H,\n   141\t        r_H,\n   142\t        r_H,\n   143\t        f,\n   144\t        f,\n   145\t        f,\n   146\t        fee_schedule={\"ExternalPA\": FeeSchedule(mgmt_fee_bps=999.0)},\n   147\t    )\n   148\t    assert np.allclose(untouched[\"InternalPA\"], 0.02)\n   149\t\n   150\t\n   151\tdef test_simulate_agents_scales_fees_by_sleeve_notional_share() -> None:\n   152\t    n_sim, n_months = 2, 3\n   153\t    r_beta = np.zeros((n_sim, n_months))\n   154\t    r_H = np.full((n_sim, n_months), 0.02)\n   155\t    f = np.zeros((n_sim, n_months))\n   156\t    agents = [InternalPAAgent(AgentParams(\"InternalPA\", 25.0, 0.0, 0.25, {}))]\n   157\t\n   158\t    gross = simulate_agents(agents, r_beta, r_H, r_H, r_H, f, f, f)\n   159\t    net = simulate_agents(\n   160\t        agents,\n   161\t        r_beta,\n   162\t        r_H,\n   163\t        r_H,\n   164\t        r_H,\n   165\t        f,\n   166\t        f,\n   167\t        f,\n   168\t        fee_schedule={\"InternalPA\": FeeSchedule(mgmt_fee_bps=120.0)},\n   169\t    )\n   170\t\n   171\t    assert np.allclose(gross[\"InternalPA\"], 0.005)\n   172\t    assert np.allclose(gross[\"InternalPA\"] - net[\"InternalPA\"], 0.00025)\n   173\t\n   174\t\n   175\tdef test_simulate_agents_default_is_backward_compatible() -> None:\n   176\t    n_sim, n_months = 2, 3\n   177\t    r_beta = np.zeros((n_sim, n_months))\n   178\t    r_H = np.full((n_sim, n_months), 0.02)\n   179\t    f = np.zeros((n_sim, n_months))\n   180\t    agents = [InternalPAAgent(AgentParams(\"InternalPA\", 100.0, 0.0, 1.0, {}))]\n   181\t    # No fee_schedule arg -> identical to gross.\n   182\t    assert np.allclose(simulate_agents(agents, r_beta, r_H, r_H, r_H, f, f, f)[\"InternalPA\"], 0.02)\n   183\t\n   184\t\n   185\t# ---------------------------------------------------------------------------\n   186\t# End-to-end via run_single (acceptance criteria) + config plumbing\n   187\t# ---------------------------------------------------------------------------\n   188\t\n   189\t\n   190\tdef _scenario():\n   191\t    return load_config(\"examples/scenarios/my_first_scenario.yml\").model_copy(\n   192\t        update={\n   193\t            \"N_SIMULATIONS\": 200,\n   194\t            \"N_MONTHS\": 6,\n   195\t            \"agents\": [\n   196\t                AgentConfig(\n   197\t                    name=\"InternalPA\",\n   198\t                    capital=150.0,\n   199\t                    beta_share=0.0,\n   200\t                    alpha_share=0.15,\n   201\t                )\n   202\t            ],\n   203\t        }\n   204\t    )\n   205\t\n   206\t\n   207\tdef _internal_pa_mean(cfg) -> float:\n   208\t    idx = pd.Series([0.01, -0.02, 0.015, 0.0, 0.005, -0.01])\n   209\t    artifacts = run_single(cfg, idx, RunOptions(seed=7))\n   210\t    return float(artifacts.raw_returns[\"InternalPA\"].to_numpy().mean())\n   211\t\n   212\t\n   213\tdef test_default_config_has_no_fee_schedule() -> None:\n   214\t    assert _scenario().fee_schedule is None\n   215\t\n   216\t\n   217\tdef test_run_single_mgmt_fee_lowers_return_by_exact_drag() -> None:\n   218\t    base = _scenario()\n   219\t    gross = _internal_pa_mean(base)\n   220\t    net = _internal_pa_mean(\n   221\t        base.model_copy(update={\"fee_schedule\": {\"InternalPA\": FeeSchedule(mgmt_fee_bps=120.0)}})\n   222\t    )\n   223\t    # 120 bps annual on a 150mm sleeve in a 1000mm fund:\n   224\t    # 0.012 / 12 * 0.15 = 0.00015 contribution-return drag.\n   225\t    assert gross - net == pytest.approx(0.00015, abs=1e-9)\n   226\t\n   227\t\n   228\tdef test_run_single_perf_fee_lowers_return() -> None:\n   229\t    base = _scenario()\n   230\t    gross = _internal_pa_mean(base)\n   231\t    net = _internal_pa_mean(\n   232\t        base.model_copy(\n   233\t            update={\"fee_schedule\": {\"InternalPA\": FeeSchedule(perf_fee_pct=0.5, hurdle_bps=0.0)}}\n   234\t        )\n   235\t    )\n   236\t    assert net < gross\n   237\t\n   238\t\n   239\tdef test_fee_schedule_survives_model_dump() -> None:\n   240\t    cfg = _scenario().model_copy(\n   241\t        update={\"fee_schedule\": {\"InternalPA\": FeeSchedule(mgmt_fee_bps=50.0)}}\n   242\t    )\n   243\t    dumped = cfg.model_dump()\n   244\t    assert dumped[\"fee_schedule\"][\"InternalPA\"][\"mgmt_fee_bps\"] == 50.0\n--- config fee lines ---\n27-    field_validator,\n28-    model_validator,\n29-)\n30-\n31-from .backend import BACKEND_UNAVAILABLE_DETAIL, SUPPORTED_BACKENDS\n32:from .fees import FeeSchedule\n33-from .share_utils import SHARE_MAX, SHARE_MIN, SHARE_SUM_TOLERANCE, normalize_share\n34-\n35-\n36-class ConfigError(ValueError):\n37-    \"\"\"Invalid configuration.\"\"\"\n--\n284-    return_distribution_M: str | None = Field(default=None, alias=\"External PA return distribution\")\n285-\n286-    external_pa_capital: float = Field(default=0.0, alias=\"External PA capital (mm)\")\n287-    active_ext_capital: float = Field(default=0.0, alias=\"Active Extension capital (mm)\")\n288-    internal_pa_capital: float = Field(default=0.0, alias=\"Internal PA capital (mm)\")\n289:    total_fund_capital: float = Field(default=1000.0, gt=0, alias=\"Total fund capital (mm)\")\n290-    agents: List[AgentConfig] = Field(default_factory=list)\n291:    fee_schedule: Dict[str, FeeSchedule] | None = Field(\n292-        default=None,\n293-        description=(\n294-            \"Optional per-sleeve management/performance fee schedule keyed by \"\n295-            \"agent name (e.g. 'ExternalPA', 'ActiveExt'). When set, that sleeve's \"\n296-            \"returns are reported net of fees (issue #1904). None or empty keeps \"\n297-            \"the historical gross-of-fee behaviour.\"\n298-        ),\n299-    )\n300-\n301:    w_beta_H: float = Field(default=0.5, alias=\"In-House beta share\")\n302:    w_alpha_H: float = Field(default=0.5, alias=\"In-House alpha share\")\n303:    theta_extpa: float = Field(default=0.5, alias=\"External PA alpha fraction\")\n304:    active_share: float = Field(\n305-        default=0.5,\n306-        alias=\"Active share (%)\",\n307-        validation_alias=AliasChoices(\"Active share (%)\", \"Active share\"),\n308-        description=\"Active share fraction (0..1)\",\n309-    )\n--\n313-    # linearly with the lever (legacy behaviour, the default). With decay > 0 the\n314-    # transfer coefficient TC(s) = 1 / (1 + decay * s) makes expected alpha concave\n315-    # in the lever (information ratio declines as the active bet grows), matching the\n316-    # Grinold-Kahn / Clarke-de Silva-Thorley fundamental-law result. The optional\n317-    # per-share extension cost (monthly, as a fraction) produces an interior optimum.\n318:    active_share_tc_decay: float = Field(\n319-        default=0.0,\n320-        ge=0.0,\n321-        alias=\"Active-share alpha decay (kappa)\",\n322-        description=(\n323-            \"Transfer-coefficient decay for ActiveExt: TC(s)=1/(1+kappa*s). \"\n--\n332-    )\n333-    active_ext_cost_per_share: float = Field(\n334-        default=0.0,\n335-        ge=0.0,\n336-        alias=\"Active Ext extension cost (monthly %/share)\",\n337:        description=\"Monthly extension cost charged per unit of active_share on the ActiveExt sleeve.\",\n338-    )\n339-    ext_pa_cost_per_share: float = Field(\n340-        default=0.0,\n341-        ge=0.0,\n342-        alias=\"External PA extension cost (monthly %/share)\",\n--\n422-    )\n423-    act_ext_spike_prob: float = Field(\n424-        default=0.0, ge=0, le=1, alias=\"Active Ext monthly spike prob\"\n425-    )\n426-    act_ext_spike_factor: float = Field(default=0.0, alias=\"Active Ext spike multiplier\")\n427:    financing_mode: Literal[\"per_path\", \"broadcast\"] = Field(\n428-        ...,\n429-        description=(\n