ric\")\ntests/test_mean_conversion_config.py:54:    # 12 compounded monthly means recover the annual mean (the bug the simple\ntests/test_mean_conversion_config.py:57:    assert np.isclose(compounded, annual)\ntests/test_mean_conversion_config.py:59:    simple_compounded = (1.0 + annual / MONTHS_PER_YEAR) ** MONTHS_PER_YEAR - 1.0\ntests/test_mean_conversion_config.py:60:    assert not np.isclose(simple_compounded, annual)\ntests/test_mean_conversion_config.py:65:    assert np.isclose(cfg.mu_H, annual_mean_to_monthly(0.12, method=\"geometric\"))\ntests/test_mean_conversion_config.py:66:    assert np.isclose(cfg.mu_E, annual_mean_to_monthly(0.06, method=\"geometric\"))\ntests/test_mean_conversion_config.py:67:    assert np.isclose(cfg.mu_M, annual_mean_to_monthly(0.03, method=\"geometric\"))\ntests/test_mean_conversion_config.py:80:    assert np.isclose(cfg.mu_H, annual_mean_to_monthly(0.12, method=\"geometric\"))\ntests/test_mean_conversion_config.py:83:def test_monthly_inputs_ignore_mean_conversion() -> None:\ntests/test_mean_conversion_config.py:84:    cfg = _cfg(return_unit=\"monthly\", mu_H=0.01, mean_conversion=\"geometric\")\ntests/test_mean_conversion_config.py:85:    # No annual->monthly conversion happens for monthly inputs.\ntests/test_mean_conversion_config.py:98:    # return_unit is already \"monthly\" after the first conversion, so the mean\ntests/test_facade_run_single.py:14:    artifacts = run_single(cfg, idx, RunOptions(seed=123))\ntests/test_facade_run_single.py:21:    assert artifacts.manifest[\"seed\"] == 123\ntests/test_facade_run_single.py:35:    artifacts = run_single(cfg, idx, RunOptions(seed=123, config_overrides={\"N_SIMULATIONS\": 1}))\ntests/test_facade_run_single.py:40:def test_run_single_uses_regime_paths(monkeypatch) -> None:\ntests/test_facade_run_single.py:45:            \"regimes\": [\ntests/test_facade_run_single.py:61:            \"regime_transition\": [[0.9, 0.1], [0.2, 0.8]],\ntests/test_facade_run_single.py:62:            \"regim